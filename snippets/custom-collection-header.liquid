<style>
.custom-coll-wrap {
  max-width: var(--global-container-width);
  margin: 0 auto;
  padding: 0 64px;
}
.custom-coll-inner {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  min-height: 56px;
  border-bottom: 1px solid rgba(44,61,51,0.15);
  gap: 16px;
}
.custom-coll-meta {
  display: flex;
  align-items: center;
  gap: 24px;
  flex-wrap: wrap;
}
.custom-coll-count {
  font-style: italic;
  color: #2c3d33;
  font-size: 18px;
  font-weight: 600;
}
.custom-sort-inline {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #2c3d33;
  font-size: 18px;
  white-space: nowrap;
}
.custom-sort-inline__label {
  color: rgba(44, 61, 51, 0.65);
  font-weight: 400;
}
.custom-sort-select-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
  border-bottom: 1px solid rgba(44, 61, 51, 0.85);
}
.custom-sort-inline select {
  min-width: 160px;
  min-height: 0;
  height: auto;
  padding: 2px 28px 4px 0;
  border: 0;
  background: transparent;
  color: #2c3d33;
  font-family: inherit;
  font-size: 18px;
  font-weight: 400;
  line-height: 1.3;
  cursor: pointer;
  outline: none;
  appearance: none;
  -webkit-appearance: none;
}
.custom-sort-select-wrap::after {
  content: "";
  position: absolute;
  top: 50%;
  right: 4px;
  width: 7px;
  height: 7px;
  border-right: 1.5px solid #2c3d33;
  border-bottom: 1.5px solid #2c3d33;
  pointer-events: none;
  transform: translateY(-70%) rotate(45deg);
}
.custom-coll-turkey-row {
  display: flex;
  justify-content: flex-end;
  width: 100%;
  margin-top: 22px;
  position: relative;
  z-index: 2;
}
.custom-coll-turkey-link {
  display: inline-flex;
  align-items: baseline;
  gap: 6px;
  border: 0;
  background: transparent;
  box-shadow: none;
  color: #2c3d33;
  font-family: 'Oswald', sans-serif;
  font-size: 18px;
  font-style: italic;
  font-weight: 600;
  line-height: 1;
  text-decoration: none;
  text-transform: uppercase;
  white-space: nowrap;
}
.custom-coll-turkey-link:hover {
  opacity: 0.72;
}
.custom-coll-turkey-link__arrow {
  font-size: 1.05em;
  line-height: 1;
}
@media (min-width: 768px) {
  .custom-coll-inner {
    border-bottom: 0;
  }
  .custom-coll-meta {
    width: 100%;
    justify-content: space-between;
  }
}
@media (min-width: 1200px) {
  .custom-coll-inner {
    position: relative;
    z-index: 3;
    transform: translateY(64px);
  }
  body:has(.collection.collection--with-sidebar:not(.filters-hidden)) .custom-sort-inline {
    margin-left: 316px;
  }
  .custom-coll-turkey-row {
    transform: translateY(64px);
  }
}
@media (min-width: 1501px) {
  body:has(.collection.collection--with-sidebar:not(.filters-hidden)) .custom-sort-inline {
    margin-left: 340px;
  }
}
@media (max-width: 989px) {
  .custom-coll-wrap {
    padding: 0 20px;
  }
  .custom-sort-inline,
  .custom-sort-inline select {
    font-size: 16px;
  }
  .custom-sort-inline select {
    min-width: 145px;
  }
}
@media (min-width: 768px) and (max-width: 1199px) {
  .custom-coll-wrap {
    padding-left: 16px;
    padding-right: 16px;
  }
}
@media (max-width: 767px) {
  .custom-coll-wrap {
    padding: 0 16px;
  }
  .custom-coll-inner {
    display: none;
  }
  .custom-coll-meta {
    width: 100%;
    justify-content: flex-end;
    gap: 12px;
  }
  .custom-coll-count {
    font-size: 16px;
  }
  .custom-coll-turkey-row {
    margin-top: 14px;
    margin-bottom: 12px;
  }
  .custom-coll-turkey-link {
    font-size: 16px;
  }

}
</style>

<div class="custom-coll-wrap">
  <div class="custom-coll-inner">
    <div class="custom-coll-meta">
      {%- assign custom_sort_by = collection.sort_by | default: collection.default_sort_by -%}
      {%- assign custom_available_sort_values = '|' -%}
      {%- assign custom_rating_sort_value = blank -%}
      {%- for option in collection.sort_options -%}
        {%- assign custom_available_sort_values = custom_available_sort_values | append: option.value | append: '|' -%}
        {%- if option.value contains 'rating' -%}
          {%- assign custom_rating_sort_value = option.value -%}
        {%- endif -%}
      {%- endfor -%}
      <div class="custom-sort-inline">
        <label class="custom-sort-inline__label" for="custom-sort-select">{{- 'collections.sorting.title' | t -}}</label>
        <span class="custom-sort-select-wrap">
          <select id="custom-sort-select" name="sort_by" aria-label="{{- 'collections.sorting.title' | t | escape -}}">
            {%- if custom_available_sort_values contains '|manual|' -%}
              <option value="manual"{% if custom_sort_by == 'manual' %} selected{% endif %}>{{- 'collections.sorting.featured' | t | escape -}}</option>
            {%- endif -%}
            {%- if custom_available_sort_values contains '|created-descending|' -%}
              <option value="created-descending"{% if custom_sort_by == 'created-descending' %} selected{% endif %}>{{- 'collections.sorting.newest' | t | escape -}}</option>
            {%- endif -%}
            {%- if custom_available_sort_values contains '|best-selling|' -%}
              <option value="best-selling"{% if custom_sort_by == 'best-selling' %} selected{% endif %}>{{- 'collections.sorting.most_popular' | t | escape -}}</option>
            {%- endif -%}
            {%- if custom_rating_sort_value != blank -%}
              <option value="{{ custom_rating_sort_value | escape }}"{% if custom_sort_by == custom_rating_sort_value %} selected{% endif %}>{{- 'collections.sorting.highest_rated' | t | escape -}}</option>
            {%- endif -%}
            {%- if custom_available_sort_values contains '|price-ascending|' -%}
              <option value="price-ascending"{% if custom_sort_by == 'price-ascending' %} selected{% endif %}>{{- 'collections.sorting.price_low_to_high' | t | escape -}}</option>
            {%- endif -%}
            {%- if custom_available_sort_values contains '|price-descending|' -%}
              <option value="price-descending"{% if custom_sort_by == 'price-descending' %} selected{% endif %}>{{- 'collections.sorting.price_high_to_low' | t | escape -}}</option>
            {%- endif -%}
          </select>
        </span>
      </div>
      {%- assign real_count = collection.products_count -%}
      {%- if collection.handle == 'all' -%}
        {%- assign real_count = real_count | minus: 1 -%}
      {%- endif -%}
      <span class="custom-coll-count">{{ real_count | default: 0 }} products</span>
    </div>
  </div>
  {%- if collection.handle == 'grand-slam-subspecies' or collection.handle == 'world-turkey-slam' -%}
    {%- assign turkey_collection = collections['turkey'] -%}
    <div class="custom-coll-turkey-row">
      <a class="custom-coll-turkey-link" href="{%- if turkey_collection != blank -%}{{ turkey_collection.url }}{%- else -%}/collections/turkey{%- endif -%}">
        <span>Shop all Turkey</span>
        <span class="custom-coll-turkey-link__arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  {%- endif -%}
</div>

<script>
document.addEventListener('DOMContentLoaded', function(){
  var customSort = document.getElementById('custom-sort-select');
  if (customSort) {
    customSort.addEventListener('change', function(){
      var sortUrl = new URL(window.location.href);
      sortUrl.searchParams.set('sort_by', customSort.value);
      window.location.href = sortUrl.toString();
    });
  }

  // Sync count with main grid js-product-count
  var customCount = document.querySelector('.custom-coll-count');
  function syncCount() {
    var mainCount = document.querySelector('.js-product-count');
    if (mainCount && customCount && mainCount.textContent.trim() !== '') {
      var newText = mainCount.textContent.trim();
      if (customCount.textContent !== newText) {
        customCount.textContent = newText;
      }
    }
  }

  // Initial sync
  setTimeout(syncCount, 100);

  // Observe ajax DOM updates
  var observer = new MutationObserver(syncCount);
  if (document.body) {
    observer.observe(document.body, { childList: true, subtree: true, characterData: true });
  }
});
</script>
