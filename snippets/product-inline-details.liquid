{% doc %}
  Renders product information as a native inline accordion.
  @param {string} title - The summary label.
  @param {string} content - The information HTML.
  @param {string} kind - The information type.
  @param {string} [summary_detail] - Optional delivery estimate.
{% enddoc %}

{%- if content != blank -%}
  <details class="product-accordion__item product-inline-details" data-product-inline-details="{{ kind | escape }}">
    <summary class="product-accordion__trigger">
      <span class="product-accordion__trigger-text">
        <span>{{ title | escape_once }}</span>
        {%- if summary_detail != blank -%}
          <span class="product-accordion__delivery-total">{{ summary_detail }}</span>
        {%- endif -%}
      </span>
      <span class="product-accordion__trigger-icon" aria-hidden="true"></span>
    </summary>
    <div class="product-inline-details__content rte">{{ content }}</div>
  </details>
{%- endif -%}

{% stylesheet %}
  .product-inline-details > summary {
    box-sizing: border-box;
    min-height: 58px;
    list-style: none;
  }
  .product-inline-details > summary::-webkit-details-marker { display: none; }
  .product-inline-details[open] > summary .product-accordion__trigger-icon::after {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(90deg) scaleX(0);
  }
  .product-inline-details__content {
    min-width: 0;
    padding: 8px 0 24px;
    overflow-x: auto;
    color: var(--color-text-primary, #2c3d33);
    font-family: var(--base-font-family);
    font-size: 16px;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .product-inline-details__content p { margin: 0 0 16px; }
  .product-inline-details__content > :last-child { margin-bottom: 0; }
  .product-inline-details__content strong { font-weight: 700; }
  .product-inline-details__content :is(h2, h3, h4) {
    margin: 20px 0 12px;
    font-family: var(--heading-font-family);
    font-size: 20px;
    line-height: 1.4;
  }
  .product-inline-details__content > :first-child { margin-top: 0; }
  .product-inline-details__content :is(ul, ol) { padding-inline-start: 22px; }
  .product-inline-details__content img { max-width: 100%; height: auto; }
  @media (max-width: 767.98px) {
    .product-inline-details > summary { min-height: 54px; }
  }
{% endstylesheet %}
