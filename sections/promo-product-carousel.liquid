						updateTrackHeight();
					}, animationDuration + 40);
				});
			}

			function moveBy(step, event) {
				goTo(activeIndex + step, event);
			}

			function onPreviousClick(event) {
				moveBy(-1, event);
			}

			function onNextClick(event) {
				moveBy(1, event);
			}

			function onPointerDown(event) {
				if (!mobileMedia.matches || event.pointerType === 'mouse') return;
				pointerStartX = event.clientX;
				pointerStartY = event.clientY;
			}

			function onPointerUp(event) {
				if (!mobileMedia.matches || pointerStartX === null || pointerStartY === null) return;

				var deltaX = event.clientX - pointerStartX;
				var deltaY = event.clientY - pointerStartY;
				pointerStartX = null;
				pointerStartY = null;

				if (Math.abs(deltaX) < 44 || Math.abs(deltaX) <= Math.abs(deltaY)) return;
				moveBy(deltaX < 0 ? 1 : -1, event);
			}

			function onPointerCancel() {
				pointerStartX = null;
				pointerStartY = null;
			}

			previousButton.addEventListener('click', onPreviousClick, true);
			nextButton.addEventListener('click', onNextClick, true);
			slider.addEventListener('pointerdown', onPointerDown);
			slider.addEventListener('pointerup', onPointerUp);
			slider.addEventListener('pointercancel', onPointerCancel);

			if (mobileMedia.addEventListener) {
				mobileMedia.addEventListener('change', render);
			} else {
				mobileMedia.addListener(render);
			}

			if ('ResizeObserver' in window) {
				resizeObserver = new ResizeObserver(function () {
					if (mobileMedia.matches && !isAnimating) updateTrackHeight();
				});
				slides.forEach(function (slide) {
					resizeObserver.observe(slide);
				});
			}

			buildPagination();
			section.dataset.mobileProductCarouselReady = 'true';
			render();

			return function () {
				window.clearTimeout(animationTimer);
				previousButton.removeEventListener('click', onPreviousClick, true);
				nextButton.removeEventListener('click', onNextClick, true);
				slider.removeEventListener('pointerdown', onPointerDown);
				slider.removeEventListener('pointerup', onPointerUp);
				slider.removeEventListener('pointercancel', onPointerCancel);
				if (mobileMedia.removeEventListener) {
					mobileMedia.removeEventListener('change', render);
				} else {
					mobileMedia.removeListener(render);
				}
				if (resizeObserver) resizeObserver.disconnect();
				delete section.dataset.mobileProductCarouselReady;
			};
		}

		function init() {
			if (isDestroyed) return;
			window.clearTimeout(desktopRetryTimer);
			if (mobileCleanup) mobileCleanup();

			mountedSection = document.getElementById(sectionId);
			if (!mountedSection) return;

			mobileCleanup = mountMobileProductCarousel(mountedSection);
			ensureDesktopCarousel(0);
		}

		function isCurrentSectionEvent(event) {
			if (event.detail && event.detail.sectionId === sectionId) return true;
			if (!event.target || event.target === document) return false;
			if (event.target.id === sectionId || event.target.id === 'shopify-section-' + sectionId) return true;

			return typeof event.target.querySelector === 'function' && !!event.target.querySelector('#' + CSS.escape(sectionId));
		}

		function onSectionLoad(event) {
			if (isCurrentSectionEvent(event)) init();
		}

		function onSectionUnload(event) {
			if (!isCurrentSectionEvent(event)) return;
			window.clearTimeout(desktopRetryTimer);
			if (mobileCleanup) mobileCleanup();
			destroyDesktopCarousel(mountedSection);
			mobileCleanup = null;
			mountedSection = null;
		}

		function destroy() {
			isDestroyed = true;
			window.clearTimeout(desktopRetryTimer);
			document.removeEventListener('DOMContentLoaded', init);
			document.removeEventListener('shopify:section:load', onSectionLoad);
			document.removeEventListener('shopify:section:unload', onSectionUnload);
			if (mobileCleanup) mobileCleanup();
			destroyDesktopCarousel(mountedSection);
			if (lifecycleRegistry[sectionId] && lifecycleRegistry[sectionId].destroy === destroy) {
				delete lifecycleRegistry[sectionId];
			}
		}

		lifecycleRegistry[sectionId] = { destroy: destroy };

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', init, { once: true });
		} else {
			init();
		}

		document.addEventListener('shopify:section:load', onSectionLoad);
		document.addEventListener('shopify:section:unload', onSectionUnload);
	})();
