						if (eligibleCandidates.length) {
							var candidateIndex = Math.floor(Math.random() * eligibleCandidates.length);
							var selectedCandidate = eligibleCandidates[candidateIndex];
							var selectedHandle = normalizeProductHandle(selectedCandidate.getAttribute('data-product-handle'));

							selectedCandidate.setAttribute(
								'data-product-type-top-five-rank',
								selectedCandidate.getAttribute('data-best-seller-rank') || String(candidateIndex + 1)
							);
							selectedHandles[selectedHandle] = true;
							selectedCandidates.push(selectedCandidate);
						}
					})
					.then(function() {
						return selectNextProductType(index + 1);
					});
			}

			selectNextProductType(0).then(function() {
				if (!runtimeActive) return;

				if (selectedCandidates.length === recommendationLimit) {
					replaceProductTypeRecommendationSlides(section, selectedCandidates);
				} else {
					section.setAttribute('data-product-type-recommendations-failed', 'true');
					section.removeAttribute('data-product-type-recommendations-refreshing');
					section.removeAttribute('data-product-type-recommendations-pending');
					section.hidden = false;
				}
			}).catch(function() {
				if (!runtimeActive) return;

				section.setAttribute('data-product-type-recommendations-failed', 'true');
				section.removeAttribute('data-product-type-recommendations-refreshing');
				section.removeAttribute('data-product-type-recommendations-pending');
				section.hidden = false;
			});
		}
		function initializeProductRecommendations() {
			if (!runtimeActive) return;

			runResponsiveRecommendationSync();
			initBundleRecommendationFilter();
			loadRandomProductTypeRecommendations();
		}

		function handleThemeRuntimeRefresh() {
			requestResponsiveRecommendationSync();
			initBundleRecommendationFilter();
		}

		function handleSectionUnload(event) {
			var section = document.getElementById('{{ section.id }}');

			if (
				!event ||
				!event.target ||
				!section ||
				event.target === section ||
				event.target.contains(section)
			) {
				destroyRuntime();
			}
		}

		if (document.readyState === 'loading') {
			addRuntimeListener(document, 'DOMContentLoaded', initializeProductRecommendations, { once: true });
		} else {
			initializeProductRecommendations();
		}

		addRuntimeListener(window, 'resize', requestResponsiveRecommendationSync);
		addRuntimeListener(window, 'orientationchange', requestResponsiveRecommendationSync);
		addRuntimeListener(window, 'load', requestResponsiveRecommendationSync);
		addRuntimeListener(document, 'theme:all:loaded', handleThemeRuntimeRefresh);
		addRuntimeListener(document, 'shopify:section:load', handleThemeRuntimeRefresh);
		addRuntimeListener(document, 'shopify:section:select', requestResponsiveRecommendationSync);
		addRuntimeListener(document, 'shopify:section:unload', handleSectionUnload);
		addRuntimeListener(mobileQuery, 'change', requestResponsiveRecommendationSync);

		if (window.ResizeObserver) {
			var observedSection = document.getElementById('{{ section.id }}');

			if (observedSection) {
				var sectionResizeObserver = trackRuntimeObserver(new ResizeObserver(requestResponsiveRecommendationSync));
				sectionResizeObserver.observe(observedSection);
			}
		}

		if (window.MutationObserver) {
			var mutableSection = document.getElementById('{{ section.id }}');

			if (mutableSection) {
				var sectionMutationObserver = trackRuntimeObserver(new MutationObserver(requestResponsiveRecommendationSync));
				sectionMutationObserver.observe(mutableSection, {
					attributes: true,
					attributeFilter: ['style']
				});
			}
		}
	})();
</script>

