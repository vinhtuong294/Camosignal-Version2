{%- comment -%}
	------------------------------------------------------------------------------
	Snippet: Sort
	- id: id (required)
	- product_list: Collection or Search object (required)
	- sort_type: Sort type (primary/secondary)
	- external: Is outside the form layout (true / false)

	Usage:

	{%- render 'sort', product_list: collection -%}
	or
	{%- render 'sort', product_list: search -%}
	------------------------------------------------------------------------------
{%- endcomment -%}

{%- render 'adastra' with '/src/styles/sort.scss' -%}

{%- assign sort_by = product_list.sort_by | default: product_list.default_sort_by -%}

{%- if sort_type == 'secondary' %}
	{%- assign sort_class = 'sort--secondary' -%}
{%- else -%}
	{%- assign sort_class = 'sort--primary' -%}
{%- endif -%}

<div class="sort {{ sort_class }} js-filter-sort {% if external -%}js-filter-sort-external{%- endif -%}">
	<label class="sort__label" for="Sort-{{ section.id }}-{{- id -}}">
		{{- 'collections.sorting.title' | t -}}
	</label>

	<div class="sort__select-wrapper select-wrapper">
		<select
			class="sort__select  {% if external -%}js-sort-select-external{%- endif -%}"
			id="Sort-{{ section.id }}-{{- id -}}"
			name="sort_by"
			aria-label="{{- 'collections.sorting.title' | t | escape -}}"
		>
			{%- assign available_sort_values = '|' -%}
			{%- assign rating_sort_value = blank -%}
			{%- for option in product_list.sort_options -%}
				{%- assign available_sort_values = available_sort_values | append: option.value | append: '|' -%}
				{%- if option.value contains 'rating' -%}
					{%- assign rating_sort_value = option.value -%}
				{%- endif -%}
			{%- endfor -%}

			{%- if available_sort_values contains '|manual|' -%}
				<option value="manual" {% if sort_by == 'manual' %} selected{%- endif -%}>{{- 'collections.sorting.featured' | t | escape -}}</option>
			{%- endif -%}
			{%- if available_sort_values contains '|created-descending|' -%}
				<option value="created-descending" {% if sort_by == 'created-descending' %} selected{%- endif -%}>{{- 'collections.sorting.newest' | t | escape -}}</option>
			{%- endif -%}
			{%- if available_sort_values contains '|best-selling|' -%}
				<option value="best-selling" {% if sort_by == 'best-selling' %} selected{%- endif -%}>{{- 'collections.sorting.most_popular' | t | escape -}}</option>
			{%- endif -%}
			{%- if rating_sort_value != blank -%}
				<option value="{{- rating_sort_value | escape -}}" {% if sort_by == rating_sort_value %} selected{%- endif -%}>{{- 'collections.sorting.highest_rated' | t | escape -}}</option>
			{%- endif -%}
			{%- if available_sort_values contains '|price-ascending|' -%}
				<option value="price-ascending" {% if sort_by == 'price-ascending' %} selected{%- endif -%}>{{- 'collections.sorting.price_low_to_high' | t | escape -}}</option>
			{%- endif -%}
			{%- if available_sort_values contains '|price-descending|' -%}
				<option value="price-descending" {% if sort_by == 'price-descending' %} selected{%- endif -%}>{{- 'collections.sorting.price_high_to_low' | t | escape -}}</option>
			{%- endif -%}
		</select>
	</div>
</div>
