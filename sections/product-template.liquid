<script>
/* On small screens, place the existing breadcrumb and title/review block before
   the gallery. Moving (rather than copying) keeps IDs, app widgets and heading
   semantics unique. Restore the original form order when the viewport grows. */
(function() {
	var sectionRoot = document.getElementById('shopify-section-{{ section.id }}');
	if (!sectionRoot) return;

	var summarySlot = sectionRoot.querySelector('[data-mobile-product-summary]');
	var productForm = sectionRoot.querySelector('.product-form');
	if (!summarySlot || !productForm) return;

	var mobileQuery = window.matchMedia('(max-width: 767px)');
	var movedItems = [];

	function findDirectChild(className) {
		for (var i = 0; i < productForm.children.length; i++) {
			if (productForm.children[i].classList.contains(className)) {
				return productForm.children[i];
			}
		}
		return null;
	}

	function moveSummaryAboveGallery() {
		if (movedItems.length > 0) return;

		['product-breadcrumbs', 'product-title-wrapper'].forEach(function(className) {
			var element = findDirectChild(className);
			if (!element) return;

			var marker = document.createComment('mobile-product-summary-' + className);
			element.parentNode.insertBefore(marker, element);
			movedItems.push({ element: element, marker: marker });
			summarySlot.appendChild(element);
		});
	}

	function restoreSummaryToForm() {
		movedItems.forEach(function(item) {
			if (item.marker.parentNode) {
				item.marker.parentNode.insertBefore(item.element, item.marker);
				item.marker.parentNode.removeChild(item.marker);
			}
		});
		movedItems = [];
	}

	function syncMobileProductHierarchy() {
		if (mobileQuery.matches) {
			moveSummaryAboveGallery();
		} else {
			restoreSummaryToForm();
		}
	}

	syncMobileProductHierarchy();

	if (mobileQuery.addEventListener) {
		mobileQuery.addEventListener('change', syncMobileProductHierarchy);
	} else if (mobileQuery.addListener) {
		mobileQuery.addListener(syncMobileProductHierarchy);
	}
})();
</script>

<script>
/* Keep the Judge.me review count concise and use it as an accessible jump link
   to the full review widget, even when the app hydrates asynchronously. */
(function() {
	var sectionRoot = document.getElementById('shopify-section-{{ section.id }}');
	var reviewContainer = document.getElementById('injected-review-container-{{ section.id }}');
	if (!sectionRoot || !reviewContainer) return;

	function findReviewTarget() {
		return document.getElementById('judgeme_product_reviews')
			|| document.querySelector('.jdgm-review-widget:not(.jdgm-preview-badge), .jdgm-rev-widg');
	}

	function jumpToReviews(event) {
		if (event.type === 'keydown' && event.key !== 'Enter' && event.key !== ' ') return;

		var reviewTarget = findReviewTarget();
		if (!reviewTarget) return;

		event.preventDefault();
		event.stopPropagation();

		var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		reviewTarget.scrollIntoView({
			behavior: reduceMotion ? 'auto' : 'smooth',
			block: 'start'
		});
	}

	function enhanceReviewBadge() {
		var badge = reviewContainer.querySelector('.jdgm-prev-badge');
		var reviewCountLink = reviewContainer.querySelector('.jdgm-prev-badge__text');
		if (!badge || !reviewCountLink) return;

		var reviewCount = badge.getAttribute('data-number-of-reviews');
		if (reviewCount === null || reviewCount === '') {
			var countMatch = reviewCountLink.textContent.match(/[\d][\d,.]*/);
			if (!countMatch) return;
			reviewCount = countMatch[0];
		}

		reviewCount = String(reviewCount).trim();
		if (reviewCountLink.textContent.trim() !== reviewCount) {
			reviewCountLink.textContent = reviewCount;
		}

		var numericCount = parseInt(reviewCount.replace(/[^\d]/g, ''), 10) || 0;
		reviewCountLink.setAttribute('role', 'link');
		reviewCountLink.setAttribute('tabindex', '0');
		reviewCountLink.setAttribute(
			'aria-label',
			'View ' + reviewCount + ' customer review' + (numericCount === 1 ? '' : 's')
		);

		if (reviewCountLink.getAttribute('data-review-jump-bound') !== 'true') {
			reviewCountLink.setAttribute('data-review-jump-bound', 'true');
			reviewCountLink.addEventListener('click', jumpToReviews);
			reviewCountLink.addEventListener('keydown', jumpToReviews);
		}
	}

	enhanceReviewBadge();

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', enhanceReviewBadge, { once: true });
	}
	window.addEventListener('load', enhanceReviewBadge, { once: true });

	var reviewObserver = new MutationObserver(enhanceReviewBadge);
	reviewObserver.observe(sectionRoot, {
		childList: true,
		subtree: true,
		characterData: true,
		attributes: true,
		attributeFilter: ['data-number-of-reviews']
	});
})();
</script>

<script>
/* Fix zoom modal kẹt trong stacking context do position: sticky.
   Đợi theme JS init xong (theme:all:loaded) rồi mới di chuyển modal ra ngoài body.
   Vì: JS khởi tạo zoom lưu reference đến modal element trước → di chuyển sau không làm hỏng reference */
(function() {
	function teleportZoomModal() {
		var zoomModals = document.querySelectorAll('[data-zoom-modal]');
		zoomModals.forEach(function(modal) {
			if (modal && modal.parentElement !== document.body) {
				document.body.appendChild(modal);
			}
		});
	}

	/* Chạy sau khi theme JS đã init xong */
	document.addEventListener('theme:all:loaded', function() {
		setTimeout(teleportZoomModal, 100);
	}, { once: true });

	/* Fallback: nếu theme:all:loaded đã bắn trước khi script này chạy */
	if (window.themeCore && window.themeCore.loaded) {
		setTimeout(teleportZoomModal, 200);
	}

	/* Re-run on Shopify section reload (theme editor) */
	document.addEventListener('shopify:section:load', function() {
		setTimeout(teleportZoomModal, 300);
	});
})();
</script>



