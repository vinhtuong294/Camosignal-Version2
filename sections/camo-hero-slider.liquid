{%- liquid
	assign section_id = 'camo-hero-slider-' | append: section.id
	assign enable_autoplay = true
	if section.settings.enable_autoplay == false
		assign enable_autoplay = false
	endif
	assign autoplay_delay_seconds = section.settings.autoplay_delay | default: 5
	assign autoplay_delay = autoplay_delay_seconds | times: 1000
	assign slide_count = section.blocks.size
	assign show_content = section.settings.show_content
	assign enable_overlay = section.settings.enable_overlay
	assign offset_top_mobile = section.settings.offset_top_mobile | default: 0
	assign offset_bottom_mobile = section.settings.offset_bottom_mobile | default: 0
	assign offset_top_desktop = section.settings.offset_top_desktop | default: 0
	assign offset_bottom_desktop = section.settings.offset_bottom_desktop | default: 0
	assign accessibility_label = section.settings.accessibility_label | default: 'Homepage banner slider'
	assign content_width = section.settings.content_width | default: 760
	assign text_color = section.settings.text_color | default: '#ffffff'
	assign accent_color = section.settings.accent_color | default: '#d84b2a'
	assign button_text_color = section.settings.button_text_color | default: '#ffffff'
	assign button_background = section.settings.button_background | default: 'rgba(0,0,0,0)'
	assign button_border = section.settings.button_border | default: '#ffffff'
-%}

{%- if slide_count > 0 -%}
	{%- style -%}
		#shopify-section-{{ section.id }} {
			padding-top: {{ offset_top_mobile }}px;
			padding-bottom: {{ offset_bottom_mobile }}px;
		}

		#{{ section_id }} {
			--camo-hero-height-desktop: {{ section.settings.height_desktop }}px;
			--camo-hero-height-mobile: {{ section.settings.height_mobile }}px;
			--camo-hero-content-width: {{ content_width }}px;
			--camo-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
			--camo-hero-accent: {{ accent_color }};
			--camo-hero-text: {{ text_color }};
			--camo-hero-button-text: {{ button_text_color }};
			--camo-hero-button-bg: {{ button_background }};
			--camo-hero-button-border: {{ button_border }};
		}

		@media screen and (min-width: 768px) {
			#shopify-section-{{ section.id }} {
				padding-top: {{ offset_top_desktop }}px;
				padding-bottom: {{ offset_bottom_desktop }}px;
			}
		}
	{%- endstyle -%}

	<section
		id="{{ section_id }}"
		class="camo-hero-slider"
		data-camo-hero-slider
		data-autoplay="{{ enable_autoplay }}"
		data-delay="{{ autoplay_delay }}"
		aria-roledescription="carousel"
		aria-label="{{ accessibility_label | escape }}"
	>
		<div class="camo-hero-slider__track" data-camo-hero-track>
			{%- for block in section.blocks -%}
				{%- liquid
					assign asset_image_desktop = block.settings.asset_image_desktop | strip
					assign asset_image_mobile = block.settings.asset_image_mobile | strip
					if asset_image_desktop == blank
						assign asset_image_desktop = asset_image_mobile
					endif
					if asset_image_mobile == blank
						assign asset_image_mobile = asset_image_desktop
					endif
					assign use_asset_images = false
					if asset_image_desktop != blank
						assign use_asset_images = true
					endif
					assign image_desktop = block.settings.image_desktop
					assign image_mobile = block.settings.image_mobile
					if image_desktop == blank
						assign image_desktop = image_mobile
					endif
					if image_mobile == blank
						assign image_mobile = image_desktop
					endif
					assign heading = block.settings.heading
					assign image_alt = image_desktop.alt | default: heading
					assign slide_link = block.settings.full_slide_link | default: block.settings.button_link
					assign content_position = block.settings.content_position | default: 'center'
					assign mobile_content_position = block.settings.mobile_content_position | default: 'center'
					assign mobile_button_position = block.settings.mobile_button_position | default: 'center'
					assign slide_heading_color = block.settings.heading_color | default: text_color
					assign slide_subheading_color = block.settings.subheading_color | default: text_color
					assign slide_button_text = block.settings.slide_button_text_color | default: button_text_color
					assign slide_button_background = block.settings.slide_button_background | default: button_background
					assign slide_button_border = block.settings.slide_button_border | default: button_border
					assign slide_scrim = block.settings.content_scrim_opacity | default: 0 | divided_by: 100.0
					assign desktop_image_position = block.settings.desktop_image_position | default: 'center center'
					assign mobile_image_position = block.settings.mobile_image_position | default: 'center center'
					assign desktop_aspect = '16 / 9'
					assign mobile_aspect = desktop_aspect
					if use_asset_images
						assign desktop_aspect = '1800 / 760'
						assign mobile_aspect = '1100 / 1375'
					elsif image_desktop != blank and image_desktop.width > 0 and image_desktop.height > 0
						assign desktop_aspect = image_desktop.width | append: ' / ' | append: image_desktop.height
					endif
					if use_asset_images
						assign mobile_aspect = '1100 / 1375'
					elsif image_mobile != blank and image_mobile.width > 0 and image_mobile.height > 0
						assign mobile_aspect = image_mobile.width | append: ' / ' | append: image_mobile.height
					else
						assign mobile_aspect = desktop_aspect
					endif
					assign is_active = false
					if forloop.first
						assign is_active = true
					endif
				-%}

				<article
					class="camo-hero-slider__slide{% if is_active %} is-active{% endif %} camo-hero-slider__slide--{{ content_position }} camo-hero-slider__slide--mobile-{{ mobile_content_position }} camo-hero-slider__slide--mobile-button-{{ mobile_button_position }}"
					data-camo-hero-slide
					data-slide-index="{{ forloop.index0 }}"
					data-slide-link="{{ slide_link | escape }}"
					aria-hidden="{% if is_active %}false{% else %}true{% endif %}"
					{{ block.shopify_attributes }}
					style="--camo-hero-desktop-position: {{ desktop_image_position }}; --camo-hero-mobile-position: {{ mobile_image_position }}; --camo-hero-aspect-desktop: {{ desktop_aspect }}; --camo-hero-aspect-mobile: {{ mobile_aspect }}; --camo-slide-heading: {{ slide_heading_color }}; --camo-slide-subheading: {{ slide_subheading_color }}; --camo-slide-button-text: {{ slide_button_text }}; --camo-slide-button-bg: {{ slide_button_background }}; --camo-slide-button-border: {{ slide_button_border }}; --camo-slide-scrim: {{ slide_scrim }};"
				>
					<div class="camo-hero-slider__media">
						{%- if use_asset_images -%}
							<picture>
								<source
									media="(max-width: 767px)"
									srcset="{{ asset_image_mobile | asset_url }}"
									sizes="100vw"
								>
								<img
									src="{{ asset_image_desktop | asset_url }}"
									alt="{{ heading | escape }}"
									width="1800"
									height="760"
									loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
									fetchpriority="{% if forloop.first %}high{% else %}low{% endif %}"
									decoding="async"
									draggable="false"
								>
							</picture>
						{%- elsif image_desktop != blank -%}
							<picture>
								<source
									media="(max-width: 767px)"
									srcset="
										{{ image_mobile | image_url: width: 390 }} 390w,
										{{ image_mobile | image_url: width: 780 }} 780w,
										{{ image_mobile | image_url: width: 1100 }} 1100w
									"
									sizes="100vw"
								>
								<img
									src="{{ image_desktop | image_url: width: 1920 }}"
									srcset="
										{{ image_desktop | image_url: width: 960 }} 960w,
										{{ image_desktop | image_url: width: 1440 }} 1440w,
										{{ image_desktop | image_url: width: 1920 }} 1920w,
										{{ image_desktop | image_url: width: 2400 }} 2400w
									"
									sizes="100vw"
									alt="{{ image_alt | escape }}"
									width="{{ image_desktop.width }}"
									height="{{ image_desktop.height }}"
									loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
									fetchpriority="{% if forloop.first %}high{% else %}low{% endif %}"
									draggable="false"
								>
							</picture>
						{%- else -%}
							{{ 'hero-apparel-1' | placeholder_svg_tag: 'camo-hero-slider__placeholder' }}
						{%- endif -%}
					</div>

					{%- if enable_overlay and section.settings.overlay_opacity > 0 -%}
						<div class="camo-hero-slider__shade"></div>
					{%- endif -%}

					{%- if show_content -%}
						<div class="camo-hero-slider__content">
							<div class="camo-hero-slider__content-inner">
								{%- if block.settings.eyebrow != blank -%}
									<p class="camo-hero-slider__eyebrow">{{ block.settings.eyebrow }}</p>
								{%- endif -%}

								{%- if heading != blank -%}
									<h2 class="camo-hero-slider__heading">{{ heading }}</h2>
								{%- endif -%}

								{%- if block.settings.accent_text != blank -%}
									<p class="camo-hero-slider__accent">{{ block.settings.accent_text }}</p>
								{%- endif -%}

								{%- if block.settings.subheading != blank -%}
									<div class="camo-hero-slider__subheading rte">{{ block.settings.subheading }}</div>
								{%- endif -%}

								{%- if block.settings.button_label != blank and slide_link != blank -%}
									<a class="camo-hero-slider__button" href="{{ slide_link }}">
										<span class="camo-hero-slider__button-label">{{ block.settings.button_label }}</span>
										<span class="camo-hero-slider__button-icon" aria-hidden="true">
											{%- render 'icons', icon: 'arrow-right-2' -%}
										</span>
									</a>
								{%- endif -%}
							</div>
						</div>
					{%- endif -%}
				</article>
			{%- endfor -%}
		</div>

		{%- if slide_count > 1 and section.settings.show_dots -%}
			<div class="camo-hero-slider__controls">
				<div class="camo-hero-slider__dots" role="tablist" aria-label="Choose slide">
					{%- for block in section.blocks -%}
						<button
							class="camo-hero-slider__dot{% if forloop.first %} is-active{% endif %}"
							type="button"
							data-camo-hero-dot
							data-slide-index="{{ forloop.index0 }}"
							aria-label="Go to slide {{ forloop.index }}"
							aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
						></button>
					{%- endfor -%}
				</div>
			</div>
		{%- endif -%}
	</section>
{%- endif -%}

{% stylesheet %}
	.camo-hero-slider {
		position: relative;
		overflow: hidden;
		min-height: 0;
		aspect-ratio: var(--camo-hero-aspect-mobile, 16 / 9);
		background: #10110e;
		color: var(--camo-hero-text);
		cursor: grab;
		touch-action: pan-y;
		user-select: none;
	}

	.camo-hero-slider.is-dragging {
		cursor: grabbing;
	}

	.camo-hero-slider__slide[data-slide-link]:not([data-slide-link=""]) {
		cursor: pointer;
	}

	.camo-hero-slider__track,
	.camo-hero-slider__slide,
	.camo-hero-slider__media,
	.camo-hero-slider__media picture,
	.camo-hero-slider__media img,
	.camo-hero-slider__placeholder {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.camo-hero-slider__slide {
		opacity: 0;
		visibility: hidden;
		transition: opacity 680ms ease, visibility 680ms ease;
	}

	.camo-hero-slider__slide.is-active {
		opacity: 1;
		visibility: visible;
		z-index: 1;
	}

	.camo-hero-slider__slide::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 2;
		background: linear-gradient(
			180deg,
			rgba(7, 16, 12, var(--camo-slide-scrim, 0)) 0%,
			rgba(7, 16, 12, 0) 58%
		);
		pointer-events: none;
	}

	.camo-hero-slider.is-swipe-next .camo-hero-slider__slide,
	.camo-hero-slider.is-swipe-prev .camo-hero-slider__slide {
		visibility: hidden;
		opacity: 0;
		transition: none;
	}

	.camo-hero-slider.is-swipe-next .camo-hero-slider__slide.is-swipe-from,
	.camo-hero-slider.is-swipe-prev .camo-hero-slider__slide.is-swipe-from,
	.camo-hero-slider.is-swipe-next .camo-hero-slider__slide.is-swipe-to,
	.camo-hero-slider.is-swipe-prev .camo-hero-slider__slide.is-swipe-to {
		visibility: visible;
		opacity: 1;
		z-index: 2;
	}

	.camo-hero-slider.is-swipe-next .camo-hero-slider__slide.is-swipe-from {
		animation: camoHeroSlideOutLeft 420ms ease forwards;
	}

	.camo-hero-slider.is-swipe-next .camo-hero-slider__slide.is-swipe-to {
		animation: camoHeroSlideInRight 420ms ease forwards;
	}

	.camo-hero-slider.is-swipe-prev .camo-hero-slider__slide.is-swipe-from {
		animation: camoHeroSlideOutRight 420ms ease forwards;
	}

	.camo-hero-slider.is-swipe-prev .camo-hero-slider__slide.is-swipe-to {
		animation: camoHeroSlideInLeft 420ms ease forwards;
	}

	@keyframes camoHeroSlideInRight {
		from { transform: translateX(100%); }
		to { transform: translateX(0); }
	}

	@keyframes camoHeroSlideOutLeft {
		from { transform: translateX(0); }
		to { transform: translateX(-100%); }
	}

	@keyframes camoHeroSlideInLeft {
		from { transform: translateX(-100%); }
		to { transform: translateX(0); }
	}

	@keyframes camoHeroSlideOutRight {
		from { transform: translateX(0); }
		to { transform: translateX(100%); }
	}

	.camo-hero-slider__media img,
	.camo-hero-slider__placeholder {
		display: block;
		object-fit: contain;
		object-position: var(--camo-hero-mobile-position);
		transform: none;
	}

	.camo-hero-slider__shade {
		position: absolute;
		inset: 0;
		z-index: 2;
		background: rgba(0, 0, 0, var(--camo-hero-overlay));
		pointer-events: none;
	}

	.camo-hero-slider__content {
		position: absolute;
		inset: 0;
		z-index: 4;
		display: flex;
		align-items: flex-start;
		padding: calc(var(--header-height-static, 73px) + 16px) 24px 54px;
		pointer-events: none;
	}

	.camo-hero-slider__content-inner {
		width: min(100%, 350px);
		margin: 0 auto;
		text-align: center;
		pointer-events: none;
	}

	.camo-hero-slider__slide--left .camo-hero-slider__content-inner {
		margin-inline: 0 auto;
		text-align: left;
	}

	.camo-hero-slider__slide--right .camo-hero-slider__content-inner {
		margin-inline: auto 0;
		text-align: right;
	}

	.camo-hero-slider__eyebrow,
	.camo-hero-slider__subheading,
	.camo-hero-slider__button {
		font-family: var(--base-font-family, inherit);
	}

	.camo-hero-slider__eyebrow {
		display: inline-block;
		margin: 0 0 12px;
		padding: 6px 10px 5px;
		border: 1px solid color-mix(in srgb, var(--camo-slide-button-border, #e4ad00) 70%, transparent);
		background: rgba(12, 31, 23, 0.64);
		box-shadow: 0 6px 20px rgba(3, 10, 7, 0.2);
		color: var(--camo-slide-button-border, #e4ad00);
		font-size: 10px;
		font-weight: 800;
		letter-spacing: 0.15em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.camo-hero-slider__heading {
		margin: 0;
		color: var(--camo-slide-heading, var(--camo-hero-text));
		font-family: var(--heading-font-family, inherit);
		font-size: clamp(25px, 7.5vw, 30px);
		font-weight: 900;
		letter-spacing: -0.02em;
		line-height: 0.94;
		text-shadow: 0 2px 0 rgba(0, 0, 0, 0.5), 0 8px 22px rgba(0, 0, 0, 0.28);
		text-transform: uppercase;
		text-wrap: balance;
		white-space: nowrap;
	}

	.camo-hero-slider__accent {
		margin: 8px 0 0;
		color: var(--camo-hero-accent);
		font-size: clamp(27px, 8vw, 48px);
		font-style: italic;
		font-weight: 900;
		letter-spacing: 0;
		line-height: 0.9;
		text-transform: uppercase;
		text-wrap: balance;
	}

	.camo-hero-slider__subheading {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		max-width: 620px;
		margin: 8px auto 0;
		color: var(--camo-slide-subheading, var(--camo-hero-text));
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.035em;
		line-height: 1.35;
		text-shadow: 0 2px 12px rgba(0, 0, 0, 0.42);
	}

	.camo-hero-slider__subheading::before,
	.camo-hero-slider__subheading::after {
		content: "";
		width: 22px;
		height: 1px;
		background: currentColor;
		opacity: 0.88;
	}

	.camo-hero-slider__subheading p {
		margin: 0;
	}

	.camo-hero-slider__slide--left .camo-hero-slider__subheading {
		margin-inline: 0 auto;
	}

	.camo-hero-slider__slide--right .camo-hero-slider__subheading {
		margin-inline: auto 0;
	}

	.camo-hero-slider__button {
		position: relative;
		z-index: 5;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 16px;
		min-width: 176px;
		min-height: 48px;
		margin-top: 12px;
		padding: 13px 20px 13px 22px;
		border: 2px solid var(--camo-slide-button-border, var(--camo-hero-button-border));
		border-radius: 0;
		background: var(--camo-slide-button-bg, var(--camo-hero-button-bg));
		box-shadow: none;
		color: var(--camo-slide-button-text, var(--camo-hero-button-text));
		font-family: var(--heading-font-family, inherit);
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0;
		line-height: 1;
		text-decoration: none;
		text-transform: uppercase;
		pointer-events: auto;
		transition: transform 180ms ease, background-color 180ms ease, color 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
	}

	.camo-hero-slider__button-label {
		flex: 0 0 auto;
		padding-right: 0;
		white-space: nowrap;
	}

	.camo-hero-slider__button-icon {
		display: inline-flex;
		width: 22px;
		height: 22px;
		flex: 0 0 22px;
		align-items: center;
		justify-content: center;
		background: transparent;
		color: currentColor;
		transition: transform 180ms ease;
	}

	.camo-hero-slider__button-icon .icon {
		width: 22px;
		height: 22px;
	}

	.camo-hero-slider__button:hover,
	.camo-hero-slider__button:focus-visible {
		background: #ffffff;
		border-color: #ffffff;
		box-shadow: none;
		color: #000000;
		transform: none;
	}

	.camo-hero-slider__button:hover .camo-hero-slider__button-icon,
	.camo-hero-slider__button:focus-visible .camo-hero-slider__button-icon {
		background: transparent;
		color: currentColor;
		transform: translateX(4px);
	}

	.camo-hero-slider__button:focus-visible {
		outline: 3px solid #ffffff;
		outline-offset: 4px;
	}

	.camo-hero-slider__controls {
		position: absolute;
		inset: 0;
		z-index: 6;
		pointer-events: none;
	}

	.camo-hero-slider__dot {
		pointer-events: auto;
	}

	.camo-hero-slider__dots {
		position: absolute;
		right: 24px;
		bottom: 12px;
		left: 24px;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 2px;
	}

	.camo-hero-slider__dot {
		position: relative;
		width: 32px;
		height: 32px;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: transparent;
		cursor: pointer;
	}

	.camo-hero-slider__dot:focus-visible {
		outline: 2px solid #f4c430;
		outline-offset: -5px;
	}

	.camo-hero-slider__dot::before {
		content: "";
		position: absolute;
		top: 50%;
		left: 50%;
		width: 8px;
		height: 8px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.48);
		transform: translate(-50%, -50%);
		transition: background-color 180ms ease, transform 180ms ease;
	}

	.camo-hero-slider__dot.is-active::before {
		background: #fff;
		transform: translate(-50%, -50%) scale(1.35);
	}

	@media screen and (max-width: 767px) {
		.camo-hero-slider__content-inner {
			width: min(100%, 318px);
		}

		.camo-hero-slider__slide--mobile-center .camo-hero-slider__content-inner {
			width: min(100%, 342px);
			margin-inline: auto;
			text-align: center;
		}

		.camo-hero-slider__subheading {
			display: grid;
			grid-template-columns: minmax(14px, 1fr) auto minmax(14px, 1fr);
			width: 100%;
		}

		.camo-hero-slider__subheading::before,
		.camo-hero-slider__subheading::after {
			width: 100%;
		}

		.camo-hero-slider__button {
			position: absolute;
			right: 16px;
			bottom: 48px;
			width: 176px;
			min-width: 176px;
			margin: 0;
			justify-content: center;
			gap: 12px;
		}

		.camo-hero-slider__slide--mobile-button-left .camo-hero-slider__button {
			display: flex;
			margin-inline: 0 auto;
		}

		.camo-hero-slider__slide--mobile-button-center .camo-hero-slider__button {
			display: flex;
			margin-inline: auto;
		}

		.camo-hero-slider__slide--mobile-button-right .camo-hero-slider__button {
			display: flex;
			margin-inline: auto 0;
		}

		.camo-hero-slider__slide .camo-hero-slider__button {
			margin: 0;
		}

		.camo-hero-slider__slide--left .camo-hero-slider__content-inner,
		.camo-hero-slider__slide--right .camo-hero-slider__content-inner {
			margin-inline: auto;
			text-align: center;
		}

		.camo-hero-slider__slide--left .camo-hero-slider__subheading,
		.camo-hero-slider__slide--right .camo-hero-slider__subheading {
			margin-inline: auto;
		}

		.camo-hero-slider__slide--mobile-left .camo-hero-slider__content-inner {
			margin-inline: 0 auto;
			text-align: left;
		}

		.camo-hero-slider__slide--mobile-left .camo-hero-slider__subheading {
			justify-content: stretch;
			margin-inline: 0 auto;
		}

		.camo-hero-slider__slide--mobile-right .camo-hero-slider__content-inner {
			margin-inline: auto 0;
			text-align: right;
		}

		.camo-hero-slider__slide--mobile-right .camo-hero-slider__subheading {
			justify-content: flex-end;
			margin-inline: auto 0;
		}
	}

	@media screen and (max-width: 340px) {
		.camo-hero-slider__subheading {
			gap: 8px;
			font-size: 11px;
		}
	}

	@media screen and (min-width: 768px) {
		.camo-hero-slider {
			aspect-ratio: var(--camo-hero-aspect-desktop, 16 / 9);
		}

		.camo-hero-slider__media img,
		.camo-hero-slider__placeholder {
			object-position: var(--camo-hero-desktop-position);
		}

		.camo-hero-slider__slide::after {
			background: linear-gradient(
				90deg,
				rgba(7, 16, 12, var(--camo-slide-scrim, 0)) 0%,
				rgba(7, 16, 12, 0) 62%
			);
		}

		.camo-hero-slider__content {
			align-items: center;
			padding: max(130px, calc(var(--header-height-static, 102px) + 28px)) 72px 76px;
		}

		.camo-hero-slider__content-inner {
			width: min(100%, var(--camo-hero-content-width));
		}

		.camo-hero-slider__heading {
			font-size: clamp(52px, 4vw, 76px);
			white-space: nowrap;
		}

		.camo-hero-slider__eyebrow {
			margin-bottom: 16px;
			padding: 8px 13px 7px;
			font-size: 12px;
			letter-spacing: 0.17em;
		}

		.camo-hero-slider__accent {
			font-size: clamp(42px, 4.8vw, 78px);
		}

		.camo-hero-slider__subheading {
			display: block;
			width: 100%;
			margin-top: 18px;
			font-size: clamp(17px, 1.35vw, 24px);
			text-align: left;
		}

		.camo-hero-slider__subheading::before,
		.camo-hero-slider__subheading::after {
			content: none;
			display: none;
		}

		.camo-hero-slider__button {
			min-width: 208px;
			min-height: 52px;
			margin-top: 24px;
			padding: 14px 25px 14px 29px;
			font-size: 14px;
		}

		.camo-hero-slider__button-label {
			padding-right: 0;
		}

		.camo-hero-slider__button-icon {
			width: 24px;
			height: 24px;
			flex-basis: 24px;
		}

		.camo-hero-slider__button-icon .icon {
			width: 24px;
			height: 24px;
		}

		.camo-hero-slider__dots {
			bottom: 18px;
		}

	}

	@media (prefers-reduced-motion: reduce) {
		.camo-hero-slider__slide,
		.camo-hero-slider__button,
		.camo-hero-slider__dot {
			transition: none;
		}
	}
{% endstylesheet %}

{% javascript %}
	(() => {
		const selectors = {
			root: '[data-camo-hero-slider]',
			slide: '[data-camo-hero-slide]',
			dot: '[data-camo-hero-dot]'
		};

		const initSlider = (root) => {
			if (root.dataset.camoHeroReady === 'true') return;

			const slides = Array.from(root.querySelectorAll(selectors.slide));
			const dots = Array.from(root.querySelectorAll(selectors.dot));
			const autoplay = root.dataset.autoplay === 'true';
			const delay = Number(root.dataset.delay) || 5000;
			let activeIndex = Math.max(0, slides.findIndex((slide) => slide.classList.contains('is-active')));
			let timer = null;
			let pointerStart = null;
			let pointerStartY = null;
			let pointerCurrent = null;
			let pointerCurrentY = null;
			let preventClick = false;

			const setActive = (index) => {
				if (slides.length === 0) return;

				activeIndex = (index + slides.length) % slides.length;

				slides.forEach((slide, slideIndex) => {
					const isActive = slideIndex === activeIndex;
					slide.classList.toggle('is-active', isActive);
					slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');

					if (isActive) {
						const desktopAspect = slide.style.getPropertyValue('--camo-hero-aspect-desktop');
						const mobileAspect = slide.style.getPropertyValue('--camo-hero-aspect-mobile');
						if (desktopAspect) root.style.setProperty('--camo-hero-aspect-desktop', desktopAspect);
						if (mobileAspect) root.style.setProperty('--camo-hero-aspect-mobile', mobileAspect);
					}
				});

				dots.forEach((dot, dotIndex) => {
					const isActive = dotIndex === activeIndex;
					dot.classList.toggle('is-active', isActive);
					dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
				});
			};

			const clearSwipeClasses = () => {
				root.classList.remove('is-swipe-next', 'is-swipe-prev');
				slides.forEach((slide) => {
					slide.classList.remove('is-swipe-from', 'is-swipe-to');
				});
			};

			const slideTo = (index, direction) => {
				if (slides.length <= 1) return;

				const fromIndex = activeIndex;
				const toIndex = (index + slides.length) % slides.length;
				if (fromIndex === toIndex) return;

				clearSwipeClasses();
				root.classList.add(direction === 'prev' ? 'is-swipe-prev' : 'is-swipe-next');
				slides[fromIndex].classList.add('is-swipe-from');
				slides[toIndex].classList.add('is-swipe-to');
				slides[toIndex].setAttribute('aria-hidden', 'false');
				activeIndex = toIndex;

				dots.forEach((dot, dotIndex) => {
					const isActive = dotIndex === activeIndex;
					dot.classList.toggle('is-active', isActive);
					dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
				});

				const desktopAspect = slides[toIndex].style.getPropertyValue('--camo-hero-aspect-desktop');
				const mobileAspect = slides[toIndex].style.getPropertyValue('--camo-hero-aspect-mobile');
				if (desktopAspect) root.style.setProperty('--camo-hero-aspect-desktop', desktopAspect);
				if (mobileAspect) root.style.setProperty('--camo-hero-aspect-mobile', mobileAspect);

				window.setTimeout(() => {
					clearSwipeClasses();
					setActive(toIndex);
				}, 430);
			};

			const stop = () => {
				if (timer) window.clearInterval(timer);
				timer = null;
			};

			const start = () => {
				stop();
				if (autoplay && slides.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
					timer = window.setInterval(() => setActive(activeIndex + 1), delay);
				}
			};

			const goTo = (index) => {
				setActive(index);
				start();
			};

			dots.forEach((dot) => {
				dot.addEventListener('click', () => goTo(Number(dot.dataset.slideIndex)));
			});

			root.addEventListener('pointerdown', (event) => {
				if (!event.isPrimary) return;
				pointerStart = event.clientX;
				pointerStartY = event.clientY;
				pointerCurrent = event.clientX;
				pointerCurrentY = event.clientY;
				preventClick = false;
				root.classList.add('is-dragging');
			});

			root.addEventListener('pointermove', (event) => {
				if (pointerStart === null || !event.isPrimary) return;
				pointerCurrent = event.clientX;
				pointerCurrentY = event.clientY;
				const distance = pointerCurrent - pointerStart;
				const verticalDistance = Math.abs(pointerCurrentY - pointerStartY);
				const horizontalDistance = Math.abs(distance);
				if (horizontalDistance > 10 && horizontalDistance > verticalDistance) {
					event.preventDefault();
				}
			});

			root.addEventListener('pointerup', (event) => {
				if (pointerStart === null) return;
				const distance = (pointerCurrent || event.clientX) - pointerStart;
				const verticalDistance = Math.abs((pointerCurrentY || event.clientY) - pointerStartY);
				const horizontalDistance = Math.abs(distance);
				pointerStart = null;
				pointerStartY = null;
				pointerCurrent = null;
				pointerCurrentY = null;
				root.classList.remove('is-dragging');

				if (horizontalDistance > 32 && horizontalDistance > verticalDistance) {
					preventClick = true;
					stop();
					if (distance < 0) {
						slideTo(activeIndex + 1, 'next');
					} else {
						slideTo(activeIndex - 1, 'prev');
					}
					start();
					window.setTimeout(() => {
						preventClick = false;
					}, 300);
				}
			});

			root.addEventListener('pointercancel', () => {
				pointerStart = null;
				pointerStartY = null;
				pointerCurrent = null;
				pointerCurrentY = null;
				root.classList.remove('is-dragging');
			});

			root.addEventListener('click', (event) => {
				if (event.target.closest('[data-camo-hero-dot], .camo-hero-slider__button')) return;

				if (preventClick) {
					event.preventDefault();
					event.stopPropagation();
					return;
				}

				const activeSlide = slides[activeIndex];
				const slideLink = activeSlide ? activeSlide.dataset.slideLink : '';
				if (!slideLink) return;

				event.preventDefault();
				window.location.href = slideLink;
			}, true);

			root.addEventListener('dragstart', (event) => {
				event.preventDefault();
			});

			document.addEventListener('shopify:block:select', (event) => {
				if (!root.contains(event.target)) return;
				const selectedSlide = event.target.closest(selectors.slide);
				if (!selectedSlide) return;
				stop();
				setActive(Number(selectedSlide.dataset.slideIndex));
			});

			root.dataset.camoHeroReady = 'true';
			setActive(activeIndex);
			start();
		};

		const initAllSliders = () => {
			document.querySelectorAll(selectors.root).forEach(initSlider);
		};

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initAllSliders);
		} else {
			initAllSliders();
		}

		window.addEventListener('load', initAllSliders);

		document.addEventListener('shopify:section:load', (event) => {
			const loadedRoot = event.target.querySelector(selectors.root);
			if (loadedRoot) initSlider(loadedRoot);
		});
	})();
{% endjavascript %}

