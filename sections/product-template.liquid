{%- comment -%}
------------------------------------------------------------------------------
  Section: Product template
------------------------------------------------------------------------------
{%- endcomment -%}

{%- render 'adastra' with '/src/styles/carousel.scss' -%}
{%- render 'adastra' with '/src/styles/product.scss' -%}

{% render 'customix' %}

{%- assign container 					   = section.settings.container_width -%}
{%- assign color_scheme      	           = section.settings.color_scheme -%}
{%- assign enable_color_scheme_inheritance = section.settings.enable_color_scheme_inheritance -%}
{%- assign blocks                          = section.blocks -%}
{%- assign breadcrumbs_block               = blocks | where: "type", "breadcrumbs" | first -%}
{%- assign is_spooky_product                = false -%}

{%- for product_collection in product.collections -%}
	{%- if product_collection.handle == 'spooky-kids-tee' or product_collection.handle == 'halloween-dog-t-shirt' -%}
		{%- assign is_spooky_product = true -%}
		{%- break -%}
	{%- endif -%}
{%- endfor -%}

{%- if enable_color_scheme_inheritance -%}
	{%- assign color_scheme = settings.main_color_scheme -%}
{%- endif -%}

{%- if container == 'inherit' %}
	{%- assign container_width = settings.container_width -%}
{%- else %}
	{%- assign container_width = container -%}
{%- endif -%}

{%- style -%}
	/* CHẶN ĐỨT ĐIỂM CHẠM CỦA JAVASCRIPT BẰNG BIẾN :ROOT !IMPORTANT */
	/* File Javascript của theme liên tục gán --header-height-sticky = 0 inline trên HTML khi cuộn.
	   Dùng :root !important sẽ đè chết giá trị inline này, ép nó luôn bằng với chiều cao cố định của header! */
	:root {
		--header-height-sticky: 130px !important; /* Giá trị tĩnh ép buộc, trùm qua mọi tính toán */
	}

	/* Ép thanh Header luôn ghim cứng ở phần Top, không bao giờ thụt lên / biến mất */
	.header-section,
	.header-section.is-collapsed {
		position: sticky !important;
		top: 0 !important;
	}

	/* Cố thủ cột Hình Ảnh Sản Phẩm, ghi đè trực tiếp mọi class */
	html body .product-media .product-media__grid-column.product-media__grid-column--sticky {
		top: 150px !important; /* 130px header + 20px lề */
	}

	#shopify-section-{{- section.id -}} {
		padding-top: {{- section.settings.offset_top_mobile -}}px;
		padding-bottom: {{- section.settings.offset_bottom_mobile -}}px;
	}

	/* KUIU-inspired mobile hierarchy: product identity sits above the gallery,
	   while price and the purchase controls remain below it. The existing nodes
	   are moved into this slot so there is still only one breadcrumb, H1 and
	   review widget in the page. */
	#shopify-section-{{ section.id }} .product__mobile-summary {
		display: none;
	}

	/* Hide the sold-count social proof on every viewport while keeping reviews. */
	#shopify-section-{{ section.id }} .product-sold-wrapper {
		display: none !important;
	}

	#shopify-section-{{ section.id }} .product-reviews-and-sold:has(.injected-review-container:empty) {
		display: none;
	}

	/* Reference-style review summary: preserve Judge.me colors, tighten the stars,
	   and make the separated review count read as a clear jump link. */
	#shopify-section-{{ section.id }} .injected-review-container .jdgm-prev-badge {
		column-gap: 12px !important;
	}

	#shopify-section-{{ section.id }} .injected-review-container .jdgm-prev-badge__stars {
		margin: 0 !important;
	}

	#shopify-section-{{ section.id }} .injected-review-container .jdgm-star {
		font-size: 16px !important;
	}

	#shopify-section-{{ section.id }} .injected-review-container .jdgm-prev-badge__text {
		margin: 0 !important;
		font-family: var(--base-font-family), Arial, Helvetica, sans-serif !important;
		font-size: 12px !important;
		font-weight: 400 !important;
		line-height: 1.2 !important;
		text-decoration-line: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		white-space: nowrap;
		cursor: pointer;
	}

	#shopify-section-{{ section.id }} .injected-review-container .jdgm-prev-badge[data-number-of-reviews="0"] .jdgm-prev-badge__text {
		display: none !important;
	}

	#shopify-section-{{ section.id }} .injected-review-container .jdgm-prev-badge__text:focus-visible {
		outline: 1px solid currentColor;
		outline-offset: 3px;
	}

	body.template-product #judgeme_product_reviews,
	body.template-product .jdgm-review-widget,
	body.template-product .jdgm-rev-widg {
		scroll-margin-top: 120px;
	}

	@media screen and (max-width: 767px) {
		#shopify-section-{{ section.id }} .product__mobile-summary {
			display: flex;
			flex-direction: column;
			align-self: center;
			gap: 0;
			width: 100%;
			max-width: 800px;
		}

		#shopify-section-{{ section.id }} .product__mobile-summary .product-breadcrumbs,
		#shopify-section-{{ section.id }} .product__mobile-summary .product-title-wrapper {
			width: 100%;
			margin: 0 !important;
			padding-top: 0 !important;
			padding-bottom: 0 !important;
		}

		#shopify-section-{{ section.id }} .product__mobile-summary .product-breadcrumbs {
			font-size: 10px;
			font-weight: 400;
			line-height: 1.4;
			letter-spacing: 0.01em;
			text-transform: none;
			margin-bottom: 14px !important;
		}

		#shopify-section-{{ section.id }} .product__mobile-summary .product-breadcrumbs__link {
			display: inline-block;
			text-transform: capitalize;
		}

		#shopify-section-{{ section.id }} .product__mobile-summary .product-breadcrumbs__separator {
			padding-left: 8px;
			padding-right: 8px;
			font-size: 10px;
			font-weight: 400;
			line-height: 1;
		}

		#shopify-section-{{ section.id }} .product__mobile-summary .product-title-and-fomo {
			gap: 0 !important;
		}

		#shopify-section-{{ section.id }} .product__mobile-summary .product-reviews-and-sold {
			margin-top: 8px !important;
			margin-bottom: 0 !important;
		}

		#shopify-section-{{ section.id }} .product__mobile-summary .product-reviews-and-sold:not(:has(.product-sold-wrapper)):has(.injected-review-container:empty) {
			display: none;
		}

		#shopify-section-{{ section.id }} .product__mobile-summary .product-sold-wrapper:has(+ .injected-review-container:empty) .product-sold-separator {
			display: none;
		}
	}

	@media screen and (min-width: 768px) {
		body.template-product #judgeme_product_reviews,
		body.template-product .jdgm-review-widget,
		body.template-product .jdgm-rev-widg {
			scroll-margin-top: 150px;
		}

		#shopify-section-{{ section.id }} .product-breadcrumbs {
			font-size: 10px;
			font-weight: 400;
			line-height: 1.4;
			letter-spacing: 0.01em;
			text-transform: none;
		}

		#shopify-section-{{ section.id }} .product-breadcrumbs__link {
			display: inline-block;
			text-transform: capitalize;
		}

		#shopify-section-{{ section.id }} .product-breadcrumbs__separator {
			padding-left: 8px;
			padding-right: 8px;
			font-size: 10px;
			font-weight: 400;
			line-height: 1;
		}
	}

	{%- if is_spooky_product -%}
		#shopify-section-{{ section.id }} .product.product--spooky {
			--spooky-text-orange: #a83f08;
			--spooky-accent-orange: #f2711c;
			--spooky-accent-orange-hover: #d65b14;
			--spooky-cream: #fff2d7;
			--color-text-primary: var(--spooky-text-orange);
			--color-text-secondary: var(--spooky-text-orange);
			--color-text-thirdly: var(--spooky-text-orange);
			--color-heading: var(--spooky-text-orange);
			--link-color: var(--spooky-text-orange);
		}

		#shopify-section-{{ section.id }} .product--spooky .product-title,
		#shopify-section-{{ section.id }} .product--spooky .product-sold-count,
		#shopify-section-{{ section.id }} .product--spooky .product-sold-separator,
		#shopify-section-{{ section.id }} .product--spooky .injected-review-container .jdgm-prev-badge__text,
		#shopify-section-{{ section.id }} .product--spooky .product-options__size-guide-inline,
		#shopify-section-{{ section.id }} .product--spooky .price:not(.price--on-sale) .price-item--regular {
			color: var(--spooky-text-orange) !important;
		}

		#shopify-section-{{ section.id }} .product--spooky .product-price .price-item--sale {
			color: var(--spooky-accent-orange) !important;
		}

		#shopify-section-{{ section.id }} .product--spooky .product-price.price--on-sale .price-item--regular {
			color: #b9470f !important;
		}

		#shopify-section-{{ section.id }} .product--spooky .product-options .radio-option-swatch .radio-input:checked + .radio-option-swatch__label {
			outline-color: var(--spooky-accent-orange) !important;
		}

		#shopify-section-{{ section.id }} .product--spooky .product-options .radio-option .radio-input:checked + .radio-option__label {
			border-color: var(--spooky-accent-orange) !important;
			background-color: var(--spooky-accent-orange) !important;
			color: var(--spooky-cream) !important;
		}

		#shopify-section-{{ section.id }} .product--spooky .product-add-to-cart > .add-to-cart,
		#shopify-section-{{ section.id }} .product--spooky .mobile-sticky-atc__btn {
			border-color: var(--spooky-accent-orange) !important;
			background-color: var(--spooky-accent-orange) !important;
			color: var(--spooky-cream) !important;
		}

		#shopify-section-{{ section.id }} .product--spooky .product-add-to-cart > .add-to-cart:not(:disabled):hover,
		#shopify-section-{{ section.id }} .product--spooky .product-add-to-cart > .add-to-cart:not(:disabled):focus-visible,
		#shopify-section-{{ section.id }} .product--spooky .mobile-sticky-atc__btn:not(:disabled):hover,
		#shopify-section-{{ section.id }} .product--spooky .mobile-sticky-atc__btn:not(:disabled):focus-visible {
			border-color: var(--spooky-accent-orange-hover) !important;
			background-color: var(--spooky-accent-orange-hover) !important;
		}

		#shopify-section-{{ section.id }} .product--spooky .product-upsell-block.is-selected {
			border-color: var(--spooky-accent-orange) !important;
		}

		#shopify-section-{{ section.id }} .product--spooky .product-upsell__checkbox {
			border-color: var(--spooky-accent-orange) !important;
		}

		#shopify-section-{{ section.id }} .product--spooky .product-upsell-block.is-selected .product-upsell__checkbox {
			background-color: var(--spooky-accent-orange) !important;
		}

		#shopify-section-{{ section.id }} .product--spooky .product-upsell__title,
		#shopify-section-{{ section.id }} .product--spooky .product-upsell__price {
			color: var(--spooky-text-orange) !important;
		}

		#shopify-section-{{ section.id }} .product--spooky .product-accordion__trigger:hover,
		#shopify-section-{{ section.id }} .product--spooky .product-accordion__trigger:hover .product-accordion__trigger-icon {
			color: var(--spooky-accent-orange) !important;
		}

		#shopify-section-{{ section.id }} .product--spooky form.product-form > lb-upsell-widget.lb-widget {
			color: var(--spooky-text-orange) !important;
		}

		#shopify-section-{{ section.id }} .product--spooky form.product-form > lb-upsell-widget.lb-widget lb-pitch,
		#shopify-section-{{ section.id }} .product--spooky form.product-form > lb-upsell-widget.lb-widget .lb-pitch,
		#shopify-section-{{ section.id }} .product--spooky form.product-form > lb-upsell-widget.lb-widget .lb-card-title,
		#shopify-section-{{ section.id }} .product--spooky form.product-form > lb-upsell-widget.lb-widget .lb-variant-picker {
			color: var(--spooky-text-orange) !important;
		}

		#shopify-section-{{ section.id }} .product--spooky form.product-form > lb-upsell-widget.lb-widget lb-button,
		#shopify-section-{{ section.id }} .product--spooky form.product-form > lb-upsell-widget.lb-widget .lb-button {
			border-color: var(--spooky-accent-orange) !important;
			background-color: var(--spooky-accent-orange) !important;
			color: var(--spooky-cream) !important;
		}

		#shopify-section-{{ section.id }} .product--spooky form.product-form > lb-upsell-widget.lb-widget lb-button *,
		#shopify-section-{{ section.id }} .product--spooky form.product-form > lb-upsell-widget.lb-widget .lb-button * {
			color: inherit !important;
		}

		html body.template-product .featured-products.product-recommendations .featured-products__header.product-recommendations__header h2 {
			color: var(--spooky-text-orange, #a83f08) !important;
		}
	{%- endif -%}

	@media screen and (min-width: 768px) {
		#shopify-section-{{- section.id -}} {
			padding-top: {{- section.settings.offset_top_desktop -}}px;
			padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
		}
		
		/* Thu hẹp riêng khung hiển thị của trang sản phẩm xuống 1600px */
		.product .product__container {
			max-width: 1600px !important;
			margin-left: auto;
			margin-right: auto;
			width: 100%;
		}
		
		/* Giới hạn chiều cao hiển thị ảnh sản phẩm trên Desktop để vừa màn hình
		   Chú ý: KHÔNG áp dụng vào zoom modal (dùng .product-media để scope) */
		#shopify-section-{{- section.id -}} .product-media .product-media__aspect-ratio {
			padding-top: 0 !important;
			height: 60vh !important;
			max-height: 600px;
			min-height: 300px;
		}
		#shopify-section-{{- section.id -}} .product-media .product-media__aspect-ratio .product-media__image,
		#shopify-section-{{- section.id -}} .product-media .product-media__aspect-ratio img {
			object-fit: contain !important;
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
		}
	}

	@media screen and (min-width: 992px) {
		/* Ép buộc phần Product Media và Product Form chia đúng 50-50 không gian */
		.product .product__container {
			flex-direction: row !important;
			align-items: flex-start !important;
		}
		.product .product-media {
			flex: 0 0 calc(50% - 32px) !important;
			max-width: calc(50% - 32px) !important;
			width: calc(50% - 32px) !important;
			padding-right: 0 !important;
		}
		.product .shopify-product-form,
		.product .product-form {
			flex: 0 0 calc(50% - 32px) !important;
			max-width: calc(50% - 32px) !important;
			width: calc(50% - 32px) !important;
			padding-left: 0 !important;
		}

		/* Hiển thị thumbnails bên trái cho Carousel */
		/* LƯU Ý: KHÔNG dùng position: sticky ở đây vì sẽ tạo stacking context
		   làm hỏng modal zoom (fixed elements bên trong sẽ không thoát ra được) */
		.product-media.product-media--layout-carousel.product-media--thumbnails-position-left {
			column-gap: 16px;
			display: flex !important;
			flex-direction: row-reverse !important;
			align-items: stretch; /* Kéo dài thumbnail container theo chiều cao ảnh main */
			position: sticky !important;
			top: var(--header-height-sticky, 20px) !important;
		}
		.product-media.product-media--layout-carousel.product-media--thumbnails-position-left .product-media__grid {
			flex: 1;
			min-width: 0; /* Cho phép co giãn đúng kích thước thay vì overflow */
		}
		.product-media.product-media--layout-carousel.product-media--thumbnails-position-left .product-media__swiper-button-prev,
		.product-media.product-media--layout-carousel.product-media--thumbnails-position-left .product-media__swiper-button-next {
			display: none !important;
		}
		.product-media.product-media--layout-carousel.product-media--thumbnails-position-left .product-media__slider-thumbnails-container {
			width: 80px;
			height: 100%; /* Stretch theo chiều cao flex parent */
			display: flex !important;
			flex-direction: column;
		}
		.product-media.product-media--layout-carousel.product-media--thumbnails-position-left .product-media__slider-thumbnails {
			flex: 1; /* Chiếm toàn bộ chiều cao container */
			height: 100%;
			margin-top: 0;
			padding-top: 0;
			padding-bottom: 0;
			overflow: hidden;
		}
		.product-media.product-media--layout-carousel.product-media--thumbnails-position-left .product-media__slider-thumbnails::-webkit-scrollbar,
		.product-media.product-media--layout-carousel.product-media--thumbnails-position-left .product-media__slider-thumbnails-container::-webkit-scrollbar {
			display: none;
		}
		.product-media.product-media--layout-carousel.product-media--thumbnails-position-left .product-media__slider-thumbnails-slide {
			display: block;
			width: 64px;
			height: auto !important;
			margin-left: auto;
			margin-right: auto;
			margin-bottom: 0;
			aspect-ratio: var(--thumbnail-aspect-ratio, 1);
			overflow: hidden;
			border-radius: 6px;
			box-sizing: border-box;
			background: #fff;
		}
		.product-media.product-media--layout-carousel.product-media--thumbnails-position-left .product-media__slider-thumbnails-slide picture {
			display: block !important;
			width: 100% !important;
			height: 100% !important;
		}
		.product-media.product-media--layout-carousel.product-media--thumbnails-position-left .product-media__slider-thumbnails-slide picture > .product-media__image,
		.product-media.product-media--layout-carousel.product-media--thumbnails-position-left .product-media__slider-thumbnails-slide img {
			display: block !important;
			width: 100% !important;
			height: 100% !important;
			aspect-ratio: auto !important;
			object-fit: contain !important;
			object-position: center !important;
			box-sizing: border-box !important;
			background: #fff !important;
		}
		.product-media.product-media--layout-carousel.product-media--thumbnails-position-left .product-media__slider-thumbnails-slide img {
			border: 1px solid var(--color-border-secondary, #e2e2e2) !important;
			border-radius: 6px !important;
		}
		.product-media.product-media--layout-carousel.product-media--thumbnails-position-left .product-media__slider-thumbnails-slide.swiper-slide-thumb-active img,
		.product-media.product-media--layout-carousel.product-media--thumbnails-position-left .product-media__slider-thumbnails-slide.is-active img {
			border: 2px solid #1b4332 !important; /* Xanh đậm */
		}

		/* Nút điều hướng lên/xuống cho thumbnails dọc - kiểu tròn */
		.product-media__slider-thumbnails-container .thumb-nav {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 36px;
			height: 36px;
			background: #ffffff;
			border: none;
			border-radius: 50%;
			cursor: pointer;
			color: #333;
			box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
			transition: box-shadow 0.2s ease, transform 0.15s ease, background 0.2s ease;
			flex-shrink: 0;
			padding: 0;
			margin: 4px auto;
			align-self: center;
		}
		.product-media__slider-thumbnails-container .thumb-nav svg {
			width: 18px;
			height: 18px;
			stroke-width: 2.5;
		}
		.product-media__slider-thumbnails-container .thumb-nav:hover {
			box-shadow: 0 4px 16px rgba(0, 0, 0, 0.22);
			transform: scale(1.08);
			background: #f8f8f8;
		}
		.product-media__slider-thumbnails-container .thumb-nav:active {
			transform: scale(0.95);
		}
		.product-media__slider-thumbnails-container .thumb-nav.swiper-button-disabled {
			opacity: 0.3;
			cursor: not-allowed;
			pointer-events: none;
		}
		.product-media__slider-thumbnails-container .thumb-nav.is-hidden {
			display: none;
		}

		/* Zoom modal phải luôn ở trên cùng */
		[data-zoom-modal] {
			z-index: 9999 !important;
		}
	}

	/* Zoom modal z-index fix - outside media query to apply everywhere */
	[data-zoom-modal] {
		z-index: 9999 !important;
	}

	@media screen and (min-width: 768px) {
		#shopify-section-{{- section.id -}} .product-short-description {
			display: none !important;
		}
	}

	{% if breadcrumbs_block != blank -%}
		.breadcrumb {
			display: none;
		}
	{% endif %}
{%- endstyle -%}

{%- capture section_styles -%}
	--color-button-bg: {{- color_scheme.settings.color_text_primary | color_modify: 'alpha', 0.2 | default: '#000000' -}};
	--image-object-fit: {{- section.settings.image_object_fit -}}; {{-  -}}
	--container-width: {{- container_width -}}; {{-  -}}
	--inner-offset-top: {{ section.settings.inner_offset_top }}px; {{-  -}}
	--inner-offset-bottom: {{ section.settings.inner_offset_bottom }}px; {{-  -}}
	--inner-offset-top-mobile: {{ section.settings.inner_offset_top_mobile }}px; {{-  -}}
	--inner-offset-bottom-mobile: {{ section.settings.inner_offset_bottom_mobile }}px; {{-  -}}
{%- endcapture -%}

<section
	class="product color-{{ color_scheme }}{% if is_spooky_product %} product--spooky{% endif %}"
	style="{{ section_styles }}"
	data-section-type="product"
	data-section-id="{{- section.id -}}"
	data-product-handle="{{- product.handle -}}"
	data-url="{{- product.url -}}"
>
	{%- if is_spooky_product -%}
		<div class="product__spooky-corner" aria-hidden="true"></div>
	{%- endif -%}

	<div class="product__container container">
		<div class="product__mobile-summary" data-mobile-product-summary></div>
		{%- include 'product-media', media_height: section.settings.media_height, enable_video_play_on_autoplay: section.settings.enable_video_play_on_autoplay -%}
		{%- include 'product-form', blocks: blocks, enable_history_state: true, product_template: true -%}
		{%- render 'product-drawers-content', product: product, section: section, blocks: blocks -%}
	</div>

	{%- if description_overlay_html != blank -%}
