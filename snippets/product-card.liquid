	{% javascript %}
		if (!window.productCardReferenceListener) {
			window.productCardReferenceListener = true;
			document.addEventListener('click', function (event) {
				var toggle = event.target.closest('.js-product-card-swatches-toggle');
				if (toggle) {
					var swatches = toggle.closest('.js-product-card-swatches');
					if (swatches) {
						swatches.classList.add('is-expanded');
						toggle.setAttribute('aria-expanded', 'true');
					}
					return;
				}

				var swatch = event.target.closest('.js-product-card-swatch');
				if (!swatch) return;
				var card = swatch.closest('.js-product-card');
				var label = card && card.querySelector('.js-product-card-color-label');
				if (label) {
					var color = (swatch.dataset.swatch || '').toLowerCase();
					label.textContent = color.replace(/\b\w/g, function (letter) { return letter.toUpperCase(); });
				}
			});
		}
	{% endjavascript %}
