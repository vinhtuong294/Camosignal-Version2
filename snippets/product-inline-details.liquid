{% doc %}
  Renders product information as a native inline accordion.
  @param {string} title - The summary label.
  @param {string} content - The information HTML.
  @param {string} kind - The information type.
  @param {string} [summary_detail] - Optional delivery estimate.
{% enddoc %}

{%- if content != blank -%}
  <details class="product-accordion__item product-inline-details" data-product-inline-details="{{ kind | escape }}">
    <summary class="product-accordion__trigger">
      <span class="product-accordion__trigger-text">
        <span>{{ title | escape_once }}</span>
        {%- if summary_detail != blank -%}
          <span class="product-accordion__delivery-total">{{ summary_detail }}</span>
        {%- endif -%}
      </span>
      <span class="product-accordion__trigger-icon" aria-hidden="true"></span>
    </summary>
    <div class="product-inline-details__content rte">{{ content }}</div>
  </details>
{%- endif -%}

{% stylesheet %}
  .product-inline-details > summary {
    box-sizing: border-box;
    min-height: 58px;
    list-style: none;
  }
  .product-inline-details > summary::-webkit-details-marker { display: none; }
  .product-inline-details[open] > summary .product-accordion__trigger-icon::after {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(90deg) scaleX(0);
  }
  .product-inline-details > .product-inline-details__content.rte {
    min-width: 0;
    padding: 8px 16px 24px;
    overflow-x: auto;
    color: var(--color-text-primary, #2c3d33);
    font-family: var(--base-font-family);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.65;
    letter-spacing: normal;
    overflow-wrap: anywhere;
  }
  .product-inline-details > .product-inline-details__content.rte p {
    margin: 0 0 18px;
    font-size: inherit;
    line-height: inherit;
  }
  .product-inline-details > .product-inline-details__content.rte > :last-child { margin-bottom: 0; }
  .product-inline-details__content strong { font-weight: 700; }
  .product-inline-details__content :is(h2, h3, h4) {
    margin: 20px 0 12px;
    font-family: var(--heading-font-family);
    font-size: 18px;
    line-height: 1.4;
  }
  .product-inline-details__content > :first-child { margin-top: 0; }
  .product-inline-details__content :is(ul, ol) { padding-inline-start: 22px; }
  .product-inline-details__content img { max-width: 100%; height: auto; }
  .product-inline-details__nested-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 42px;
    padding: 0 2px;
    color: inherit;
    cursor: pointer;
    font-family: var(--heading-font-family);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
    list-style: none;
  }
  .product-inline-details__nested-trigger::-webkit-details-marker { display: none; }
  .product-inline-details__nested-icon {
    position: relative;
    flex: 0 0 16px;
    width: 16px;
    height: 16px;
  }
  .product-inline-details__nested-icon::before,
  .product-inline-details__nested-icon::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 1.5px;
    background: currentColor;
    content: '';
    transform: translate(-50%, -50%);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .product-inline-details__nested-icon::after { transform: translate(-50%, -50%) rotate(90deg); }
  .product-inline-details__nested[open] .product-inline-details__nested-icon::after {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(90deg) scaleX(0);
  }
  .product-inline-details__nested-content {
    padding: 0 2px 18px;
  }
  .product-inline-details__nested-content p {
    margin: 0 0 12px;
    font-size: inherit;
    line-height: inherit;
  }
  .product-inline-details__nested-content > :last-child { margin-bottom: 0; }
  .product-inline-details__content.rte:has(.product-inline-details__nested) {
    padding-top: 0;
    padding-bottom: 16px;
  }
  @media (max-width: 767.98px) {
    .product-inline-details > summary { min-height: 54px; }
    .product-inline-details__nested-trigger { min-height: 42px; }
  }
{% endstylesheet %}
