				window.requestAnimationFrame(function () {
					currentSlides.forEach(function (slide) {
						slide.classList.add(exitingClass);
					});
					incomingSlides.forEach(function (slide) {
						slide.classList.add('is-mobile-active');
						slide.classList.remove(enteringClass);
					});
					activeIndex = nextIndex;
					updateNavigation();

					animationTimer = window.setTimeout(function () {
						currentSlides.forEach(function (slide) {
							slide.classList.remove('is-mobile-active', exitingClass);
							slide.setAttribute('aria-hidden', 'true');
						});
						incomingSlides.forEach(function (slide) {
							slide.classList.remove.apply(slide.classList, motionClasses);
						});
