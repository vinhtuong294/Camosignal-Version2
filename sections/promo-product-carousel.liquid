			var slider = section.querySelector('.promo-product-carousel__slider');
			var track = section.querySelector('.promo-product-carousel__track');
			var previousButton = section.querySelector('.promo-product-carousel__control--prev');
			var nextButton = section.querySelector('.promo-product-carousel__control--next');
			var paginationTrack = section.querySelector('.promo-product-carousel__pagination-track');
			var mobilePages = [];
			var firstProduct = promoSlide ? productSlides.shift() : null;

