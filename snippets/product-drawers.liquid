{%- assign size_chart_mode = 'tshirt' -%}
{%- assign is_3d_tshirt = false -%}
{%- assign hoodie_size_guide_asset = 'hoodie-size-guide.webp' -%}
{%- assign hoodie_size_guide_alt = 'Pullover hoodie measurement guide showing chest width, length, and sleeve length' -%}
{%- if product_type_handle == '3d-tshirt' -%}
	{%- assign is_3d_tshirt = true -%}
{%- endif -%}
{%- if size_chart_product_type contains 'sweatshirt' or size_chart_product_type contains 'sweater' -%}
	{%- assign hoodie_size_guide_asset = 'sweatshirt-size-guide.webp' -%}
	{%- assign hoodie_size_guide_alt = 'Crew-neck sweatshirt measurement guide showing chest width, length, and sleeve length' -%}
{%- endif -%}

{%- if size_chart_product_type == 'upf hoodie' -%}
	{%- assign size_chart_mode = 'upf-hoodie' -%}
{%- elsif size_chart_product_type == 'shirt' -%}
	{%- assign size_chart_mode = 'shirt' -%}
{%- elsif is_3d_tshirt -%}
	{%- assign size_chart_mode = '3d-tshirt' -%}
{%- elsif size_chart_product_type == 'beanie hat' or size_chart_product_type == 'beanie' -%}
	{%- assign size_chart_mode = 'beanie' -%}
{%- elsif size_chart_product_type contains 'hat' or size_chart_product_type contains 'cap' -%}
	{%- assign size_chart_mode = 'hat' -%}
{%- elsif size_chart_product_type contains 'long' and size_chart_product_type contains 'sleeve' -%}
	{%- assign size_chart_mode = 'longsleeve' -%}
{%- elsif size_chart_product_type contains 'hoodie' or size_chart_product_type contains 'sweatshirt' -%}
	{%- assign size_chart_mode = 'hoodie' -%}
{%- elsif size_chart_product_type == 'type1' or size_chart_product_type contains 't-shirt' or size_chart_product_type contains 'tshirt' -%}
	{%- assign size_chart_mode = 'tshirt' -%}
{%- endif -%}

{%- if section.settings.show_size_guide
	and size_guide_page != blank
	and size_guide_page.content != blank
	and size_guide_button_placement == 'drawer'
-%}
	{%- assign show_size_guide = true -%}
{%- endif -%}

{%- assign has_any_accordion = false -%}
{%- assign show_care_instructions = true -%}
{%- if show_description or show_care_instructions or show_drawer_1 or show_drawer_2 or show_drawer_3 or show_size_guide -%}
	{%- assign has_any_accordion = true -%}
{%- endif -%}

{%- comment -%} Always show Description accordion using generated product details even if drawer description is off {%- endcomment -%}
{%- if has_any_accordion or product_details_content != blank -%}
	{%- capture styles -%}
		--offset-top-desktop: {{ block.settings.offset_top_desktop }}px; {{-  -}}
		--offset-bottom-desktop: {{ block.settings.offset_bottom_desktop }}px; {{-  -}}
		--offset-top-mobile: {{ block.settings.offset_top_mobile }}px; {{-  -}}
		--offset-bottom-mobile: {{ block.settings.offset_bottom_mobile }}px;
	{%- endcapture -%}

	<style>
		/* ============================================
		   Product Accordion Styles
		   ============================================ */
		.product-accordion {
			padding-top: var(--offset-top-mobile);
			padding-bottom: var(--offset-bottom-mobile);
			width: 100%;
		}
		@media (min-width: 1200px) {
			.product-accordion {
				padding-top: var(--offset-top-desktop);
				padding-bottom: var(--offset-bottom-desktop);
			}
		}
		.product-accordion__item {
			border-top: 1px solid var(--color-border-thirdly, #e5e5e5);
			transition: border-color var(--timing-short, 0.2s) ease;
		}
		.product-accordion__item:last-child {
			border-bottom: 1px solid var(--color-border-thirdly, #e5e5e5);
		}
		.product-accordion__trigger {
			display: flex;
			align-items: center;
			justify-content: space-between;
			width: 100%;
			gap: 18px;
			padding: 16px 0;
			background: none;
			border: none;
			cursor: pointer;
			color: var(--color-text-primary, #000);
			font-size: calc(var(--body-font-size, 14px) * 0.875);
			font-weight: 600;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			text-align: left;
			line-height: 1.4;
			transition: color var(--timing-short, 0.2s), opacity var(--timing-short, 0.2s);
			font-family: var(--heading-font-family) !important;
		}
		.product-accordion__trigger-text,
		.product-accordion__trigger > span:first-child {
			min-width: 0;
		}
		.product-accordion__trigger-text {
			display: flex;
			flex: 1 1 auto;
			align-items: center;
			justify-content: space-between;
			gap: 12px;
		}
		.product-accordion__trigger-text > span:first-child {
			white-space: nowrap;
		}
		.product-accordion__delivery-total {
			color: #555555;
			font-family: var(--font-body-family), Arial, Helvetica, sans-serif;
			font-size: 12px;
			font-weight: 400;
			letter-spacing: 0;
			line-height: 1.3;
			text-align: right;
			text-transform: none;
			white-space: nowrap;
		}
		.product-accordion__trigger:hover {
			color: #31513f;
			opacity: 1;
		}
		.product-accordion__trigger:focus-visible {
			outline: 2px solid var(--color-text-primary, #000);
			outline-offset: 2px;
		}
		.product-accordion__trigger-icon {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			position: relative;
			width: 26px;
			height: 26px;
			flex-shrink: 0;
			border: 0;
			border-radius: 0;
			background: transparent;
			color: var(--color-text-primary, #203224);
			transition: color var(--timing-short, 0.2s);
		}
		.product-accordion__trigger-icon svg {
			display: none;
		}
		.product-accordion__trigger-icon::before,
		.product-accordion__trigger-icon::after {
			content: '';
			position: absolute;
			left: 50%;
			top: 50%;
			width: 10px;
			height: 1.5px;
			border-radius: 999px;
			background: currentColor;
			transform: translate(-50%, -50%);
			transition: opacity var(--timing-short, 0.2s), transform var(--timing-short, 0.2s);
		}
		.product-accordion__trigger-icon::after {
			transform: translate(-50%, -50%) rotate(90deg);
		}
		.product-accordion__trigger:hover .product-accordion__trigger-icon {
			background: transparent;
		}
		.product-accordion__trigger[aria-expanded="true"] .product-accordion__trigger-icon {
			background: transparent;
			color: var(--color-text-primary, #203224);
		}
		.product-accordion__trigger[aria-expanded="true"] .product-accordion__trigger-icon::after {
			opacity: 0;
			transform: translate(-50%, -50%) rotate(90deg) scaleX(0);
		}
		.product-accordion__content {
			overflow: hidden;
			max-height: 0;
			opacity: 0;
			transition: max-height var(--timing-base, 0.4s) ease, opacity var(--timing-short, 0.2s) ease, padding var(--timing-short, 0.2s) ease;
			padding: 0 18px;
		}
		.product-accordion__content.is-open {
			max-height: 2000px;
			opacity: 1;
			padding-bottom: 18px;
		}
		.product-accordion__content[hidden] {
			display: block !important;
			max-height: 0;
			opacity: 0;
			padding: 0;
			overflow: hidden;
		}
		.product-accordion__content-inner {
			font-size: calc(var(--body-font-size, 14px) * 0.875);
			line-height: 1.7;
			color: var(--color-text-secondary, #666);
			font-family: 'Oswald', sans-serif !important;
			padding: 18px 20px;
			border: 1px solid rgba(32, 50, 36, 0.1);
			border-radius: 6px;
			background: #fbfaf6;
			box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.85);
		}
		.product-accordion__content-inner p {
			margin: 0;
			padding: 11px 0;
			border-top: 1px solid rgba(32, 50, 36, 0.1);
		}
		.product-accordion__content-inner p:first-child {
			padding-top: 0;
			border-top: 0;
		}
		.product-accordion__content-inner p:last-child {
			padding-bottom: 0;
		}
		.product-accordion__content-inner strong {
			color: var(--color-text-primary, #203224);
			font-weight: 700;
		}
		.product-accordion__table-wrapper {
			width: 100%;
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
			margin: 16px auto;
		}
		.product-accordion__table {
			width: 100% !important;
			max-width: 600px !important;
			margin: 0 auto !important;
			border-collapse: collapse;
			text-align: center;
			font-size: 14px;
		}
		.product-accordion__table th,
		.product-accordion__table td {
			padding: 14px 16px;
			border: 1px solid var(--color-border-thirdly, #e5e5e5);
			white-space: nowrap !important;
			text-align: center !important;
			color: var(--color-text-primary, #203224) !important;
		}
		.product-accordion__table th {
			background-color: var(--color-text-primary, #203224) !important;
			color: #faf6ee !important;
			font-weight: 600 !important;
			text-transform: uppercase !important;
		}
		.product-accordion__content-inner img {
			max-width: 100%;
			height: auto;
		}

		/* Mobile optimizations */
		@media (max-width: 767.98px) {
			.product-accordion__trigger {
				gap: 10px;
				padding: 14px 0;
				font-size: calc(var(--body-font-size, 14px) * 0.85);
			}
			.product-accordion__trigger-text {
				gap: 8px;
			}
			.product-accordion__delivery-total {
				font-size: 11px;
			}
			.product-accordion__content-inner {
				font-size: calc(var(--body-font-size, 14px) * 0.9);
			}
			.product-accordion__table th,
			.product-accordion__table td {
				padding: 12px 10px;
				font-size: 14px; /* Fix "too small text" */
			}
		}

		/* Keep typography compact only in the product-page "People also bought" widget. */
		form.product-form > lb-upsell-widget.lb-widget .lb-card-title,
		form.product-form > lb-upsell-widget.lb-widget .lb-variant-picker,
		form.product-form > lb-upsell-widget.lb-widget .lb-button,
		form.product-form > lb-upsell-widget.lb-widget .lb-price-sale-price,
		form.product-form > lb-upsell-widget.lb-widget .lb-price-discount,
		form.product-form > lb-upsell-widget.lb-widget .lb-price-compare-price {
			font-family: 'Oswald', sans-serif !important;
			letter-spacing: 0 !important;
		}

		form.product-form > lb-upsell-widget.lb-widget .lb-card-title {
			font-size: 14px !important;
			line-height: 1.25 !important;
		}

		form.product-form > lb-upsell-widget.lb-widget .lb-variant-picker {
			font-size: 13px !important;
			line-height: 1.2 !important;
		}

		form.product-form > lb-upsell-widget.lb-widget .lb-button,
		form.product-form > lb-upsell-widget.lb-widget .lb-price-sale-price {
			font-size: 14px !important;
			line-height: 1.25 !important;
		}

		form.product-form > lb-upsell-widget.lb-widget .lb-price-discount {
			font-size: 10px !important;
		}

		form.product-form > lb-upsell-widget.lb-widget .lb-price-compare-price {
			font-size: 12px !important;
		}

		@media (max-width: 767.98px) {
			/* Give each product suggestion a little more breathing room. */
			form.product-form > lb-upsell-widget.lb-widget lb-upsell-flat-card + lb-upsell-flat-card,
			form.product-form > lb-upsell-widget.lb-widget .lb-product-card + .lb-product-card,
			form.product-form > lb-upsell-widget.lb-widget .lb-flat-card-host + .lb-flat-card-host {
				margin-top: 13px !important;
			}
		}
	</style>

	<div class="product-accordion" style="{{ styles }}" data-product-accordion>
		{%- assign details_title = 'product_drawer.details' | t -%}
		{%- assign shipping_title = 'product_drawer.shipping' | t -%}
		{%- assign care_title = 'product_drawer.care' | t -%}
		{%- capture shipping_summary -%}
			{%- if product_details_show_delivery_total -%}12&ndash;16 days{%- else -%}6&ndash;10 days{%- endif -%}
		{%- endcapture -%}
		{%- capture inline_shipping_content -%}
{%- if product_details_show_delivery_total -%}
							<p><strong>Production Time:</strong> 3 &ndash; 7 days.</p>
							<p><strong>Shipping Time:</strong> 5 &ndash; 9 days.</p>
						{%- elsif product_details_profile == 'shirt' -%}
							<p><strong>Production Time:</strong> 5 &ndash; 9 days.</p>
							<p><strong>Shipping Time:</strong> 8 &ndash; 15 days.</p>
						{%- else -%}
							<p><strong>Shipping Origin:</strong> Shipped directly from the United States.</p>
							<p><strong>Processing Time:</strong> 1 &ndash; 3 business days (excluding weekends and holidays).</p>
							<p><strong>Standard Shipping:</strong> 5 &ndash; 7 business days.</p>
						{%- endif -%}
						<p><strong>Tracking:</strong> You will receive a confirmation email with tracking information as soon as your order ships.</p>
						<p><strong>Multiple Packages:</strong> Items with separate locations may arrive in multiple packages with individual tracking numbers.</p>

						<p><strong>Order Cancellations:</strong><br>
						Only accepted if the order has not been processed (not yet packed or handed over to the carrier) and requires official approval from the seller.</p>
						{%- if product_details_profile == 'upf-hoodie' -%}
							<p><strong>Origin:</strong> Eco-friendly &amp; Made to Order &mdash; crafted fresh after every purchase for peak print quality.</p>
						{%- endif -%}
		{%- endcapture -%}
		{%- capture inline_care_content -%}
<p><strong>Washing Instructions:</strong><br>
						Turn inside out.<br>
						Hand wash cold (preferred) or machine wash cold on a gentle cycle.<br>
						Use mild detergent. Do not bleach.<br>
						Wash dark and light colors separately.</p>

						<p><strong>Drying Instructions:</strong><br>
						Hang to air dry in shade (avoid direct sunlight).<br>
						Tumble dry on low heat or a delicate cycle.</p>

						<p><strong>Ironing Instructions:</strong><br>
						Iron inside out on low heat.<br>
						Never iron directly on the print (use a pressing cloth).</p>
		{%- endcapture -%}
		{%- render 'product-inline-details', title: details_title, content: product_details_content, kind: 'details' -%}
		{%- render 'product-inline-details', title: shipping_title, content: inline_shipping_content, kind: 'shipping', summary_detail: shipping_summary -%}
		{%- render 'product-inline-details', title: care_title, content: inline_care_content, kind: 'care' -%}

		{%- comment -%} SIZE CHART OVERLAY {%- endcomment -%}
		<div id="size-chart-overlay" class="size-chart-overlay">
			<div class="size-chart-overlay__backdrop" onclick="document.getElementById('size-chart-overlay').classList.remove('is-active'); document.body.style.overflow='';"></div>
			<div class="size-chart-overlay__panel{% if size_chart_mode == 'shirt' %} size-chart-overlay__panel--shirt{% elsif is_3d_tshirt %} size-chart-overlay__panel--3d-tshirt{% elsif size_chart_mode == 'upf-hoodie' %} size-chart-overlay__panel--upf-hoodie{% endif %}">
				<div class="size-chart-overlay__header">
					<h2 class="size-chart-overlay__title">{{- size_guide_button_text -}}</h2>
					<button
						class="size-chart-overlay__close"
						type="button"
						onclick="document.getElementById('size-chart-overlay').classList.remove('is-active'); document.body.style.overflow='';"
						aria-label="{{ 'general.accessibility.close' | t }}"
					>
						<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
							<line x1="2" y1="2" x2="18" y2="18" stroke="currentColor" stroke-width="2"/>
							<line x1="18" y1="2" x2="2" y2="18" stroke="currentColor" stroke-width="2"/>
						</svg>
					</button>
				</div>
				{%- if size_chart_mode == 'shirt' -%}
					<div class="size-chart-overlay__content size-chart-overlay__content--shirt">
						<div class="size-chart-overlay__unit-tabs" role="tablist" aria-label="Shirt measurement unit">
							<button class="size-chart-overlay__unit-tab is-active" type="button" onclick="switchSizeUnit(this, 'in')">In</button>
							<button class="size-chart-overlay__unit-tab" type="button" onclick="switchSizeUnit(this, 'cm')">Cm</button>
						</div>

						<div class="size-chart-overlay__unit-panel is-active" data-unit-panel="in">
						<h3 class="size-chart-overlay__subtitle">New Classic Fit Aloha Shirts Size Chart</h3>
						<p class="size-chart-overlay__note">Measurements are in <strong>inches</strong>.</p>
						<div class="size-chart-overlay__table-wrap">
							<table class="size-chart-overlay__table size-chart-overlay__table--shirt">
								<thead>
									<tr>
										<th scope="col">Size</th>
										<th scope="col">Neck</th>
										<th scope="col">Chest</th>
										<th scope="col">Waist</th>
										<th scope="col">Shoulder</th>
										<th scope="col">Length</th>
									</tr>
								</thead>
								<tbody>
									<tr><td>S</td><td>16.7"</td><td>46.1"</td><td>43.3"</td><td>20.1"</td><td>29.5"</td></tr>
									<tr><td>M</td><td>17.1"</td><td>48.0"</td><td>46.5"</td><td>20.5"</td><td>30.3"</td></tr>
									<tr><td>L</td><td>17.5"</td><td>50.4"</td><td>49.6"</td><td>21.1"</td><td>31.5"</td></tr>
									<tr><td>XL</td><td>17.9"</td><td>53.1"</td><td>52.0"</td><td>21.7"</td><td>32.7"</td></tr>
									<tr><td>2XL</td><td>18.3"</td><td>56.3"</td><td>54.7"</td><td>22.0"</td><td>33.9"</td></tr>
									<tr><td>3XL</td><td>18.7"</td><td>59.1"</td><td>57.5"</td><td>22.4"</td><td>35.0"</td></tr>
									<tr><td>4XL</td><td>19.7"</td><td>63.0"</td><td>60.2"</td><td>22.8"</td><td>35.8"</td></tr>
									<tr><td>5XL</td><td>20.1"</td><td>66.1"</td><td>63.0"</td><td>23.4"</td><td>36.6"</td></tr>
								</tbody>
							</table>
						</div>
						</div>

						<div class="size-chart-overlay__unit-panel" data-unit-panel="cm">
							<h3 class="size-chart-overlay__subtitle">New Classic Fit Aloha Shirts Size Chart</h3>
							<p class="size-chart-overlay__note">Measurements are in <strong>centimeters (cm)</strong>.</p>
							<div class="size-chart-overlay__table-wrap">
								<table class="size-chart-overlay__table size-chart-overlay__table--shirt">
									<thead>
										<tr>
											<th scope="col">Size</th>
											<th scope="col">Neck</th>
											<th scope="col">Chest</th>
											<th scope="col">Waist</th>
											<th scope="col">Shoulder</th>
											<th scope="col">Length</th>
										</tr>
									</thead>
									<tbody>
										<tr><td>S</td><td>42.4</td><td>117.1</td><td>110.0</td><td>51.1</td><td>74.9</td></tr>
										<tr><td>M</td><td>43.4</td><td>121.9</td><td>118.1</td><td>52.1</td><td>77.0</td></tr>
										<tr><td>L</td><td>44.5</td><td>128.0</td><td>126.0</td><td>53.6</td><td>80.0</td></tr>
										<tr><td>XL</td><td>45.5</td><td>134.9</td><td>132.1</td><td>55.1</td><td>83.1</td></tr>
										<tr><td>2XL</td><td>46.5</td><td>143.0</td><td>138.9</td><td>55.9</td><td>86.1</td></tr>
										<tr><td>3XL</td><td>47.5</td><td>150.1</td><td>146.1</td><td>56.9</td><td>88.9</td></tr>
										<tr><td>4XL</td><td>50.0</td><td>160.0</td><td>152.9</td><td>57.9</td><td>90.9</td></tr>
										<tr><td>5XL</td><td>51.1</td><td>167.9</td><td>160.0</td><td>59.4</td><td>93.0</td></tr>
									</tbody>
								</table>
							</div>
						</div>

						<p class="size-chart-overlay__measurement-note"><strong>Note:</strong> Measurements above are garment measurements, not body dimensions.</p>
						<div class="size-chart-overlay__measurement-guide">
							<figure class="size-chart-overlay__measurement-figure">
								<img
									class="size-chart-overlay__measurement-image"
									src="{{ 'shirt-size-guide.webp' | asset_url }}"
									alt="Short-sleeve button-up shirt measurement guide showing neck, chest, waist, shoulder, and length"
									width="768"
									height="1152"
									loading="lazy"
								>
							</figure>
							<div class="size-chart-overlay__measurement-instructions">
								<h3>How to measure</h3>
								<p><span class="size-chart-overlay__measurement-number">1</span><span><strong>Neck</strong> &ndash; Measure around the inside of the collar.</span></p>
								<p><span class="size-chart-overlay__measurement-number">2</span><span><strong>Chest</strong> &ndash; Measure around the garment at underarm level.</span></p>
								<p><span class="size-chart-overlay__measurement-number">3</span><span><strong>Waist</strong> &ndash; Measure around the garment at the natural waist.</span></p>
								<p><span class="size-chart-overlay__measurement-number">4</span><span><strong>Shoulder</strong> &ndash; Measure straight across from shoulder seam to shoulder seam.</span></p>
								<p><span class="size-chart-overlay__measurement-number">5</span><span><strong>Length</strong> &ndash; Measure from the highest shoulder point beside the collar to the bottom hem.</span></p>
							</div>
						</div>
					</div>
				{%- elsif is_3d_tshirt -%}
					<div class="size-chart-overlay__content size-chart-overlay__content--3d-tshirt">
						<div class="size-chart-overlay__unit-tabs" role="tablist" aria-label="3D T-Shirt measurement unit">
							<button class="size-chart-overlay__unit-tab is-active" type="button" onclick="switchSizeUnit(this, 'in')">In</button>
							<button class="size-chart-overlay__unit-tab" type="button" onclick="switchSizeUnit(this, 'cm')">Cm</button>
