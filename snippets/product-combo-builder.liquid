{% doc %}
Renders a single-listing selector for a vest, a long-sleeve, or a two-size combo.

The first product option selects the offer and the second option remains the
native Shopify size. For a combo, the vest size controls the native variant and
the long-sleeve size is stored as a line item property.

@param {product} product - The combo product.
@param {string} section_id - The product section identifier.
@param {string} [context] - A unique rendering context.
{% enddoc %}

{% liquid
	assign combo_builder_enabled = false
	assign product_type_downcase = product.type | downcase
	if product_type_downcase == 'combo' or product.tags contains 'combo-builder'
		assign combo_builder_enabled = true
	endif

	assign builder_context = context | default: 'product-form'
	assign choice_option = product.options_with_values[0]
	assign size_option = product.options_with_values[1]
	assign selected_choice = choice_option.selected_value | default: product.selected_or_first_available_variant.option1
	assign selected_size = size_option.selected_value | default: product.selected_or_first_available_variant.option2
	assign size_modal_id = 'ComboSizeGuide-' | append: builder_context | append: '-' | append: section_id | append: '-' | append: product.id
%}

{% if combo_builder_enabled and choice_option != blank and size_option != blank %}
	<section
		class="product-combo-builder"
		data-product-combo-builder
		data-context="{{ builder_context | escape }}"
		data-choice-option-name="{{ choice_option.name | escape }}"
		data-size-option-name="{{ size_option.name | escape }}"
		data-initial-choice="{{ selected_choice | escape }}"
		data-initial-size="{{ selected_size | escape }}"
		data-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}"
		data-size-modal-id="{{ size_modal_id | escape }}"
	>
		<script type="application/json" data-combo-variants>{{ product.variants | json }}</script>

		<div class="product-combo-builder__heading">Available as</div>
		<div class="product-combo-builder__choices" role="group" aria-label="Available as">
			{% for choice_value in choice_option.values %}
				{% liquid
					assign choice_text = choice_value | append: ''
					assign choice_downcase = choice_text | downcase
					assign choice_group = 'combo'
					assign choice_label = choice_text
					if choice_downcase contains 'combo'
						assign choice_label = 'Combo'
					elsif choice_downcase contains 'vest'
						assign choice_group = 'vest'
						assign choice_label = 'Vest'
					elsif choice_downcase contains 'long'
						assign choice_group = 'long-sleeve'
						assign choice_label = 'Long-Sleeve'
					endif

					assign choice_image = blank
					assign choice_price = blank
					assign choice_compare_price = 0
					assign choice_price_varies = false
					assign choice_first_price = blank

					for variant in product.variants
						if variant.option1 == choice_text
							if choice_image == blank and variant.featured_media != blank
								assign choice_image = variant.featured_media.preview_image
							endif
							if choice_price == blank or variant.price < choice_price
								assign choice_price = variant.price
							endif
							if variant.compare_at_price > choice_compare_price
								assign choice_compare_price = variant.compare_at_price
							endif
							if choice_first_price == blank
								assign choice_first_price = variant.price
							elsif variant.price != choice_first_price
								assign choice_price_varies = true
							endif
						endif
					endfor

					if choice_image == blank
						assign choice_image = product.featured_media.preview_image
					endif
					assign choice_savings = choice_compare_price | minus: choice_price
				%}

				<button
					type="button"
					class="product-combo-builder__choice{% if choice_text == selected_choice %} is-selected{% endif %}"
					data-combo-choice
					data-choice-value="{{ choice_text | escape }}"
					data-choice-group="{{ choice_group }}"
					data-choice-image="{% if choice_image != blank %}{{ choice_image | image_url: width: 160 }}{% endif %}"
					aria-pressed="{% if choice_text == selected_choice %}true{% else %}false{% endif %}"
				>
					{% if choice_image != blank %}
						<img
							class="product-combo-builder__choice-image"
							src="{{ choice_image | image_url: width: 240 }}"
							alt="{{ choice_label | escape }}"
							width="120"
							height="120"
							loading="lazy"
						>
					{% endif %}
					<span class="product-combo-builder__choice-label">{{ choice_label }}</span>
					<span class="product-combo-builder__choice-price">
						{% if choice_price_varies %}From {% endif %}{{ choice_price | money }}
					</span>
					{% if choice_group == 'combo' and choice_savings > 0 %}
						<span class="product-combo-builder__choice-saving">Save {{ choice_savings | money_without_trailing_zeros }}</span>
					{% endif %}
				</button>
			{% endfor %}
		</div>

		<div class="product-combo-builder__customize">
			<div class="product-combo-builder__subheading" data-combo-customize-heading>Customize your combo</div>

			<div class="product-combo-builder__size-row" data-combo-size-row="vest">
				<div class="product-combo-builder__size-label-wrap">
					<span class="product-combo-builder__size-icon" data-combo-row-image="vest" aria-hidden="true"></span>
				</div>
				<div class="product-combo-builder__sizes" role="group" aria-label="Vest size">
					{% for size_value in size_option.values %}
						{% assign size_text = size_value | append: '' %}
						<button
							type="button"
							class="product-combo-builder__size{% if size_text == selected_size %} is-selected{% endif %}"
							data-combo-size="vest"
							data-size-value="{{ size_text | escape }}"
							aria-pressed="{% if size_text == selected_size %}true{% else %}false{% endif %}"
						>{{ size_text }}</button>
					{% endfor %}
				</div>
				<button class="product-combo-builder__size-guide" type="button" data-combo-size-guide="vest">Size guide</button>
			</div>

			<div class="product-combo-builder__size-row" data-combo-size-row="long-sleeve">
				<div class="product-combo-builder__size-label-wrap">
					<span class="product-combo-builder__size-icon" data-combo-row-image="long-sleeve" aria-hidden="true"></span>
				</div>
				<div class="product-combo-builder__sizes" role="group" aria-label="Long-sleeve size">
					{% for size_value in size_option.values %}
						{% assign size_text = size_value | append: '' %}
						<button
							type="button"
							class="product-combo-builder__size{% if size_text == selected_size %} is-selected{% endif %}"
							data-combo-size="long-sleeve"
							data-size-value="{{ size_text | escape }}"
							aria-pressed="{% if size_text == selected_size %}true{% else %}false{% endif %}"
						>{{ size_text }}</button>
					{% endfor %}
				</div>
				<button class="product-combo-builder__size-guide" type="button" data-combo-size-guide="long-sleeve">Size guide</button>
			</div>

		</div>

		<input type="hidden" name="properties[Vest Size]" value="" data-combo-property="vest">
		<input type="hidden" name="properties[Long-Sleeve Size]" value="" data-combo-property="long-sleeve">
		<input type="hidden" name="properties[_Camo line signature]" value="" data-combo-line-signature>

		<div class="product-combo-builder__summary" aria-live="polite">
			<span class="product-combo-builder__summary-images" data-combo-summary-images aria-hidden="true"></span>
			<strong class="product-combo-builder__summary-text" data-combo-summary-text></strong>
			<span class="product-combo-builder__summary-price" data-combo-summary-price></span>
		</div>

		<div class="product-combo-builder__modal" id="{{ size_modal_id }}" role="dialog" aria-modal="true" aria-labelledby="{{ size_modal_id }}-title" hidden>
			<button class="product-combo-builder__modal-backdrop" type="button" data-combo-modal-close aria-label="Close size guide"></button>
			<div class="product-combo-builder__modal-panel">
				<div class="product-combo-builder__modal-header">
					<h2 id="{{ size_modal_id }}-title" data-combo-modal-title>Size guide</h2>
					<button class="product-combo-builder__modal-close" type="button" data-combo-modal-close aria-label="Close size guide">&times;</button>
				</div>
				<div class="product-combo-builder__modal-content" data-combo-chart="vest" hidden>
					<div class="product-combo-builder__unit-tabs" role="tablist" aria-label="Vest measurement unit">
						<button class="is-active" type="button" role="tab" aria-selected="true" data-combo-unit="in">In</button>
						<button type="button" role="tab" aria-selected="false" data-combo-unit="cm">Cm</button>
					</div>
					<div role="tabpanel" data-combo-unit-panel="in">
						<p class="product-combo-builder__chart-note">Garment measurements are in <strong>inches</strong>.</p>
						<div class="product-combo-builder__table-wrap">
							<table class="product-combo-builder__chart-table">
								<thead><tr><th>Size</th><th>US</th><th>Length</th><th>Chest</th><th>Shoulder</th></tr></thead>
								<tbody>
									<tr><th>S</th><td>36</td><td>24.2</td><td>42.5</td><td>16.7</td></tr>
									<tr><th>M</th><td>38</td><td>25.0</td><td>44.1</td><td>17.2</td></tr>
									<tr><th>L</th><td>40</td><td>25.8</td><td>45.7</td><td>17.8</td></tr>
									<tr><th>XL</th><td>42</td><td>26.6</td><td>47.2</td><td>18.4</td></tr>
									<tr><th>2XL</th><td>44</td><td>27.4</td><td>48.8</td><td>19.0</td></tr>
									<tr><th>3XL</th><td>46</td><td>28.0</td><td>50.4</td><td>19.6</td></tr>
									<tr><th>4XL</th><td>48</td><td>28.5</td><td>52.0</td><td>20.2</td></tr>
									<tr><th>5XL</th><td>50</td><td>29.1</td><td>53.5</td><td>20.8</td></tr>
									<tr><th>6XL</th><td>52</td><td>29.7</td><td>55.1</td><td>21.4</td></tr>
								</tbody>
							</table>
						</div>
					</div>
					<div role="tabpanel" data-combo-unit-panel="cm" hidden>
						<p class="product-combo-builder__chart-note">Garment measurements are in <strong>centimeters</strong>.</p>
						<div class="product-combo-builder__table-wrap">
							<table class="product-combo-builder__chart-table">
								<thead><tr><th>Size</th><th>US</th><th>Length</th><th>Chest</th><th>Shoulder</th></tr></thead>
								<tbody>
									<tr><th>S</th><td>36</td><td>61.5</td><td>108.0</td><td>42.4</td></tr>
									<tr><th>M</th><td>38</td><td>63.5</td><td>112.0</td><td>43.7</td></tr>
									<tr><th>L</th><td>40</td><td>65.5</td><td>116.1</td><td>45.2</td></tr>
									<tr><th>XL</th><td>42</td><td>67.6</td><td>119.9</td><td>46.7</td></tr>
									<tr><th>2XL</th><td>44</td><td>69.6</td><td>124.0</td><td>48.3</td></tr>
									<tr><th>3XL</th><td>46</td><td>71.1</td><td>128.0</td><td>49.8</td></tr>
									<tr><th>4XL</th><td>48</td><td>72.4</td><td>132.1</td><td>51.3</td></tr>
									<tr><th>5XL</th><td>50</td><td>73.9</td><td>135.9</td><td>52.8</td></tr>
									<tr><th>6XL</th><td>52</td><td>75.4</td><td>140.0</td><td>54.4</td></tr>
								</tbody>
							</table>
						</div>
					</div>
					<p class="product-combo-builder__tolerance">Manual measurements may vary by 2–3 cm.</p>
					<div class="product-combo-builder__measure-guide">
						<figure class="product-combo-builder__measure-figure">
							<img
								class="product-combo-builder__measure-image"
								src="{{ 'combo-fleece-vest-size-guide.webp' | asset_url }}"
								alt="Full-zip fleece vest measurement guide showing length, chest circumference, and shoulder width"
								width="768"
								height="1152"
								loading="lazy"
							>
						</figure>
						<div class="product-combo-builder__measure-instructions">
							<h3>How to measure</h3>
							<p><span class="product-combo-builder__measure-number">1</span><span><strong>Length</strong> — Measure from the highest shoulder point beside the collar to the bottom hem.</span></p>
							<p><span class="product-combo-builder__measure-number">2</span><span><strong>Chest</strong> — Measure around the garment at chest level, just below the armholes.</span></p>
							<p><span class="product-combo-builder__measure-number">3</span><span><strong>Shoulder</strong> — Measure straight across from one shoulder point to the other.</span></p>
						</div>
					</div>
				</div>
				<div class="product-combo-builder__modal-content" data-combo-chart="long-sleeve" hidden>
					<div class="product-combo-builder__unit-tabs" role="tablist" aria-label="Long-sleeve zip measurement unit">
						<button class="is-active" type="button" role="tab" aria-selected="true" data-combo-unit="in">In</button>
						<button type="button" role="tab" aria-selected="false" data-combo-unit="cm">Cm</button>
					</div>
					<div role="tabpanel" data-combo-unit-panel="in">
						<p class="product-combo-builder__chart-note">Garment measurements are in <strong>inches</strong>.</p>
						<div class="product-combo-builder__table-wrap">
							<table class="product-combo-builder__chart-table">
								<thead><tr><th>Size</th><th>US</th><th>Length</th><th>Chest</th><th>Sleeve length</th></tr></thead>
								<tbody>
									<tr><th>S</th><td>36</td><td>26.0</td><td>37.0</td><td>27.6</td></tr>
									<tr><th>M</th><td>38</td><td>26.8</td><td>38.6</td><td>28.1</td></tr>
									<tr><th>L</th><td>40</td><td>27.6</td><td>40.6</td><td>28.9</td></tr>
									<tr><th>XL</th><td>42</td><td>28.3</td><td>42.5</td><td>29.6</td></tr>
									<tr><th>2XL</th><td>44</td><td>29.1</td><td>44.5</td><td>30.3</td></tr>
									<tr><th>3XL</th><td>46</td><td>29.9</td><td>46.5</td><td>31.0</td></tr>
									<tr><th>4XL</th><td>48</td><td>30.7</td><td>48.4</td><td>31.7</td></tr>
									<tr><th>5XL</th><td>50</td><td>31.5</td><td>50.4</td><td>32.4</td></tr>
									<tr><th>6XL</th><td>52</td><td>32.3</td><td>52.4</td><td>33.1</td></tr>
								</tbody>
							</table>
						</div>
					</div>
					<div role="tabpanel" data-combo-unit-panel="cm" hidden>
						<p class="product-combo-builder__chart-note">Garment measurements are in <strong>centimeters</strong>.</p>
						<div class="product-combo-builder__table-wrap">
							<table class="product-combo-builder__chart-table">
								<thead><tr><th>Size</th><th>US</th><th>Length</th><th>Chest</th><th>Sleeve length</th></tr></thead>
								<tbody>
									<tr><th>S</th><td>36</td><td>66.0</td><td>94.0</td><td>70.1</td></tr>
									<tr><th>M</th><td>38</td><td>68.1</td><td>98.0</td><td>71.4</td></tr>
									<tr><th>L</th><td>40</td><td>70.1</td><td>103.1</td><td>73.4</td></tr>
									<tr><th>XL</th><td>42</td><td>71.9</td><td>108.0</td><td>75.2</td></tr>
									<tr><th>2XL</th><td>44</td><td>73.9</td><td>113.0</td><td>77.0</td></tr>
									<tr><th>3XL</th><td>46</td><td>75.9</td><td>118.1</td><td>78.7</td></tr>
									<tr><th>4XL</th><td>48</td><td>78.0</td><td>122.9</td><td>80.5</td></tr>
									<tr><th>5XL</th><td>50</td><td>80.0</td><td>128.0</td><td>82.3</td></tr>
									<tr><th>6XL</th><td>52</td><td>82.0</td><td>133.1</td><td>84.1</td></tr>
								</tbody>
							</table>
						</div>
					</div>
					<p class="product-combo-builder__tolerance">Manual measurements may vary by 2–3 cm.</p>
					<div class="product-combo-builder__measure-guide">
						<figure class="product-combo-builder__measure-figure">
							<img
								class="product-combo-builder__measure-image"
								src="{{ 'combo-quarter-zip-size-guide.webp' | asset_url }}"
								alt="Quarter-zip long-sleeve measurement guide showing length, chest circumference, and sleeve length"
								width="768"
								height="1152"
								loading="lazy"
							>
						</figure>
						<div class="product-combo-builder__measure-instructions">
							<h3>How to measure</h3>
							<p><span class="product-combo-builder__measure-number">1</span><span><strong>Length</strong> — Measure from the highest shoulder point beside the collar to the bottom hem.</span></p>
							<p><span class="product-combo-builder__measure-number">2</span><span><strong>Chest</strong> — Measure around the garment at chest level, just below the armholes.</span></p>
							<p><span class="product-combo-builder__measure-number">3</span><span><strong>Sleeve length</strong> — Measure from the shoulder/armhole seam along the outer sleeve to the cuff.</span></p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<style>
		.product-combo-builder {
			--combo-ink: var(--color-text-primary, #263b2e);
			--combo-accent: #e6a400;
			display: grid;
			gap: 12px;
			width: 100%;
			margin: 14px 0 18px;
			color: var(--combo-ink);
		}

		.product-combo-builder__native-options {
			display: none !important;
		}

		.product-combo-builder__heading,
		.product-combo-builder__subheading,
		.product-combo-builder__choice-label,
		.product-combo-builder__summary-text {
			font-family: 'Oswald', var(--font-heading-family), sans-serif;
			text-transform: uppercase;
		}

		.product-combo-builder__heading,
		.product-combo-builder__subheading {
			font-size: 14px;
			font-weight: 600;
			letter-spacing: 0.025em;
		}

		.product-combo-builder__choices {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 10px;
		}

		.product-combo-builder__choice {
			position: relative;
			display: flex;
			min-width: 0;
			padding: 10px 8px;
			flex-direction: column;
			align-items: center;
			border: 1px solid #d7dad7;
			border-radius: 2px;
			background: #fff;
			color: inherit;
			cursor: pointer;
			transition: border-color 150ms ease, box-shadow 150ms ease;
		}

		.product-combo-builder__choice:hover {
			border-color: #7f8a81;
		}

		.product-combo-builder__choice.is-selected {
			border-color: var(--combo-ink);
			box-shadow: inset 0 0 0 1px var(--combo-ink);
		}

		.product-combo-builder__choice.is-selected::before {
			position: absolute;
			top: 7px;
			left: 7px;
			width: 20px;
			height: 20px;
			border-radius: 1px;
			background: var(--combo-ink);
			color: #fff;
			content: '\2713';
			font-size: 14px;
			line-height: 20px;
			text-align: center;
		}

		.product-combo-builder__choice-image {
			width: min(100%, 112px);
			height: 104px;
			object-fit: contain;
		}

		.product-combo-builder__choice-label {
			margin-top: 3px;
			font-size: 14px;
			font-weight: 600;
			line-height: 1.2;
			text-align: center;
		}

		.product-combo-builder__choice-price {
			margin-top: 3px;
			font-size: 14px;
			line-height: 1.2;
		}

		.product-combo-builder__choice-saving {
			margin-top: 3px;
			color: var(--combo-accent);
			font-size: 12px;
			font-weight: 700;
			line-height: 1.2;
			text-transform: uppercase;
		}

		.product-combo-builder__customize {
			display: grid;
			gap: 10px;
			padding-top: 12px;
			border-top: 1px solid #dedfde;
		}

		.product-combo-builder__size-row {
			display: grid;
			grid-template-columns: 68px minmax(0, 1fr);
			grid-template-rows: auto auto;
			gap: 4px 10px;
			align-items: center;
		}

		.product-combo-builder__size-row[hidden] {
			display: none !important;
		}

		.product-combo-builder__size-label-wrap {
			display: flex;
			grid-column: 1;
			grid-row: 1 / span 2;
			min-width: 0;
			align-items: center;
			justify-content: center;
		}

		.product-combo-builder__size-icon {
			display: block;
			width: 60px;
			height: 72px;
			flex: 0 0 60px;
			background-position: center;
			background-repeat: no-repeat;
			background-size: contain;
		}

		.product-combo-builder__sizes {
			display: grid;
			grid-column: 2;
			grid-row: 2;
			grid-template-columns: repeat(9, minmax(0, 1fr));
			gap: 5px;
		}

		.product-combo-builder__size {
			min-height: 40px;
			padding: 6px;
			border: 1px solid #d7dad7;
			border-radius: 1px;
			background: #fff;
			color: inherit;
			font: inherit;
			cursor: pointer;
		}

		.product-combo-builder__size:hover {
			border-color: #7f8a81;
		}

		.product-combo-builder__size.is-selected {
			border-color: var(--combo-ink);
			background: var(--combo-ink);
			color: #fff;
		}

		.product-combo-builder__size-guide {
			grid-column: 2;
			grid-row: 1;
			justify-self: end;
			padding: 4px 0;
			border: 0;
			background: transparent;
			color: inherit;
			font: inherit;
			font-size: 12px;
			text-decoration: underline;
			white-space: nowrap;
			cursor: pointer;
		}

		.product-combo-builder__summary {
			display: grid;
			grid-template-columns: auto 1fr auto;
			min-height: 48px;
			padding: 6px 10px;
			gap: 10px;
			align-items: center;
			border: 1px solid #aeb4ae;
			background: #fff;
		}

