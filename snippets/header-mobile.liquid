{% doc %}
  Renders the mobile collection drawer.
  @param {linklist} [menu] - Store navigation.
  @param {linklist} [mobile_top_menu] - Utility navigation.
  @param {boolean} [is_language_selector_enabled] - Show language selection.
  @param {boolean} [is_country_selector_enabled] - Show country selection.
  @param {string} color_scheme - Drawer color scheme.
{% enddoc %}
{% render 'camo-navigation', mode: 'mobile', color_scheme: color_scheme,
  mobile_top_menu: mobile_top_menu,
  is_language_selector_enabled: is_language_selector_enabled,
  is_country_selector_enabled: is_country_selector_enabled
%}
