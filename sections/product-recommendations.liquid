{%- comment -%}
------------------------------------------------------------------------------
	Section: Product recommendations
------------------------------------------------------------------------------
{%- endcomment -%}

{%- render 'adastra' with '/src/styles/carousel.scss' -%}
{%- render 'adastra' with '/src/styles/featured-products.scss' -%}
{%- render 'adastra' with '/src/styles/product-card.scss' -%}

{%- assign recommended_limit = section.settings.products_to_show | default: 4 | plus: 0 -%}
{%- assign best_seller_limit = section.settings.best_seller_products_to_show | default: 4 | plus: 0 -%}
{%- assign recommended_candidate_limit = recommended_limit -%}
{%- assign best_seller_candidate_limit = best_seller_limit -%}
{%- assign desktop_limit = recommended_limit | plus: best_seller_limit -%}
{%- assign mobile_limit = section.settings.products_to_show_mobile | default: desktop_limit | plus: 0 -%}
{%- if mobile_limit > desktop_limit -%}
	{%- assign mobile_limit = desktop_limit -%}
{%- endif -%}
{%- assign limit = desktop_limit -%}

{%- style -%}
	#shopify-section-{{- section.id -}} {
		container-type: inline-size;
		overflow-x: hidden;
		padding-top: {{- section.settings.offset_top_mobile -}}px;
		padding-bottom: {{- section.settings.offset_bottom_mobile -}}px;
	}

	@supports (overflow: clip) {
		#shopify-section-{{- section.id -}} {
			overflow-x: clip;
		}
	}

	@media screen and (min-width: 768px) {
		#shopify-section-{{- section.id -}} {
			padding-top: {{- section.settings.offset_top_desktop -}}px;
			padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
		}
	}

	#shopify-section-{{ section.id }} .product-recommendations__mobile-pagination {
		display: none;
	}

	#shopify-section-{{ section.id }} .featured-products__header.product-recommendations__header h2 {
		font-size: var(--product-recommendations-heading-size-desktop, {{- section.settings.heading_font_size_desktop | default: 36 -}}px) !important;
	}

	#shopify-section-{{ section.id }} .featured-products__row {
		transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1) !important;
	}

	#shopify-section-{{ section.id }} .product-recommendations__carousel-shell {
		--product-recommendations-arrow-top: 50%;
		position: relative;
		isolation: isolate;
		margin-inline: -28px;
		padding-inline: 28px;
	}

	#shopify-section-{{ section.id }} .product-recommendations__carousel-shell .featured-products__slider {
		overflow: hidden !important;
		overflow-x: hidden !important;
		clip-path: inset(0);
		contain: paint;
	}

	#shopify-section-{{ section.id }} .product-recommendations__navigation {
		position: absolute;
		inset: 0;
		display: block !important;
		z-index: 50;
		opacity: 1 !important;
		visibility: visible !important;
		pointer-events: none;
	}

	#shopify-section-{{ section.id }} .product-recommendations__arrow {
		position: absolute !important;
		top: var(--product-recommendations-arrow-top) !important;
		z-index: 51;
		display: flex !important;
		align-items: center;
		justify-content: center;
		width: 40px !important;
		height: 44px !important;
		padding: 0;
		border: 0 !important;
		border-radius: 0;
		background: transparent !important;
		color: #2c3d33 !important;
		box-shadow: none;
		opacity: 1;
		transform: translateY(-50%) !important;
		visibility: visible;
		pointer-events: auto;
		touch-action: manipulation;
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease,
			box-shadow 0.2s ease,
			transform 0.12s ease;
	}

	#shopify-section-{{ section.id }} .product-recommendations__arrow::after {
		display: none !important;
	}

	#shopify-section-{{ section.id }} .product-recommendations__arrow--prev {
		left: -10px !important;
	}

	#shopify-section-{{ section.id }} .product-recommendations__arrow--next {
		right: -10px !important;
	}

	#shopify-section-{{ section.id }} .product-recommendations__arrow .icon {
		width: 28px !important;
		height: 28px !important;
	}

	#shopify-section-{{ section.id }} .product-recommendations__arrow .icon path {
		stroke: currentColor;
		stroke-width: 1.5px;
		stroke-linejoin: round;
	}

	#shopify-section-{{ section.id }} .product-recommendations__arrow:hover {
		border-color: transparent !important;
		background: transparent !important;
		color: #2c3d33 !important;
		box-shadow: none;
	}

	#shopify-section-{{ section.id }} .product-recommendations__arrow:focus-visible {
		outline: 2px solid #2c3d33;
		outline-offset: 2px;
		box-shadow: none;
	}

	#shopify-section-{{ section.id }} .product-recommendations__arrow:active {
		opacity: 1;
		transform: translateY(-50%) scale(0.94) !important;
	}

	#shopify-section-{{ section.id }} .product-recommendations__arrow.swiper-button-lock,
	#shopify-section-{{ section.id }} .product-recommendations__arrow.swiper-button-disabled,
	#shopify-section-{{ section.id }} .product-recommendations__arrow[disabled],
	#shopify-section-{{ section.id }} .product-recommendations__arrow[aria-disabled="true"] {
		display: none !important;
		opacity: 0 !important;
		visibility: hidden !important;
		pointer-events: none !important;
	}

	@media screen and (max-width: 767px) {
		#shopify-section-{{ section.id }} .product-recommendations__carousel-shell {
			margin-inline: 0;
			padding-inline: 0;
		}

		#shopify-section-{{ section.id }} .product-recommendations__navigation {
			display: none !important;
		}

		#shopify-section-{{ section.id }} .product-recommendations__arrow--prev {
			left: -27px !important;
		}

		#shopify-section-{{ section.id }} .product-recommendations__arrow--next {
			right: -27px !important;
		}

		#shopify-section-{{ section.id }} .product-recommendations__arrow {
			width: 40px !important;
			height: 44px !important;
			border-color: transparent !important;
			background: transparent !important;
			color: #2c3d33 !important;
			box-shadow: none;
		}

		#shopify-section-{{ section.id }} .product-recommendations__arrow:hover {
			border-color: transparent !important;
			background: transparent !important;
			color: #2c3d33 !important;
		}

		#shopify-section-{{ section.id }} .product-recommendations__arrow .icon {
			width: 28px !important;
			height: 28px !important;
		}
	}

	#shopify-section-{{ section.id }} .product-recommendations__candidate-fallback {
		display: none !important;
	}

	@media (prefers-reduced-motion: reduce) {
		#shopify-section-{{ section.id }} .featured-products__row {
			transition-duration: 0.01ms !important;
		}
	}

	@media screen and (min-width: 768px) {
		#shopify-section-{{ section.id }} .product-recommendations__slide--desktop-hidden {
			display: none !important;
		}
	}

	{%- if mobile_limit > desktop_limit -%}
		@media screen and (min-width: 768px) {
			#shopify-section-{{ section.id }} .featured-products__buttons-wrapper {
				display: none !important;
			}

			#shopify-section-{{ section.id }} .featured-products__slider {
				cursor: default !important;
			}
		}
	{%- endif -%}

