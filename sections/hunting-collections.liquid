{%- liquid
  assign section_heading_variant = section.settings.section_heading_font | font_modify: 'weight', section.settings.section_heading_weight

  assign content_justify = 'center'
  if section.settings.content_position == 'top'
    assign content_justify = 'flex-start'
  elsif section.settings.content_position == 'bottom'
    assign content_justify = 'flex-end'
  endif

  assign content_align = 'center'
  if section.settings.text_alignment == 'left'
    assign content_align = 'flex-start'
  elsif section.settings.text_alignment == 'right'
    assign content_align = 'flex-end'
  endif

  assign enter_transform = 'translate3d(0, -20px, 0)'
  if section.settings.animation_style == 'fade_up'
    assign enter_transform = 'translate3d(0, 20px, 0)'
  elsif section.settings.animation_style == 'zoom'
    assign enter_transform = 'scale(0.96)'
  elsif section.settings.animation_style == 'fade'
    assign enter_transform = 'none'
  endif
-%}

{%- style -%}
  {{ section.settings.section_heading_font | font_face: font_display: 'swap' }}
  {%- if section_heading_variant != blank -%}
    {{ section_heading_variant | font_face: font_display: 'swap' }}
  {%- endif -%}
  {{ section.settings.title_font | font_face: font_display: 'swap' }}
  {{ section.settings.description_font | font_face: font_display: 'swap' }}
  {{ section.settings.button_font | font_face: font_display: 'swap' }}

  {%- for block in section.blocks -%}
    {%- if block.settings.use_custom_typography -%}
      {{ block.settings.title_font | font_face: font_display: 'swap' }}
      {{ block.settings.description_font | font_face: font_display: 'swap' }}
    {%- endif -%}
  {%- endfor -%}

  #shopify-section-{{ section.id }} {
    background: {{ section.settings.section_background }};
    padding-top: {{ section.settings.offset_top_mobile }}px;
    padding-bottom: {{ section.settings.offset_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.offset_top_desktop }}px;
      padding-bottom: {{ section.settings.offset_bottom_desktop }}px;
    }
  }
{%- endstyle -%}

<section
  class="hunter-promo-grid hunter-promo-grid--overlay-{{ section.settings.overlay_style }} hunter-promo-grid--content-{{ section.settings.content_behavior }}{% if section.settings.image_ratio == 'natural' %} hunter-promo-grid--natural{% else %} hunter-promo-grid--fixed-ratio{% endif %}{% if section.settings.full_width %} hunter-promo-grid--full-width{% endif %}{% if section.settings.animate_on_scroll %} hunter-promo-grid--animate{% endif %}{% if request.design_mode %} is-visible{% endif %}"
  id="hunter-promo-{{ section.id }}"
  {% if section.settings.mobile_peek %}data-mobile-peek{% endif %}
  style="
    --promo-columns-desktop: {{ section.settings.columns_desktop }};
    --promo-columns-mobile: {{ section.settings.columns_mobile }};
    --promo-gap-desktop: {{ section.settings.gap_desktop }}px;
    --promo-gap-mobile: {{ section.settings.gap_mobile }}px;
    --promo-max-width: {{ section.settings.max_width }}px;
    --container-width: {{ section.settings.max_width }}px;
    --promo-card-radius: {{ section.settings.card_radius }}px;
    --promo-section-heading-font: {{ section.settings.section_heading_font.family }}, {{ section.settings.section_heading_font.fallback_families }};
    --promo-section-heading-color: {{ section.settings.section_heading_color }};
    --promo-section-heading-size-desktop: {{ section.settings.section_heading_size_desktop }}px;
    --promo-section-heading-size-mobile: {{ section.settings.section_heading_size_mobile }}px;
    --promo-section-heading-weight: {{ section.settings.section_heading_weight }};
    --promo-section-heading-align: {{ section.settings.section_heading_alignment }};
    --promo-section-heading-transform: {% if section.settings.section_heading_uppercase %}uppercase{% else %}none{% endif %};
    --promo-section-heading-spacing-desktop: {{ section.settings.section_heading_spacing_desktop }}px;
    --promo-section-heading-spacing-mobile: {{ section.settings.section_heading_spacing_mobile }}px;
    --promo-image-ratio: {{ section.settings.image_ratio }};
    --promo-image-position: {{ section.settings.image_position }};
    --promo-overlay-color: {{ section.settings.overlay_color }};
    --promo-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --promo-overlay-hover-opacity: {{ section.settings.overlay_hover_opacity | divided_by: 100.0 }};
    --promo-content-justify: {{ content_justify }};
    --promo-content-align: {{ content_align }};
    --promo-text-align: {{ section.settings.text_alignment }};
    --promo-content-padding-desktop: {{ section.settings.content_padding_desktop }}px;
    --promo-content-padding-mobile: {{ section.settings.content_padding_mobile }}px;
    --promo-content-width: {{ section.settings.content_width }}%;
    --promo-title-color: {{ section.settings.title_color }};
    --promo-description-color: {{ section.settings.description_color }};
    --promo-title-font: {{ section.settings.title_font.family }}, {{ section.settings.title_font.fallback_families }};
    --promo-description-font: {{ section.settings.description_font.family }}, {{ section.settings.description_font.fallback_families }};
    --promo-button-font: {{ section.settings.button_font.family }}, {{ section.settings.button_font.fallback_families }};
    --promo-title-size-desktop: {{ section.settings.title_size_desktop }}px;
    --promo-title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --promo-title-weight: {{ section.settings.title_weight }};
    --promo-title-spacing: {{ section.settings.title_letter_spacing | divided_by: 10.0 }}px;
    --promo-title-transform: {% if section.settings.title_uppercase %}uppercase{% else %}none{% endif %};
    --promo-description-size-desktop: {{ section.settings.description_size_desktop }}px;
    --promo-description-size-mobile: {{ section.settings.description_size_mobile }}px;
    --promo-content-gap: {{ section.settings.content_gap }}px;
    --promo-button-background: {{ section.settings.button_background }};
    --promo-button-color: {{ section.settings.button_color }};
    --promo-button-border: {{ section.settings.button_border }};
    --promo-button-radius: {{ section.settings.button_radius }}px;
    --promo-hover-scale: {{ section.settings.hover_scale | divided_by: 100.0 }};
    --promo-transition-speed: {{ section.settings.transition_speed | divided_by: 1000.0 }}s;
    --promo-enter-transform: {{ enter_transform }};
  "
>
  <div class="hunter-promo-grid__container container">
    {%- if section.settings.section_heading != blank or section.blocks.size > 1 -%}
      <div class="hunter-promo-grid__header">
        {%- if section.settings.section_heading != blank -%}
          <h2 class="hunter-promo-grid__heading{% if section.settings.use_theme_heading_style %} hunter-promo-grid__heading--theme{% endif %}">{{ section.settings.section_heading }}</h2>
        {%- endif -%}
        {%- if section.blocks.size > 1 -%}
          <div class="hunter-promo-grid__controls hunter-promo-grid__controls--desktop" data-promo-controls aria-label="Collection carousel controls">
            <button
              class="hunter-promo-grid__arrow hunter-promo-grid__arrow--previous hunter-promo-grid__arrow--desktop"
              type="button"
              aria-label="Previous collections"
              aria-controls="hunter-promo-track-{{ section.id }}"
              data-promo-previous
              disabled
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M15 18 9 12l6-6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"/>
              </svg>
            </button>
            <button
              class="hunter-promo-grid__arrow hunter-promo-grid__arrow--next hunter-promo-grid__arrow--desktop"
              type="button"
              aria-label="Next collections"
              aria-controls="hunter-promo-track-{{ section.id }}"
              data-promo-next
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="m9 18 6-6-6-6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"/>
              </svg>
            </button>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="hunter-promo-grid__viewport">
      <div
        class="hunter-promo-grid__items"
        id="hunter-promo-track-{{ section.id }}"
        role="list"
        tabindex="0"
        aria-label="{{ section.settings.section_heading | default: 'Collections' | escape }}"
        data-promo-track
        data-columns-desktop="{{ section.settings.columns_desktop }}"
        data-columns-mobile="{{ section.settings.columns_mobile }}"
      >
      {%- for block in section.blocks -%}
      {%- liquid
        assign promo_collection = block.settings.collection
        assign promo_image = block.settings.image
        assign external_image_url = block.settings.external_image_url | strip
        assign promo_link = block.settings.link
        assign promo_title = block.settings.title | default: promo_collection.title
        assign promo_alt = block.settings.alt_text | default: promo_title

        if promo_image == blank and promo_collection != blank
          assign promo_image = promo_collection.image
        endif

        if promo_link == blank and promo_collection != blank
          assign promo_link = promo_collection.url
        endif

        assign block_position = block.settings.content_position
        if block_position == 'inherit'
          assign block_position = section.settings.content_position
        endif

        assign block_justify = 'center'
        if block_position == 'top'
          assign block_justify = 'flex-start'
        elsif block_position == 'bottom'
          assign block_justify = 'flex-end'
        endif

        assign block_alignment = block.settings.text_alignment
        if block_alignment == 'inherit'
          assign block_alignment = section.settings.text_alignment
        endif

        assign block_align = 'center'
        if block_alignment == 'left'
          assign block_align = 'flex-start'
        elsif block_alignment == 'right'
          assign block_align = 'flex-end'
        endif

        assign block_image_position = block.settings.image_position
        if block_image_position == 'inherit'
          assign block_image_position = section.settings.image_position
        endif

        assign mobile_columns = section.settings.columns_mobile | plus: 0
        assign desktop_page_remainder = forloop.index0 | modulo: section.settings.columns_desktop
        assign mobile_page_remainder = forloop.index0 | modulo: mobile_columns
      -%}

      <figure
        class="hunter-promo-grid__item{% if desktop_page_remainder == 0 %} hunter-promo-grid__item--desktop-page-start{% endif %}{% if mobile_page_remainder == 0 %} hunter-promo-grid__item--mobile-page-start{% endif %}{% if block.settings.use_custom_overlay %} hunter-promo-grid__item--custom-overlay{% endif %}{% if block.settings.use_custom_typography %} hunter-promo-grid__item--custom-typography{% endif %}"
        role="listitem"
        data-mobile-column="{{ mobile_page_remainder | plus: 1 }}"
        style="
          --promo-index: {{ forloop.index0 }};
          --promo-block-justify: {{ block_justify }};
          --promo-block-align: {{ block_align }};
          --promo-block-text-align: {{ block_alignment }};
          --promo-block-image-position: {{ block_image_position }};
          {% if block.settings.use_custom_overlay %}--promo-overlay-color: {{ block.settings.overlay_color }}; --promo-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }}; --promo-overlay-hover-opacity: {{ block.settings.overlay_hover_opacity | divided_by: 100.0 }};{% endif %}
          {% if block.settings.use_custom_typography %}--promo-title-font: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }}; --promo-title-size-desktop: {{ block.settings.title_size_desktop }}px; --promo-title-size-mobile: {{ block.settings.title_size_mobile }}px; --promo-title-weight: {{ block.settings.title_weight }}; --promo-title-color: {{ block.settings.title_color }}; --promo-description-font: {{ block.settings.description_font.family }}, {{ block.settings.description_font.fallback_families }}; --promo-description-size-desktop: {{ block.settings.description_size_desktop }}px; --promo-description-size-mobile: {{ block.settings.description_size_mobile }}px; --promo-description-color: {{ block.settings.description_color }}; --promo-button-background: {{ block.settings.button_background }}; --promo-button-color: {{ block.settings.button_color }}; --promo-button-border: {{ block.settings.button_border }};{% endif %}
        "
        {{ block.shopify_attributes }}
      >
        {%- if promo_link != blank -%}
          <a class="hunter-promo-grid__inner" href="{{ promo_link }}" aria-label="{{ promo_title | escape }}">
        {%- else -%}
          <div class="hunter-promo-grid__inner">
        {%- endif -%}

          {%- if external_image_url != blank -%}
            <img
              class="hunter-promo-grid__image"
              src="{{ external_image_url | escape }}"
              alt="{{ promo_alt | escape }}"
              width="1080"
              height="1350"
              loading="lazy"
            >
          {%- elsif promo_image != blank -%}
            {{
              promo_image
              | image_url: width: 2000
              | image_tag:
                class: 'hunter-promo-grid__image',
                widths: '240, 375, 500, 750, 1000, 1250, 1600, 2000',
                sizes: '(min-width: 750px) 25vw, 50vw',
                loading: 'lazy',
                alt: promo_alt
            }}
          {%- else -%}
            <div class="hunter-promo-grid__image hunter-promo-grid__image--empty" aria-hidden="true"></div>
          {%- endif -%}

          <span class="hunter-promo-grid__shade" aria-hidden="true"></span>

          <figcaption class="hunter-promo-grid__overlay">
            <div class="hunter-promo-grid__content">
              {%- if promo_title != blank -%}
                <h2 class="hunter-promo-grid__title">{{ promo_title }}</h2>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <div class="hunter-promo-grid__description">{{ block.settings.description }}</div>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <span class="hunter-promo-grid__button">{{ block.settings.button_label }}</span>
              {%- endif -%}
            </div>
          </figcaption>

        {%- if promo_link != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
        </figure>
      {%- endfor -%}
      </div>
    </div>
    <div
      class="hunter-promo-grid__pagination"
      data-promo-pagination
      aria-label="Collection carousel pagination"
    ></div>
  </div>
</section>

{% stylesheet %}
  .hunter-promo-grid,
  .hunter-promo-grid__items {
    box-sizing: border-box;
    margin: 0 auto;
    padding: 0;
    width: 100%;
  }

  .hunter-promo-grid:not(.hunter-promo-grid--full-width) {
    max-width: var(--promo-max-width);
    padding-left: 16px;
    padding-right: 16px;
  }

  .hunter-promo-grid:not(.hunter-promo-grid--full-width) .hunter-promo-grid__header {
    max-width: none;
    padding-left: 0;
    padding-right: 0;
  }

  .hunter-promo-grid__header {
    align-items: center;
    display: flex;
    gap: 16px;
    justify-content: space-between;
    box-sizing: border-box;
    margin: 0 0 var(--promo-section-heading-spacing-desktop);
    margin-left: auto;
    margin-right: auto;
    max-width: var(--container-width, 2048px);
    padding: 0 16px;
    text-align: var(--promo-section-heading-align);
    width: 100%;
  }

  .hunter-promo-grid__heading {
    color: var(--promo-section-heading-color);
    font-family: var(--promo-section-heading-font);
    font-size: var(--promo-section-heading-size-desktop);
    font-weight: var(--promo-section-heading-weight);
    letter-spacing: 0.04em;
    line-height: 1.1;
    margin: 0;
    text-transform: var(--promo-section-heading-transform);
  }

  .hunter-promo-grid__controls {
    display: flex;
    flex: 0 0 auto;
    gap: 8px;
  }

  .hunter-promo-grid__controls[hidden] {
    display: none;
  }

  .hunter-promo-grid__controls--desktop {
    display: none;
  }

  .hunter-promo-grid__pagination {
    display: none;
  }

  .hunter-promo-grid__pagination[hidden] {
    display: none;
  }

  .hunter-promo-grid__arrow {
    align-items: center;
    background: #ffffff;
    border: 1px solid var(--promo-section-heading-color);
    border-radius: 50%;
    color: var(--promo-section-heading-color);
    cursor: pointer;
    display: inline-flex;
    height: 44px;
    justify-content: center;
    padding: 0;
    transition: background-color 0.2s ease, color 0.2s ease, opacity 0.2s ease;
    width: 44px;
  }

  .hunter-promo-grid__arrow svg {
    height: 22px;
    width: 22px;
  }

  .hunter-promo-grid__arrow:hover:not(:disabled),
  .hunter-promo-grid__arrow:focus-visible {
    background: var(--promo-section-heading-color);
    color: #ffffff;
  }

  .hunter-promo-grid__arrow:focus-visible {
    outline: 2px solid var(--promo-section-heading-color);
    outline-offset: 3px;
  }

  .hunter-promo-grid__arrow:disabled {
    cursor: default;
    opacity: 0.32;
  }

  .hunter-promo-grid__heading--theme {
    color: var(--color-heading);
    font-family: var(--heading-font-family);
    font-size: calc(var(--heading-font-size) * 1.6363636364);
    font-weight: var(--heading-font-weight);
    letter-spacing: normal;
    line-height: 1.3333333333;
    text-transform: var(--heading-text-transform);
  }

  .hunter-promo-grid__viewport {
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .hunter-promo-grid__items {
    display: flex;
    gap: var(--promo-gap-desktop);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    position: relative;
    scroll-behavior: smooth;
    scroll-snap-type: inline mandatory;
    scrollbar-width: none;
  }

  .hunter-promo-grid__items::-webkit-scrollbar {
    display: none;
  }

  .hunter-promo-grid__item {
    box-sizing: border-box;
    flex: 0 0 calc((100% - (var(--promo-columns-desktop) - 1) * var(--promo-gap-desktop)) / var(--promo-columns-desktop));
    margin: 0;
    min-width: 0;
    overflow: hidden;
    padding: 0;
    position: relative;
    scroll-snap-align: none;
    scroll-snap-stop: normal;
    text-align: var(--promo-block-text-align);
  }

  .hunter-promo-grid__item--desktop-page-start {
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .hunter-promo-grid__inner {
    border-radius: var(--promo-card-radius);
    color: var(--promo-title-color);
    display: block;
    isolation: isolate;
    overflow: hidden;
    position: relative;
    text-decoration: none;
    width: 100%;
  }

  .hunter-promo-grid__inner:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: -6px;
  }

  .hunter-promo-grid__image {
    display: block;
    height: auto;
    object-position: var(--promo-block-image-position);
    position: relative;
    transition: transform var(--promo-transition-speed) ease;
    width: 100%;
    z-index: 0;
  }

  .hunter-promo-grid--fixed-ratio .hunter-promo-grid__image {
    aspect-ratio: var(--promo-image-ratio);
    height: auto;
    object-fit: cover;
  }

  .hunter-promo-grid__image--empty {
    aspect-ratio: 4 / 5;
    background-color: #303833;
  }

  .hunter-promo-grid__shade {
    background: var(--promo-overlay-color);
    inset: 0;
    opacity: var(--promo-overlay-opacity);
    pointer-events: none;
    position: absolute;
    transition: opacity var(--promo-transition-speed) ease;
    z-index: 1;
  }

  .hunter-promo-grid--overlay-gradient_bottom .hunter-promo-grid__shade {
    background: linear-gradient(to bottom, transparent 20%, var(--promo-overlay-color) 100%);
  }

  .hunter-promo-grid--overlay-gradient_center .hunter-promo-grid__shade {
    background: linear-gradient(to bottom, transparent 0%, var(--promo-overlay-color) 50%, transparent 100%);
  }

  .hunter-promo-grid__overlay {
    align-items: var(--promo-block-align);
    display: flex;
    inset: 0;
    justify-content: var(--promo-block-justify);
    margin: 0;
    padding: var(--promo-content-padding-desktop);
    pointer-events: none;
    position: absolute;
    text-align: var(--promo-block-text-align);
    z-index: 2;
  }

  .hunter-promo-grid__content {
    align-items: var(--promo-block-align);
    display: flex;
    flex-direction: column;
    gap: var(--promo-content-gap);
    max-width: var(--promo-content-width);
    transition: opacity var(--promo-transition-speed) ease, transform var(--promo-transition-speed) ease;
    width: 100%;
  }

  .hunter-promo-grid__title {
    color: var(--promo-title-color);
    font-family: var(--promo-title-font);
    font-size: var(--promo-title-size-desktop);
    font-weight: var(--promo-title-weight);
    letter-spacing: var(--promo-title-spacing);
    line-height: 1.05;
    margin: 0;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.42);
    text-transform: var(--promo-title-transform);
  }

  .hunter-promo-grid__description {
    color: var(--promo-description-color);
    font-family: var(--promo-description-font);
    font-size: var(--promo-description-size-desktop);
    line-height: 1.35;
    margin: 0;
  }

  .hunter-promo-grid__description p {
    color: inherit;
    line-height: inherit;
    margin: 0;
  }

  .hunter-promo-grid__button {
    background: var(--promo-button-background);
    border: 1px solid var(--promo-button-border);
    border-radius: var(--promo-button-radius);
    color: var(--promo-button-color);
    display: inline-flex;
    font-family: var(--promo-button-font);
    font-size: 13px;
    justify-content: center;
    letter-spacing: 0.08em;
    line-height: 1;
    margin-top: 4px;
    padding: 12px 18px;
    text-transform: var(--button-text-transform);
  }

  .hunter-promo-grid__inner:hover .hunter-promo-grid__image {
    transform: scale(var(--promo-hover-scale));
  }

  .hunter-promo-grid__inner:hover .hunter-promo-grid__shade {
    opacity: var(--promo-overlay-hover-opacity);
  }

  .hunter-promo-grid--content-hover .hunter-promo-grid__content {
    opacity: 0;
    transform: translateY(12px);
  }

  .hunter-promo-grid--content-hover .hunter-promo-grid__inner:hover .hunter-promo-grid__content,
  .hunter-promo-grid--content-hover .hunter-promo-grid__inner:focus-visible .hunter-promo-grid__content {
    opacity: 1;
    transform: none;
  }

  .hunter-promo-grid--animate.is-animation-ready:not(.is-visible) .hunter-promo-grid__item {
    opacity: 0;
  }

  .hunter-promo-grid--animate.is-visible .hunter-promo-grid__item {
    animation: hunter-promo-reveal 0.8s both;
    animation-delay: calc(var(--promo-index) * 0.16s);
  }

  @keyframes hunter-promo-reveal {
    from {
      opacity: 0;
      transform: var(--promo-enter-transform);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media screen and (max-width: 749px) {
    .hunter-promo-grid__header {
      margin-bottom: var(--promo-section-heading-spacing-mobile);
      padding: 0 16px;
    }

    .hunter-promo-grid__heading {
      font-size: var(--promo-section-heading-size-mobile);
    }

    .hunter-promo-grid__heading--theme {
      font-size: calc(var(--heading-font-size) * 1.6363636364);
      line-height: 1.3333333333;
    }

    .hunter-promo-grid__arrow {
      height: 38px;
      width: 38px;
    }

    .hunter-promo-grid__arrow svg {
      height: 20px;
      width: 20px;
    }

    .hunter-promo-grid__items {
      align-items: start;
      display: grid;
      gap: var(--promo-gap-mobile);
      grid-template-columns: repeat(var(--promo-columns-mobile), minmax(0, 1fr));
      overflow: hidden;
      scroll-snap-type: none;
      touch-action: pan-y;
      transition: height 320ms cubic-bezier(0.4, 0, 0.2, 1);
      width: 100%;
    }

    .hunter-promo-grid__item {
      --mobile-slide-shift-positive: calc(200% + var(--promo-gap-mobile));
      --mobile-slide-shift-negative: calc(-200% - var(--promo-gap-mobile));
      flex: none;
      grid-row: 1;
      opacity: 0 !important;
      pointer-events: none;
      transform: translateX(var(--mobile-slide-shift-positive)) !important;
      transition: transform 320ms cubic-bezier(0.4, 0, 0.2, 1), visibility 0s linear 320ms !important;
      visibility: hidden;
      width: auto;
      will-change: transform;
    }

    .hunter-promo-grid__item[data-mobile-column="1"] {
      grid-column: 1;
    }

    .hunter-promo-grid__item[data-mobile-column="2"] {
      grid-column: 2;
    }

    .hunter-promo-grid__item.is-mobile-active {
      opacity: 1 !important;
      pointer-events: auto;
      transform: translateX(0) !important;
      transition-delay: 0s;
      visibility: visible;
      z-index: 2;
    }

    .hunter-promo-grid__item.is-mobile-entering-from-left,
    .hunter-promo-grid__item.is-mobile-entering-from-right,
    .hunter-promo-grid__item.is-mobile-exiting-to-left,
    .hunter-promo-grid__item.is-mobile-exiting-to-right {
      opacity: 1 !important;
      pointer-events: none;
      visibility: visible;
    }

    .hunter-promo-grid__item.is-mobile-entering-from-left {
      transform: translateX(var(--mobile-slide-shift-negative)) !important;
      transition: none !important;
      z-index: 2;
    }

    .hunter-promo-grid__item.is-mobile-entering-from-right {
      transform: translateX(var(--mobile-slide-shift-positive)) !important;
      transition: none !important;
      z-index: 2;
    }

    .hunter-promo-grid__item.is-mobile-exiting-to-left {
      transform: translateX(var(--mobile-slide-shift-negative)) !important;
      z-index: 1;
    }

    .hunter-promo-grid__item.is-mobile-exiting-to-right {
      transform: translateX(var(--mobile-slide-shift-positive)) !important;
      z-index: 1;
    }

    .hunter-promo-grid__pagination {
      align-items: center;
      display: flex;
      gap: 5px;
      justify-content: center;
      margin: 18px auto 0;
      width: min(175px, 100%);
    }

    .hunter-promo-grid__page {
      appearance: none;
      background: #d5d8d6;
      border: 0;
      border-radius: 2px;
      cursor: pointer;
      flex: 0 0 40px;
      height: 4px;
      margin: 0;
      padding: 0;
      transition: background-color 180ms ease;
      width: 40px;
    }

    .hunter-promo-grid__page.is-active {
      background: var(--promo-section-heading-color);
    }

    .hunter-promo-grid__page:focus-visible {
      outline: 2px solid var(--promo-section-heading-color);
      outline-offset: 3px;
    }

    .hunter-promo-grid[data-mobile-peek] .hunter-promo-grid__items {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      touch-action: auto;
    }

    .hunter-promo-grid[data-mobile-peek] .hunter-promo-grid__item {
      flex: 0 0 76%;
      opacity: 1 !important;
      pointer-events: auto;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      transform: none !important;
      transition: none !important;
      visibility: visible;
      will-change: auto;
    }

    .hunter-promo-grid[data-mobile-peek] .hunter-promo-grid__pagination {
      width: min(240px, 100%);
    }

    .hunter-promo-grid[data-mobile-peek] .hunter-promo-grid__page {
      flex: 1 1 0;
      min-width: 0;
      width: auto;
    }

    .hunter-promo-grid__overlay {
      padding: var(--promo-content-padding-mobile);
    }

    .hunter-promo-grid__title {
      font-size: var(--promo-title-size-mobile);
    }

    .hunter-promo-grid__description {
      font-size: var(--promo-description-size-mobile);
    }

    .hunter-promo-grid__button {
      font-size: 11px;
      padding: 9px 12px;
    }

    .hunter-promo-grid--content-hover .hunter-promo-grid__content {
      opacity: 1;
      transform: none;
    }
  }

  @media screen and (min-width: 750px) {
    .hunter-promo-grid__viewport {
      overflow: visible;
    }

    .hunter-promo-grid__controls--desktop {
      align-items: center;
      background: #ffffff;
      border: 1px solid rgba(44, 61, 51, 0.28);
      border-radius: 2px;
      display: flex;
      gap: 0;
      margin-left: auto;
      overflow: hidden;
      pointer-events: auto;
      position: static;
    }

    .hunter-promo-grid__controls--desktop .hunter-promo-grid__arrow--desktop {
      background: rgba(255, 255, 255, 0.92);
      border: 0;
      border-radius: 0;
      height: 44px;
      pointer-events: auto;
      position: static;
      transform: none;
      width: 40px;
    }

    .hunter-promo-grid__controls--desktop .hunter-promo-grid__arrow--desktop + .hunter-promo-grid__arrow--desktop {
      border-left: 1px solid rgba(44, 61, 51, 0.2);
    }

    .hunter-promo-grid__controls--desktop .hunter-promo-grid__arrow--desktop svg {
      height: 26px;
      width: 26px;
    }

    .hunter-promo-grid__controls--desktop .hunter-promo-grid__arrow--desktop:hover:not(:disabled),
    .hunter-promo-grid__controls--desktop .hunter-promo-grid__arrow--desktop:focus-visible {
      background: #f3f5f4;
      color: var(--promo-section-heading-color);
    }

    .hunter-promo-grid__controls--desktop .hunter-promo-grid__arrow--desktop:disabled {
      color: rgba(44, 61, 51, 0.32);
      opacity: 1;
    }
  }

  @media screen and (min-width: 768px) {
    .hunter-promo-grid__heading--theme {
      font-size: calc(var(--heading-font-size) * 1.9375);
    }
  }

  @media screen and (min-width: 1200px) {
    .hunter-promo-grid__header {
      padding-left: 64px;
      padding-right: 64px;
    }

    .hunter-promo-grid:not(.hunter-promo-grid--full-width) {
      padding-left: 64px;
      padding-right: 64px;
    }

    .hunter-promo-grid:not(.hunter-promo-grid--full-width) .hunter-promo-grid__header {
      padding-left: 0;
      padding-right: 0;
    }

    .hunter-promo-grid__heading--theme {
      font-size: calc(var(--heading-font-size) * 2.18);
      line-height: 1.2083333333;
    }
  }

  .hunter-promo-grid__container .hunter-promo-grid__header {
    padding-left: 0;
    padding-right: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hunter-promo-grid--animate.is-animation-ready:not(.is-visible) .hunter-promo-grid__item {
      opacity: 1;
    }

    .hunter-promo-grid--animate.is-visible .hunter-promo-grid__item {
      animation: none;
    }

    .hunter-promo-grid__image,
    .hunter-promo-grid__shade,
    .hunter-promo-grid__content {
      transition: none;
    }

    .hunter-promo-grid__items {
      scroll-behavior: auto;
    }
  }
{% endstylesheet %}

<script>
  (function() {
    var section = document.getElementById('hunter-promo-{{ section.id }}');
    if (!section) return;

    var track = section.querySelector('[data-promo-track]');
    var controlGroups = Array.prototype.slice.call(section.querySelectorAll('[data-promo-controls]'));
    var previousButtons = Array.prototype.slice.call(section.querySelectorAll('[data-promo-previous]'));
    var nextButtons = Array.prototype.slice.call(section.querySelectorAll('[data-promo-next]'));
    var pagination = section.querySelector('[data-promo-pagination]');

    if (track && controlGroups.length && previousButtons.length && nextButtons.length) {
      var items = Array.prototype.slice.call(track.querySelectorAll('.hunter-promo-grid__item'));
      var currentPage = 0;
      var isAnimating = false;
      var animationTimer;
      var pointerStartX = null;
      var pointerStartY = null;
      var resizeTimer;
      var scrollTimer;
      var mobileMedia = window.matchMedia('(max-width: 749px)');
      var mobilePeek = section.hasAttribute('data-mobile-peek');
      var loopClones = [];
      var loopFirstClone;
      var loopLastClone;
      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      var motionClasses = [
        'is-mobile-entering-from-left',
        'is-mobile-entering-from-right',
        'is-mobile-exiting-to-left',
        'is-mobile-exiting-to-right'
      ];

      function getColumns() {
        if (mobileMedia.matches && mobilePeek) return 1;
        var value = mobileMedia.matches
          ? track.getAttribute('data-columns-mobile')
          : track.getAttribute('data-columns-desktop');
        return Math.max(1, parseInt(value, 10) || 1);
      }

      function getPageCount() {
        return Math.max(1, Math.ceil(items.length / getColumns()));
      }

      function usesPagedMobile() {
        return mobileMedia.matches && !mobilePeek;
      }

      function usesMobileLoop() {
        return mobileMedia.matches && mobilePeek && items.length > 1;
      }

      function syncLoopClones() {
        if (!usesMobileLoop()) {
          loopClones.forEach(function(clone) { clone.remove(); });
          loopClones = [];
          loopFirstClone = null;
          loopLastClone = null;
          return;
        }
        if (loopClones.length) return;

        function copyItem(item) {
          var clone = item.cloneNode(true);
          clone.setAttribute('data-promo-loop-clone', '');
          clone.setAttribute('aria-hidden', 'true');
          clone.removeAttribute('id');
          clone.removeAttribute('data-shopify-editor-block');
          clone.querySelectorAll('[id]').forEach(function(element) {
            element.removeAttribute('id');
          });
          clone.querySelectorAll('a, button, [tabindex]').forEach(function(element) {
            element.setAttribute('tabindex', '-1');
          });
          clone.querySelectorAll('img').forEach(function(image) {
            image.loading = 'eager';
          });
          loopClones.push(clone);
          return clone;
        }

        // Two copies on each side also fill the partial next-card preview.
        items.slice(-2).forEach(function(item) {
          loopLastClone = copyItem(item);
          track.insertBefore(loopLastClone, items[0]);
        });
        items.slice(0, 2).forEach(function(item, index) {
          var clone = copyItem(item);
          if (index === 0) loopFirstClone = clone;
          track.appendChild(clone);
        });
      }

      function getItemOffset(item) {
        return item.getBoundingClientRect().left - track.getBoundingClientRect().left + track.scrollLeft;
      }

      function getPageOffset(page) {
        var target = items[Math.min(page * getColumns(), items.length - 1)];
        if (!target) return 0;
        return getItemOffset(target);
      }

      function getPageItems(page) {
        var columns = getColumns();
        return items.slice(page * columns, (page + 1) * columns);
      }

      function updateTrackHeight() {
        if (!usesPagedMobile()) {
          track.style.removeProperty('height');
          return;
        }

        var activeHeight = getPageItems(currentPage).reduce(function(height, item) {
          return Math.max(height, Math.ceil(item.getBoundingClientRect().height));
        }, 0);

        if (activeHeight > 0) track.style.height = activeHeight + 'px';
      }

      function cancelItemAnimations() {
        items.forEach(function(item) {
          if (typeof item.getAnimations !== 'function') return;
          item.getAnimations().forEach(function(animation) {
            animation.cancel();
          });
        });
      }

      function updatePagination() {
        if (!pagination) return;

        var pageCount = getPageCount();

        if (!mobileMedia.matches || pageCount <= 1) {
          pagination.hidden = true;
          pagination.innerHTML = '';
          return;
        }

        pagination.hidden = false;

        if (pagination.children.length !== pageCount) {
          pagination.innerHTML = '';

          for (var page = 0; page < pageCount; page += 1) {
            var button = document.createElement('button');
            button.type = 'button';
            button.className = 'hunter-promo-grid__page';
            button.setAttribute('aria-label', 'Go to collection group ' + (page + 1));
            button.setAttribute('data-promo-page', page);
            pagination.appendChild(button);
          }
        }

        Array.prototype.forEach.call(pagination.children, function(button, page) {
          var isActive = page === currentPage;
          button.classList.toggle('is-active', isActive);

          if (isActive) {
            button.setAttribute('aria-current', 'page');
          } else {
            button.removeAttribute('aria-current');
          }
        });
      }

      function updateControls() {
        var pageCount = getPageCount();
        currentPage = Math.max(0, Math.min(currentPage, pageCount - 1));
        controlGroups.forEach(function(controls) {
          controls.hidden = pageCount <= 1;
        });
        previousButtons.forEach(function(button) {
          button.disabled = !usesMobileLoop() && currentPage === 0;
        });
        nextButtons.forEach(function(button) {
          button.disabled = !usesMobileLoop() && currentPage >= pageCount - 1;
        });
        updatePagination();
      }

      function renderMode() {
        window.clearTimeout(animationTimer);
        window.clearTimeout(scrollTimer);
        isAnimating = false;
        syncLoopClones();
        updateControls();

        if (!usesPagedMobile()) {
          items.forEach(function(item) {
            item.classList.remove('is-mobile-active');
            item.classList.remove.apply(item.classList, motionClasses);
            item.removeAttribute('aria-hidden');
          });
          track.style.removeProperty('height');
          track.scrollTo({ left: getPageOffset(currentPage), behavior: 'instant' });
          return;
        }

        var activeItems = getPageItems(currentPage);
        track.scrollLeft = 0;
        items.forEach(function(item) {
          var isActive = activeItems.indexOf(item) !== -1;
          item.classList.remove.apply(item.classList, motionClasses);
          item.classList.toggle('is-mobile-active', isActive);
          item.setAttribute('aria-hidden', isActive ? 'false' : 'true');
        });
        window.requestAnimationFrame(updateTrackHeight);
      }

      function goToPage(page, instant) {
        var pageCount = getPageCount();
        var nextPage = usesMobileLoop()
          ? ((page % pageCount) + pageCount) % pageCount
          : Math.max(0, Math.min(page, pageCount - 1));

        if (usesPagedMobile()) {
          if (isAnimating || nextPage === currentPage) return;
          cancelItemAnimations();

          var currentItems = getPageItems(currentPage);
          var incomingItems = getPageItems(nextPage);
          var movingForward = nextPage > currentPage;
          var enteringClass = movingForward ? 'is-mobile-entering-from-right' : 'is-mobile-entering-from-left';
          var exitingClass = movingForward ? 'is-mobile-exiting-to-left' : 'is-mobile-exiting-to-right';
          var animationDuration = instant || reducedMotion.matches ? 0 : 320;

          if (instant) {
            currentPage = nextPage;
            renderMode();
            return;
          }

          isAnimating = true;
          incomingItems.forEach(function(item) {
            item.classList.remove.apply(item.classList, motionClasses);
            item.classList.add(enteringClass);
            item.setAttribute('aria-hidden', 'false');
          });
          track.getBoundingClientRect();

          window.requestAnimationFrame(function() {
            currentItems.forEach(function(item) {
              item.classList.add(exitingClass);
            });
            incomingItems.forEach(function(item) {
              item.classList.add('is-mobile-active');
              item.classList.remove(enteringClass);
            });
            currentPage = nextPage;
            updateControls();
            window.requestAnimationFrame(updateTrackHeight);

            animationTimer = window.setTimeout(function() {
              currentItems.forEach(function(item) {
                item.classList.remove('is-mobile-active', exitingClass);
                item.setAttribute('aria-hidden', 'true');
              });
              incomingItems.forEach(function(item) {
                item.classList.remove.apply(item.classList, motionClasses);
              });
              isAnimating = false;
              updateTrackHeight();
            }, animationDuration + 40);
          });
          return;
        }

        var targetOffset = getPageOffset(nextPage);
        if (usesMobileLoop() && !instant) {
          if (page >= pageCount || (currentPage === pageCount - 1 && nextPage === 0)) {
            targetOffset = getItemOffset(loopFirstClone);
          } else if (page < 0 || (currentPage === 0 && nextPage === pageCount - 1)) {
            targetOffset = getItemOffset(loopLastClone);
          }
        }
        currentPage = nextPage;
        track.scrollTo({
          left: targetOffset,
          behavior: instant || reducedMotion.matches ? 'instant' : 'smooth'
        });
        updateControls();
      }

      function syncPageFromScroll() {
        if (usesPagedMobile()) return;

        if (usesMobileLoop()) {
          var firstOffset = getPageOffset(0);
          var loopWidth = getItemOffset(loopFirstClone) - firstOffset;
          var relativeOffset = track.scrollLeft - firstOffset;
          if (relativeOffset < -1 || relativeOffset >= loopWidth - 1) {
            // Jump between identical copies only after scrolling settles.
            var wrappedOffset = relativeOffset < 0 ? relativeOffset + loopWidth : relativeOffset - loopWidth;
            track.scrollTo({ left: firstOffset + wrappedOffset, behavior: 'instant' });
          }
        }

        var pageCount = getPageCount();
        var nearestPage = 0;
        var nearestDistance = Infinity;

        for (var page = 0; page < pageCount; page += 1) {
          var distance = Math.abs(track.scrollLeft - getPageOffset(page));
          if (distance < nearestDistance) {
            nearestDistance = distance;
            nearestPage = page;
          }
        }

        currentPage = nearestPage;
        updateControls();
      }

      function onPointerDown(event) {
        if (!usesPagedMobile() || event.pointerType === 'mouse') return;
        pointerStartX = event.clientX;
        pointerStartY = event.clientY;
      }

      function onPointerUp(event) {
        if (!usesPagedMobile() || pointerStartX === null || pointerStartY === null) return;

        var deltaX = event.clientX - pointerStartX;
        var deltaY = event.clientY - pointerStartY;
        pointerStartX = null;
        pointerStartY = null;

        if (Math.abs(deltaX) < 44 || Math.abs(deltaX) <= Math.abs(deltaY)) return;
        goToPage(currentPage + (deltaX < 0 ? 1 : -1), false);
      }

      function onPointerCancel() {
        pointerStartX = null;
        pointerStartY = null;
      }

      previousButtons.forEach(function(button) {
        button.addEventListener('click', function() {
          goToPage(currentPage - 1, false);
        });
      });

      nextButtons.forEach(function(button) {
        button.addEventListener('click', function() {
          goToPage(currentPage + 1, false);
        });
      });

      if (pagination) {
        pagination.addEventListener('click', function(event) {
          var button = event.target.closest('[data-promo-page]');
          if (!button || !pagination.contains(button)) return;
          goToPage(parseInt(button.getAttribute('data-promo-page'), 10), false);
        });
      }

      track.addEventListener('keydown', function(event) {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        goToPage(currentPage + (event.key === 'ArrowRight' ? 1 : -1), false);
      });

      track.addEventListener('scroll', function() {
        if (usesPagedMobile()) return;
        window.clearTimeout(scrollTimer);
        scrollTimer = window.setTimeout(syncPageFromScroll, 120);
      }, { passive: true });

      track.addEventListener('pointerdown', onPointerDown);
      track.addEventListener('pointerup', onPointerUp);
      track.addEventListener('pointercancel', onPointerCancel);

      if (mobileMedia.addEventListener) {
        mobileMedia.addEventListener('change', renderMode);
      } else {
        mobileMedia.addListener(renderMode);
      }

      window.addEventListener('resize', function() {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(function() {
          if (usesPagedMobile()) {
            updateTrackHeight();
          } else {
            goToPage(currentPage, true);
          }
        }, 120);
      });

      renderMode();
    }

    if (!section.classList.contains('hunter-promo-grid--animate')) return;

    section.classList.add('is-animation-ready');

    function revealSection() {
      section.classList.add('is-visible');
    }

    if (!('IntersectionObserver' in window)) {
      revealSection();
      return;
    }

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (!entry.isIntersecting) return;
        revealSection();
        observer.unobserve(section);
      });
    }, {
      rootMargin: '0px 0px -8% 0px',
      threshold: 0.08
    });

    observer.observe(section);
  })();
</script>

{% schema %}
{
  "name": "Promotion image grid",
  "class": "hunter-promo-grid-wrapper",
  "disabled_on": {
    "groups": ["header", "footer", "custom.popup"]
  },
  "max_blocks": 8,
  "blocks": [
    {
      "type": "collection",
      "name": "Image promotion",
      "settings": [
        {
          "type": "header",
          "content": "Image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "external_image_url",
          "label": "External image URL",
          "info": "Overrides the selected image and keeps its original ratio."
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Image alt text"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "options": [
            { "value": "inherit", "label": "Use section setting" },
            { "value": "center top", "label": "Top" },
            { "value": "center center", "label": "Center" },
            { "value": "center bottom", "label": "Bottom" }
          ],
          "default": "inherit"
        },
        {
          "type": "header",
          "content": "Link and content"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Fallback collection",
          "info": "Used for the image, heading, and link when those fields are empty."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Supporting text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content position",
          "options": [
            { "value": "inherit", "label": "Use section setting" },
            { "value": "top", "label": "Top" },
            { "value": "center", "label": "Center" },
            { "value": "bottom", "label": "Bottom" }
          ],
          "default": "inherit"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Text alignment",
          "options": [
            { "value": "inherit", "label": "Use section setting" },
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "inherit"
        },
        {
          "type": "header",
          "content": "Custom overlay"
        },
        {
          "type": "checkbox",
          "id": "use_custom_overlay",
          "label": "Override section overlay",
          "default": false
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "Overlay color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 100,
