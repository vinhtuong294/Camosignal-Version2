{% comment %}
------------------------------------------------------------------------------
  Snippet: Product breadcrumbs
------------------------------------------------------------------------------
{% endcomment %}

{%- capture styles -%}
	--offset-top-desktop: {{ block.settings.offset_top_desktop }}px; {{-  -}}
	--offset-bottom-desktop: {{ block.settings.offset_bottom_desktop }}px; {{-  -}}
	--offset-top-mobile: {{ block.settings.offset_top_mobile }}px; {{-  -}}
	--offset-bottom-mobile: {{ block.settings.offset_bottom_mobile }}px;
{%- endcapture -%}

{% capture breadcrumb_seperator %}
	<span aria-hidden="true" class="product-breadcrumbs__separator">·</span>
{% endcapture %}

{%- assign parent_collection = collection -%}

{%- if parent_collection == blank or parent_collection.handle == 'all' -%}
	{%- assign parent_collection = product.collections.first -%}

	{%- for product_collection in product.collections -%}
		{%- unless product_collection.handle == 'all' or product_collection.handle == 'frontpage' -%}
			{%- assign parent_collection = product_collection -%}
			{%- break -%}
		{%- endunless -%}
	{%- endfor -%}
{%- endif -%}

{%- assign home_label = 'general.breadcrumbs.home' | t | downcase -%}
{%- assign parent_collection_label = parent_collection.title | downcase -%}

<nav
	class="product-breadcrumbs"
	aria-label="{{ 'general.breadcrumbs.title' | t | escape }}"
	style="{{- styles -}}"
>
	<div class="product-breadcrumbs__container">
		<a
			class="product-breadcrumbs__link"
			href="{{ routes.root_url }}"
			title="{{ home_label | escape }}"
		>
			{{ home_label }}
		</a>

		{% if parent_collection != blank %}
			<span aria-hidden="true" class="product-breadcrumbs__separator">&gt;</span>
			{{ parent_collection_label | link_to: parent_collection.url, class: 'product-breadcrumbs__item product-breadcrumbs__link' }}
		{% endif %}
	</div>
</nav>
