{% doc %}
Renders the shared storefront product card with variant images, solid color swatches, ratings, special collection tags, and pricing.

@param {product} product - Product to render.
@param {collection} [collection] - Collection context used for special product tag badges.
@param {number} [size] - Desktop image width.
@param {number} [tablet_size] - Tablet image width.
@param {number} [mobile_size] - Mobile image width.
@param {boolean} [is_lazy] - Whether the primary image should lazy load.

@example
{% render 'product-card', product: product, collection: collection, size: 439, tablet_size: 360, mobile_size: 220 %}
{% enddoc %}

{%- if product.handle == 'shipping-protection-apparel' -%}
	<script>
		(function () {
			var script = document.currentScript;
			var wrapper = script && script.closest('.collection__item, .swiper-slide, .grid__item, .product-card-container, li');
			if (wrapper) wrapper.remove();
		})();
	</script>
{%- else -%}
	{%- render 'adastra' with '/src/styles/product-card.scss' -%}

	{%- liquid
		assign swatches_enabled = settings.is_color_swatches_enabled
		assign is_image_on_hover_enabled = settings.is_image_on_hover_enabled
		assign configured_swatch_names = settings.color_swatches_option | default: 'Color' | downcase | split: ','
		assign currency_code_enabled = settings.is_currency_code_enabled
		assign product_card_url = product.url
		if collection != blank
			assign product_card_url = product.url | within: collection
		endif
		assign size = size | default: 439
		assign tablet_size = tablet_size | default: size
		assign mobile_size = mobile_size | default: tablet_size
		assign has_swatch = false
		assign swatches = blank
		assign swatch_pos = 0
		assign special_collection_handles = ',world-turkey-slam,grand-slam-subspecies,'
		assign card_collection_handle = collection.handle | default: ''
		assign tag_badge_class = blank
		assign tag_badge_label = blank
		assign tag_badge_image = blank
		assign has_comfort_tag = false
		assign has_bella_tag = false
		assign has_vneck_tag = false
		assign has_tanktop_tag = false
		assign has_longsleeve_tag = false
		assign has_wash_tag = false
		assign has_sweater_tag = false
		assign has_hoodie_tag = false
		assign has_gildan_tag = false
		assign has_colorblast_tag = false
		assign has_trucker_tag = false
		assign best_value_product_handles = '|let-us-thank-him-for-our-food-hoodie|the-genesis-turkey-hoodie|provided-by-him-hoodie|'
		assign product_handle_key = product.handle | prepend: '|' | append: '|'
		assign is_best_value_product = false
		if best_value_product_handles contains product_handle_key
			assign is_best_value_product = true
		endif

		if is_lazy == nil
			assign is_lazy = true
		endif

		assign card_hover_image = blank
		if product != blank and is_image_on_hover_enabled and product.images.size > 1
			assign card_hover_image = product.images[1]
		endif

		if card_collection_handle == blank
			if request.path contains '/collections/world-turkey-slam'
				assign card_collection_handle = 'world-turkey-slam'
			elsif request.path contains '/collections/grand-slam-subspecies'
				assign card_collection_handle = 'grand-slam-subspecies'
			elsif request.path contains '/collections/spooky-kids-tee'
				assign card_collection_handle = 'spooky-kids-tee'
			elsif request.path contains '/collections/halloween-dog-t-shirt'
				assign card_collection_handle = 'halloween-dog-t-shirt'
			endif
		endif

		assign is_spooky_card = false
		if card_collection_handle == 'spooky-kids-tee' or card_collection_handle == 'halloween-dog-t-shirt'
			assign is_spooky_card = true
		endif

		if product != blank and swatches_enabled
			for option in product.options_with_values
				assign option_name = option.name | downcase
				assign native_swatch_count = option.values | map: 'swatch' | compact | size

				if native_swatch_count > 0
					assign swatches = option.values
					assign swatch_pos = option.position | minus: 1
					assign has_swatch = true
					break
				endif

				for configured_name in configured_swatch_names
					assign configured_name = configured_name | strip
					if option_name == configured_name
						assign swatches = option.values
						assign swatch_pos = option.position | minus: 1
						assign has_swatch = true
						break
					endif
				endfor

				if has_swatch
					break
				endif
			endfor
		endif

		assign selected_color = blank
		if product != blank and has_swatch
			assign selected_color = product.selected_or_first_available_variant.options[swatch_pos]
		endif
		if selected_color == blank and swatches != blank
			assign selected_color = swatches.first.name | default: swatches.first
		endif

		assign card_title = 'products.product_card.product_title' | t
		if product != blank
			assign card_title = product.title
		endif

		assign wrapped_collection_handle = ',' | append: card_collection_handle | append: ','
		if product != blank and special_collection_handles contains wrapped_collection_handle
			for product_tag in product.tags
				assign product_tag_handle = product_tag | handleize
				if product_tag_handle contains 'colorblast' or product_tag_handle contains 'color-blast'
					assign has_colorblast_tag = true
				endif
				if product_tag_handle contains 'trucker'
					assign has_trucker_tag = true
				endif
				if product_tag_handle contains 'wash'
					assign has_wash_tag = true
				endif
				if product_tag_handle contains 'sweater' or product_tag_handle contains 'sweatshirt'
					assign has_sweater_tag = true
				endif
				if product_tag_handle contains 'hoodie'
					assign has_hoodie_tag = true
				endif
				if product_tag_handle contains 'gildan'
					assign has_gildan_tag = true
				endif
				if product_tag_handle contains 'comfort'
					assign has_comfort_tag = true
				elsif product_tag_handle contains 'bella'
					assign has_bella_tag = true
				elsif product_tag_handle contains 'vneck' or product_tag_handle contains 'v-neck'
					assign has_vneck_tag = true
				elsif product_tag_handle contains 'tanktop' or product_tag_handle contains 'tank-top'
					assign has_tanktop_tag = true
				elsif product_tag_handle contains 'longsleevetee' or product_tag_handle contains 'long-sleeve-tee' or product_tag_handle contains 'longsleeve' or product_tag_handle contains 'long-sleeve'
					assign has_longsleeve_tag = true
				endif
			endfor

			if has_trucker_tag
				assign tag_badge_class = 'trucker'
				assign tag_badge_label = 'Trucker cap'
				assign tag_badge_image = 'https://cdn.shopify.com/s/files/1/0741/7987/0911/files/Trucker_Cap.png?v=1779882764'
			elsif has_colorblast_tag
				assign tag_badge_class = 'colorblast'
				assign tag_badge_label = 'Colorblast tee'
				assign tag_badge_image = 'https://cdn.shopify.com/s/files/1/0741/7987/0911/files/colorblast_tee.png?v=1779866400'
			elsif has_wash_tag
				assign tag_badge_class = 'wash'
				assign tag_badge_label = 'Washed tee'
				assign tag_badge_image = 'https://cdn.shopify.com/s/files/1/0741/7987/0911/files/wash_tee.png?v=1779866551'
			elsif has_sweater_tag
				assign tag_badge_class = 'sweater'
				assign tag_badge_label = 'Sweater'
				assign tag_badge_image = 'https://cdn.shopify.com/s/files/1/0741/7987/0911/files/Class_sweater.png?v=1779866507'
			elsif has_hoodie_tag
				assign tag_badge_class = 'hoodie'
				assign tag_badge_label = 'Hoodie'
				assign tag_badge_image = 'https://cdn.shopify.com/s/files/1/0741/7987/0911/files/Classic_hoodie.png?v=1779866453'
			elsif has_comfort_tag
				assign tag_badge_class = 'comfort'
				assign tag_badge_label = 'Comfort Colors'
				assign tag_badge_image = 'https://cdn.shopify.com/s/files/1/0741/7987/0911/files/1.png?v=1779782675'
			elsif has_bella_tag
				assign tag_badge_class = 'bella'
				assign tag_badge_label = 'Bella'
				assign tag_badge_image = 'https://cdn.shopify.com/s/files/1/0741/7987/0911/files/2.png?v=1779782724'
			elsif has_vneck_tag
				assign tag_badge_class = 'vneck'
				assign tag_badge_label = 'V-neck'
				assign tag_badge_image = 'https://cdn.shopify.com/s/files/1/0741/7987/0911/files/3.png?v=1779782792'
			elsif has_tanktop_tag
				assign tag_badge_class = 'tanktop'
				assign tag_badge_label = 'Tank top'
				assign tag_badge_image = 'https://cdn.shopify.com/s/files/1/0741/7987/0911/files/4.png?v=1779782848'
			elsif has_longsleeve_tag
				assign tag_badge_class = 'longsleeve-tee'
				assign tag_badge_label = 'Long-sleeve tee'
				assign tag_badge_image = 'https://cdn.shopify.com/s/files/1/0741/7987/0911/files/tag_long_sleeve_tee.png?v=1779782923'
			elsif has_gildan_tag
				assign tag_badge_class = 'gildan'
				assign tag_badge_label = 'Gildan tee'
				assign tag_badge_image = 'https://cdn.shopify.com/s/files/1/0741/7987/0911/files/Classic_tee.png?v=1779866319'
			endif
		endif

		assign card_price = product.price | default: 1999
		assign card_compare_at_price = product.compare_at_price
		assign is_on_sale = false
		assign sale_percentage = 0
		if card_compare_at_price > card_price
			assign is_on_sale = true
			assign sale_percentage = card_compare_at_price | minus: card_price | times: 100.0 | divided_by: card_compare_at_price | floor
		endif

		if currency_code_enabled
			assign card_price_money = card_price | money_with_currency
			assign card_compare_at_price_money = card_compare_at_price | money_with_currency
		else
			assign card_price_money = card_price | money
			assign card_compare_at_price_money = card_compare_at_price | money
		endif
	-%}

	{%- capture selected_color_label -%}
		{%- assign selected_color_words = selected_color | split: ' ' -%}
		{%- for color_word in selected_color_words -%}
			{{- color_word | downcase | capitalize -}}{%- unless forloop.last %} {% endunless -%}
		{%- endfor -%}
	{%- endcapture -%}

	<article
		class="product-card product-card--reference{% if is_spooky_card %} product-card--spooky{% endif %} js-product-card"
		{% if product != blank %}data-existing-product{% endif %}
		{% if product.template_suffix == 'pre-order' %}data-preorder{% endif %}
	>
		<div class="product-card__main" data-product-card-handle="{{- product.handle -}}">
			<a
				href="{{- product_card_url -}}"
				class="product-card__image-wrapper-link"
				aria-label="{{- card_title | escape -}}"
			>
				{%- if product == blank -%}
					<div class="product-card__image-wrapper product-card__image-wrapper--reference is-active">
						{{- 'product-1' | placeholder_svg_tag: 'product-card__image product-card__image--placeholder' -}}
					</div>
				{%- elsif has_swatch and product.variants.size > 1 -%}
					{%- for swatch in swatches -%}
						{%- liquid
							assign swatch_name = swatch.name | default: swatch
							assign swatch_variant = swatch.variant
							assign swatch_image = swatch_variant.featured_image

							if swatch_image == blank
								for variant in product.variants
									if variant.options[swatch_pos] == swatch_name and variant.featured_image != blank
										assign swatch_variant = variant
										assign swatch_image = variant.featured_image
										break
									endif
								endfor
							endif

							assign swatch_image = swatch_image | default: product.featured_image | default: settings.product_default_image
							assign swatch_has_hover_image = false
							if card_hover_image != blank and card_hover_image.id != swatch_image.id
								assign swatch_has_hover_image = true
							endif
							assign swatch_is_active = false
							if swatch_name == selected_color
								assign swatch_is_active = true
							elsif selected_color == blank and forloop.first
								assign swatch_is_active = true
							endif

							assign swatch_image_is_lazy = true
							if swatch_is_active and is_lazy == false
								assign swatch_image_is_lazy = false
							endif
						-%}

						<div
							class="product-card__image-wrapper product-card__image-wrapper--reference js-product-card-images-wrapper{% if swatch_has_hover_image %} product-card__image-wrapper--with-hover{% endif %}{% if swatch_is_active %} is-active{% endif %}"
							data-image="{{- swatch_name | escape -}}"
							data-variant="{{- swatch_variant.id -}}"
						>
							{%- render 'product-card-image',
								product: product,
								is_lazy: swatch_image_is_lazy,
								image: swatch_image,
								is_hover_image: false,
								size: size,
								tablet_size: tablet_size,
								mobile_size: mobile_size
							-%}
							{%- if swatch_has_hover_image -%}
								{%- render 'product-card-image',
									product: product,
									is_lazy: true,
									image: card_hover_image,
									is_hover_image: true,
									size: size,
									tablet_size: tablet_size,
									mobile_size: mobile_size
								-%}
							{%- endif -%}
						</div>
					{%- endfor -%}
				{%- else -%}
					{%- assign card_image = product.featured_image | default: settings.product_default_image -%}
					<div class="product-card__image-wrapper product-card__image-wrapper--reference{% if card_hover_image != blank and card_hover_image.id != card_image.id %} product-card__image-wrapper--with-hover{% endif %} is-active">
						{%- render 'product-card-image',
							product: product,
							is_lazy: is_lazy,
							image: card_image,
							is_hover_image: false,
							size: size,
							tablet_size: tablet_size,
							mobile_size: mobile_size
						-%}
						{%- if card_hover_image != blank and card_hover_image.id != card_image.id -%}
							{%- render 'product-card-image',
								product: product,
								is_lazy: true,
								image: card_hover_image,
								is_hover_image: true,
								size: size,
								tablet_size: tablet_size,
								mobile_size: mobile_size
							-%}
						{%- endif -%}
					</div>
				{%- endif -%}
			</a>

			{%- if is_on_sale -%}
				<span class="product-card__discount product-card__discount--image">
					{%- if is_best_value_product -%}
						BEST VALUE
					{%- else -%}
						{{- 'products.product.sale_percentage_label' | t: number: sale_percentage -}}
					{%- endif -%}
				</span>
			{%- endif -%}

			{%- if tag_badge_image != blank -%}
				<div
					class="product-card__tag-badge product-card__tag-badge--{{- tag_badge_class -}}"
					role="img"
					aria-label="{{- tag_badge_label | escape -}}"
				>
					<img
						class="product-card__tag-badge-image"
						src="{{- tag_badge_image -}}"
						alt=""
						width="394"
						height="116"
						loading="lazy"
					>
				</div>
			{%- endif -%}
		</div>

		<div class="product-card__footer">
			{%- if has_swatch and swatches != blank -%}
				<div class="product-card__swatches-block">
					<p class="product-card__color-label">
						<span>{{- 'products.product_card.color_label' | t -}}</span>
						<span class="js-product-card-color-label">{{- selected_color_label | escape -}}</span>
					</p>

					{%- render 'product-card-swatches',
						swatches: swatches,
						selected_color: selected_color
					-%}
				</div>
			{%- endif -%}

			<a class="product-card__title" href="{{- product_card_url -}}">
				{{- card_title -}}
			</a>

			<div class="product-card__rating" aria-label="{{- 'products.product_card.rating_label' | t -}}">
				{%- if product != blank -%}
					<div class="jdgm-widget jdgm-preview-badge" data-id="{{- product.id -}}" data-auto-install="false">
						{{- product.metafields.judgeme.badge -}}
					</div>
				{%- endif -%}
			</div>

			<div class="product-card__price">
				{%- if is_on_sale -%}
					<span class="visually-hidden">{{- 'products.product.price.regular_price' | t -}}</span>
					<s class="product-card__compare-price">{{- card_compare_at_price_money -}}</s>
					<span class="visually-hidden">{{- 'products.product.price.sale_price' | t -}}</span>
					<span class="product-card__sale-price">{{- card_price_money -}}</span>
				{%- else -%}
					<span class="product-card__regular-price">{{- card_price_money -}}</span>
				{%- endif -%}
			</div>
		</div>
	</article>
{%- endif -%}

	{% stylesheet %}
		.product-card.product-card--reference {
			display: flex;
			width: 100%;
			min-width: 0;
			height: auto !important;
			min-height: 0 !important;
			box-sizing: border-box;
			flex-direction: column;
			overflow: visible !important;
			border: 0 !important;
			border-radius: 0 !important;
			background: transparent !important;
			box-shadow: none !important;
			font-family: var(--base-font-family), Arial, Helvetica, sans-serif !important;
		}

		.product-card.product-card--reference:hover {
			transform: none !important;
			box-shadow: none !important;
		}

		.product-card.product-card--reference .product-card__main {
			position: relative;
			display: block;
			width: 100%;
			min-width: 0;
			flex: 0 0 auto;
			border: 0 !important;
		}

		.product-card.product-card--reference .product-card__image-wrapper-link {
			display: block;
			width: 100%;
			overflow: hidden;
		}

		.product-card.product-card--reference .product-card__image-wrapper--reference {
			position: relative;
			display: none;
			width: 100%;
			padding-top: 125% !important;
			overflow: hidden !important;
			border-radius: 0 !important;
			background: #f2f3f1;
			box-shadow: inset 0 -28px 42px rgba(38, 50, 40, 0.035);
		}

		.product-card.product-card--reference .product-card__image-wrapper--reference.is-active {
			display: block;
		}

		.product-card.product-card--reference .product-card__image-picture {
			position: absolute;
			inset: 0;
			z-index: 1;
			display: block;
			width: 100%;
			height: 100%;
			overflow: hidden;
			border-radius: 0 !important;
		}

		.product-card.product-card--reference .product-card__image {
			position: absolute;
			inset: 0;
			display: block;
			width: 100% !important;
			height: 100% !important;
			border-radius: 0 !important;
			object-fit: contain !important;
			object-position: center center !important;
			filter: contrast(1.01) saturate(0.98) brightness(0.965) !important;
		}

		.product-card.product-card--reference img.product-card__image {
			mix-blend-mode: multiply;
		}

		.product-card.product-card--reference .product-card__tag-badge {
			position: absolute;
			left: 0;
			bottom: 6px;
			z-index: 3;
			display: flex;
			width: 50%;
			max-width: 50%;
			pointer-events: none;
			filter: drop-shadow(0 3px 7px rgba(0, 0, 0, 0.16));
		}

		.product-card.product-card--reference .product-card__tag-badge-image {
			display: block;
			width: 100%;
			height: auto;
			object-fit: contain;
		}

		.product-card.product-card--reference .product-card__footer {
			display: flex;
			width: 100%;
			min-width: 0;
			height: auto !important;
			margin-top: 9px !important;
			padding: 0 0 14px !important;
			flex: 0 0 auto;
			flex-direction: column;
			overflow: visible !important;
			text-align: left;
		}

		.product-card.product-card--reference .product-card__swatches-block {
			min-width: 0;
			margin: 0 0 12px;
		}

		.product-card.product-card--reference .product-card__color-label {
			display: flex;
			margin: 0 0 7px;
			gap: 4px;
			color: #4a4a4a;
			font-family: var(--base-font-family), Arial, Helvetica, sans-serif !important;
			font-size: 12px;
			font-weight: 400;
			line-height: 1.25;
		}

		.product-card.product-card--reference .product-card__swatches-wrapper {
			display: block;
			width: 100%;
			min-width: 0;
			margin: 0 !important;
		}

		.product-card.product-card--reference .product-card__swatches {
			display: flex !important;
			width: 100%;
			min-width: 0;
			align-items: center;
			flex-wrap: nowrap !important;
			gap: 5px !important;
			overflow: visible;
			opacity: 1 !important;
			visibility: visible !important;
			transform: none !important;
		}

		.product-card.product-card--reference .product-card__swatches.is-expanded {
			width: 100%;
			padding: 2px 1px 4px;
			box-sizing: border-box;
			flex-wrap: nowrap !important;
			overflow-x: auto;
			overflow-y: hidden;
			overscroll-behavior-inline: contain;
			scrollbar-width: none;
			touch-action: pan-x;
			-webkit-overflow-scrolling: touch;
		}

		.product-card.product-card--reference .product-card__swatches.is-expanded::-webkit-scrollbar {
			display: none;
		}

		.product-card.product-card--reference .product-card__swatch-button {
			position: relative;
			display: inline-flex !important;
			align-items: center;
			justify-content: center;
			width: 30px !important;
			height: 30px !important;
			padding: 0 !important;
			flex: 0 0 30px;
			overflow: hidden;
			border: 1px solid #c9c9c9 !important;
			border-radius: 0 !important;
			background: #fff !important;
			box-shadow: none !important;
			cursor: pointer;
		}

		.product-card.product-card--reference .product-card__swatch-button::after {
			display: none !important;
		}

		.product-card.product-card--reference .product-card__swatch-button.is-active {
			border-color: #1f1f1f !important;
			outline: none !important;
		}

		.product-card.product-card--reference .product-card__swatch-color {
			position: static;
			inset: auto;
			width: calc(100% - 6px) !important;
			height: calc(100% - 6px) !important;
			flex: 0 0 auto;
			border-radius: 0 !important;
			background: var(--swatch-color);
		}

		.product-card.product-card--reference .product-card__swatch-button--extra-desktop {
			display: none !important;
		}

		.product-card.product-card--reference .product-card__swatches.is-expanded .product-card__swatch-button--extra-desktop {
