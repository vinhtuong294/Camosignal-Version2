		overflow: hidden !important;
		overflow-x: hidden !important;
		clip-path: inset(0);
		contain: paint;
	}

{%- endstyle -%}

{%- assign enable_color_scheme_inheritance = section.settings.enable_color_scheme_inheritance -%}
{%- assign color_scheme 				   = section.settings.color_scheme -%}
{%- assign heading    					   = section.settings.heading -%}

{%- if enable_color_scheme_inheritance -%}
	{%- assign color_scheme = settings.main_color_scheme -%}
{%- endif -%}

{%- assign container = section.settings.container_width -%}

{%- if container == 'inherit' -%}
	{%- assign container_width = settings.container_width -%}
{%- else -%}
	{%- assign container_width = container -%}
{%- endif -%}


{%- assign collection = section.settings.collection -%}
{%- assign product_list = collection.products -%}
{%- assign enable_shopify_recommendations = section.settings.enable_shopify_recommendations -%}

{%- assign best_seller_collection = section.settings.best_seller_collection -%}
{%- if best_seller_collection == blank -%}
	{%- assign best_seller_collection = collections['all'] -%}
{%- endif -%}
{%- if best_seller_collection == blank -%}
	{%- assign best_seller_collection = collections['best-sellers'] -%}
{%- endif -%}
{%- assign best_seller_products = best_seller_collection.products -%}


{%- liquid
	assign slider_enabled = false

	if enable_shopify_recommendations or product_list.count > 0 or best_seller_products.count > 0
		assign slider_enabled = true
	endif

	assign desktop_slider_enabled = slider_enabled

	if mobile_limit > desktop_limit
		assign desktop_slider_enabled = false
	endif
-%}

{%- capture styles -%}
	--container-width: {{- container_width -}};
	--inner-offset-top: {{ section.settings.inner_offset_top }}px;
	--inner-offset-bottom: {{ section.settings.inner_offset_bottom }}px;
	--inner-offset-top-mobile: {{ section.settings.inner_offset_top_mobile }}px;
	--inner-offset-bottom-mobile: {{ section.settings.inner_offset_bottom_mobile }}px;
	--product-recommendations-heading-size-desktop: {{ section.settings.heading_font_size_desktop | default: 36 }}px;
	--product-recommendations-heading-size-mobile: {{ section.settings.heading_font_size_mobile | default: 22 }}px;
{%- endcapture -%}

<section
	class="featured-products product-recommendations section-animate featured-products--layout-4 color-{{ color_scheme.id | default: color_scheme }} js-animate animated{% if desktop_slider_enabled %} js-featured-products{% endif %}"
	id="{{- section.id -}}"
	style="{{- styles -}}"
	data-product-id="{{- product.id -}}"
	data-limit="{{- limit -}}"
	data-desktop-limit="{{- desktop_limit -}}"
	data-mobile-limit="{{- mobile_limit -}}"
	data-recommended-limit="{{- recommended_limit -}}"
	data-best-seller-limit="{{- best_seller_limit -}}"
	data-recommendation-candidates-url="{{- best_seller_collection.url | escape -}}"
	data-current-product-handle="{{- product.handle | escape -}}"
	data-product-type-recommendations-pending="true"
>
	<div class="container">
		<div class="featured-products__header product-recommendations__header">
			{%- if heading != blank -%}
				<h2>{{- heading -}}</h2>
			{%- endif -%}

		</div>

		<script type="application/json" data-product-recommendation-types>{{- best_seller_collection.all_types | json -}}</script>

		<div class="js-product-recommendations-content product-recommendations__carousel-shell">
			<div class="featured-products__slider swiper js-featured-products-slider" data-slides-in-row="4">
				<div class="featured-products__row swiper-wrapper">
					{%- capture slides -%}
						{%- assign image_size        = 439 -%}
						{%- assign image_size_tablet = 328 -%}
						{%- assign image_size_mobile = 308 -%}

						{%- assign selected_products = "," -%}
						{%- assign recommended_count = 0 -%}

						{%- if recommended_limit > 0 and enable_shopify_recommendations and product != blank -%}
							{%- assign related_collections = product.collections | sort: 'all_products_count' -%}

							{%- for related_collection in related_collections limit: 2 -%}
								{%- if recommended_count >= recommended_candidate_limit -%}
									{%- break -%}
								{%- endif -%}

								{%- for related_product in related_collection.products -%}
									{%- if recommended_count >= recommended_candidate_limit -%}
										{%- break -%}
									{%- endif -%}

									{%- if related_product.handle == product.handle -%}
										{%- continue -%}
									{%- endif -%}

									{%- unless related_product.available and related_product.selected_or_first_available_variant.requires_shipping -%}
										{%- continue -%}
									{%- endunless -%}

									{%- assign product_handle = related_product.handle -%}
									{%- assign check_handle = "," | append: product_handle | append: "," -%}
									{%- if selected_products contains check_handle -%}
										{%- continue -%}
									{%- endif -%}

									{%- assign is_lazy = true -%}
									{%- if section.index == 1 and recommended_count == 0 -%}
										{%- assign is_lazy = false -%}
									{%- endif -%}
									{%- assign selected_products = selected_products | append: product_handle | append: "," -%}
									{%- assign recommended_count = recommended_count | plus: 1 -%}
									<div
										class="featured-products__col swiper-slide js-featured-products-slide{% if recommended_count > recommended_limit %} product-recommendations__candidate-fallback{% endif %}{% if recommended_count > desktop_limit %} product-recommendations__slide--desktop-hidden{% endif %}{% if recommended_count > mobile_limit %} product-recommendations__slide--mobile-hidden{% endif %}"
										data-product-handle="{{- related_product.handle | escape -}}"
										data-product-title="{{- related_product.title | escape -}}"
										data-recommendation-source="related"
									>
										{%- render
											'product-card',
											product: related_product,
											size: image_size,
											tablet_size: image_size_tablet,
											mobile_size: image_size_mobile,
											is_lazy: is_lazy
										-%}
									</div>
								{%- endfor -%}
							{%- endfor -%}
						{%- elsif recommended_limit > 0 and product_list != blank and product_list.count > 0 -%}
							{%- for recommended_product in product_list -%}
								{%- if recommended_count >= recommended_candidate_limit -%}
									{%- break -%}
								{%- endif -%}

								{%- if recommended_product.handle == product.handle -%}
									{%- continue -%}
								{%- endif -%}

								{%- unless recommended_product.available and recommended_product.selected_or_first_available_variant.requires_shipping -%}
									{%- continue -%}
								{%- endunless -%}

								{%- assign product_handle = recommended_product.handle -%}
								{%- assign check_handle = "," | append: product_handle | append: "," -%}
								{%- if selected_products contains check_handle -%}
									{%- continue -%}
								{%- endif -%}

								{%- assign is_lazy = true -%}
								{%- if section.index == 1 and recommended_count == 0 -%}
									{%- assign is_lazy = false -%}
								{%- endif -%}
								{%- assign selected_products = selected_products | append: product_handle | append: "," -%}
								{%- assign recommended_count = recommended_count | plus: 1 -%}
								<div
									class="featured-products__col swiper-slide js-featured-products-slide{% if recommended_count > recommended_limit %} product-recommendations__candidate-fallback{% endif %}{% if recommended_count > desktop_limit %} product-recommendations__slide--desktop-hidden{% endif %}{% if recommended_count > mobile_limit %} product-recommendations__slide--mobile-hidden{% endif %}"
									data-product-handle="{{- recommended_product.handle | escape -}}"
									data-product-title="{{- recommended_product.title | escape -}}"
									data-recommendation-source="related"
								>
									{%- render
										'product-card',
										product: recommended_product,
										collection: collection,
										size: image_size,
										tablet_size: image_size_tablet,
										mobile_size: image_size_mobile,
										is_lazy: is_lazy
									-%}
								</div>
							{%- endfor -%}
						{%- endif -%}

						{%- assign best_seller_count = 0 -%}
						{%- assign selected_best_seller_types = "," -%}
						{%- if best_seller_limit > 0 and best_seller_products != blank -%}
							{%- paginate best_seller_collection.products by 250 -%}
								{%- for best_seller_product in best_seller_collection.products -%}
									{%- if best_seller_count >= best_seller_candidate_limit -%}
										{%- break -%}
									{%- endif -%}

									{%- if best_seller_product.handle == product.handle -%}
										{%- continue -%}
									{%- endif -%}

									{%- unless best_seller_product.available and best_seller_product.selected_or_first_available_variant.requires_shipping -%}
										{%- continue -%}
									{%- endunless -%}

									{%- assign product_handle = best_seller_product.handle -%}
									{%- assign check_handle = "," | append: product_handle | append: "," -%}
									{%- if selected_products contains check_handle -%}
										{%- continue -%}
									{%- endif -%}

									{%- assign best_seller_product_type = best_seller_product.type | strip -%}
									{%- assign best_seller_product_type_key = best_seller_product_type | handleize -%}
									{%- if best_seller_product_type_key == blank -%}
										{%- continue -%}
									{%- endif -%}
									{%- assign check_product_type = "," | append: best_seller_product_type_key | append: "," -%}
									{%- if selected_best_seller_types contains check_product_type -%}
										{%- continue -%}
									{%- endif -%}

									{%- assign is_lazy = true -%}
									{%- if section.index == 1 and recommended_count == 0 and best_seller_count == 0 -%}
										{%- assign is_lazy = false -%}
									{%- endif -%}
									{%- assign selected_products = selected_products | append: product_handle | append: "," -%}
									{%- assign selected_best_seller_types = selected_best_seller_types | append: best_seller_product_type_key | append: "," -%}
									{%- assign best_seller_count = best_seller_count | plus: 1 -%}
									{%- assign product_position = recommended_limit | plus: best_seller_count -%}
									<div
										class="featured-products__col swiper-slide js-featured-products-slide{% if best_seller_count > best_seller_limit %} product-recommendations__candidate-fallback{% endif %}{% if product_position > desktop_limit %} product-recommendations__slide--desktop-hidden{% endif %}{% if product_position > mobile_limit %} product-recommendations__slide--mobile-hidden{% endif %}"
										data-product-handle="{{- best_seller_product.handle | escape -}}"
										data-product-title="{{- best_seller_product.title | escape -}}"
										data-product-type="{{- best_seller_product_type | escape -}}"
										data-recommendation-source="best-seller"
									>
										{%- render
											'product-card',
											product: best_seller_product,
											collection: best_seller_collection,
											size: image_size,
											tablet_size: image_size_tablet,
											mobile_size: image_size_mobile,
											is_lazy: is_lazy
										-%}
									</div>
								{%- endfor -%}
							{%- endpaginate -%}
						{%- endif -%}
					{%- endcapture -%}

					{%- if slides != "" -%}
						{{- slides -}}
					{%- else -%}
						{%- for i in (1..limit) -%}
							<div class="featured-products__col swiper-slide js-featured-products-slide{% if i > desktop_limit %} product-recommendations__slide--desktop-hidden{% endif %}{% if i > mobile_limit %} product-recommendations__slide--mobile-hidden{% endif %}">
								{%- render 'product-card', product: nil -%}
							</div>
						{%- endfor -%}
					{%- endif -%}
				</div>
				<div class="product-recommendations__mobile-pagination js-product-recommendations-mobile-pagination"></div>
			</div>

			<div class="product-recommendations__navigation">
				<button
					type="button"
					class="focus-visible-outline swiper-button-prev-new product-recommendations__arrow product-recommendations__arrow--prev js-featured-products-slider-button-prev"
					aria-label="{{- 'general.accessibility.slider.prev_slide_message' | t | escape -}}"
					aria-disabled="true"
					disabled
				>
					{%- render 'icons', icon: 'arrow-left' -%}
				</button>

				<button
					type="button"
					class="focus-visible-outline swiper-button-next-new product-recommendations__arrow product-recommendations__arrow--next js-featured-products-slider-button-next"
					aria-label="{{- 'general.accessibility.slider.next_slide_message' | t | escape -}}"
					aria-disabled="true"
					disabled
				>
					{%- render 'icons', icon: 'arrow-right' -%}
				</button>
			</div>
		</div>
	</div>
</section>

<script>
	(function() {
		var mobileQuery = window.matchMedia('(max-width: 767px)');
		var retries = 0;
		var motionRetries = 0;
		var featuredProductsInitRequested = false;
		var runtimeKey = '__camoProductRecommendationsRuntime_{{ section.id }}';
		var previousRuntime = window[runtimeKey];
		var runtimeListeners = [];
		var runtimeObservers = [];
		var runtimeTimeouts = [];
		var responsiveFrame = null;
		var runtimeActive = true;

		if (previousRuntime && typeof previousRuntime.destroy === 'function') {
			previousRuntime.destroy();
		}

		function addRuntimeListener(target, eventName, handler, options) {
			if (!target || typeof target.addEventListener !== 'function') return;

			target.addEventListener(eventName, handler, options);
			runtimeListeners.push(function() {
				target.removeEventListener(eventName, handler, options);
			});
		}

		function scheduleRuntimeTimeout(callback, delay) {
			var timeoutId = setTimeout(function() {
				runtimeTimeouts = runtimeTimeouts.filter(function(id) {
					return id !== timeoutId;
				});

				if (runtimeActive) {
					callback();
				}
			}, delay);

			runtimeTimeouts.push(timeoutId);
			return timeoutId;
		}

		function trackRuntimeObserver(observer) {
			if (observer) {
				runtimeObservers.push(observer);
			}

			return observer;
		}

		function destroyRuntime() {
			runtimeActive = false;

			runtimeListeners.splice(0).forEach(function(removeListener) {
				removeListener();
			});
			runtimeObservers.splice(0).forEach(function(observer) {
				observer.disconnect();
			});
			runtimeTimeouts.splice(0).forEach(function(timeoutId) {
				clearTimeout(timeoutId);
			});

			if (responsiveFrame !== null) {
				window.cancelAnimationFrame(responsiveFrame);
				responsiveFrame = null;
			}

			if (window[runtimeKey] && window[runtimeKey].destroy === destroyRuntime) {
				delete window[runtimeKey];
			}
		}

		window[runtimeKey] = {
			destroy: destroyRuntime
		};

		var bundleSelector = [
			'lb-upsell-widget',
			'lb-upsell-flat-card',
			'.lb-widget',
			'.lb-product-card',
			'.lb-flat-card-host',
			'[id*="selleasy" i]',
			'[class*="selleasy" i]',
			'[id*="lb-widget" i]',
			'[class*="lb-widget" i]',
			'[id*="lb-upsell" i]',
			'[class*="lb-upsell" i]',
			'[id*="sll" i]',
			'[class*="sll" i]',
			'[id*="bundle" i]',
			'[class*="bundle" i]'
		].join(',');
		var filterTimer = null;
		var bundleFilterInitialized = false;

		function normalizeProductHandle(value) {
			if (!value) return '';

			return String(value)
				.trim()
				.replace(/^\/+|\/+$/g, '')
				.toLowerCase();
		}

		function normalizeProductTitle(value) {
			if (!value) return '';

			return String(value)
				.replace(/\s+/g, ' ')
				.replace(/&/g, 'and')
				.replace(/[^a-zA-Z0-9]+/g, ' ')
				.trim()
				.toLowerCase();
		}

		function isProductTitleCandidate(value) {
			var title = normalizeProductTitle(value);

			if (!title || title.length < 8) return false;
			if (/^\d+$/.test(title)) return false;
			if (/^(add|quick add|select|size|color|people also bought|customer favorites|you may also like|you might also like)$/.test(title)) return false;
			if (title.split(' ').length <= 4 && /^(black|white|ivory|khaki|maroon|navy|sand|rectangle|small|medium|large|xl|2xl|3xl|4xl|5xl)(\s|$)/.test(title)) return false;

			return true;
		}

		function getProductHandleFromUrl(value) {
			if (!value || String(value).indexOf('/products/') === -1) return '';

			try {
				var url = new URL(value, window.location.origin);
				var match = url.pathname.match(/\/products\/([^/?#]+)/);
				return match ? normalizeProductHandle(decodeURIComponent(match[1])) : '';
			} catch (error) {
				var fallbackMatch = String(value).match(/\/products\/([^/?#]+)/);
				return fallbackMatch ? normalizeProductHandle(decodeURIComponent(fallbackMatch[1])) : '';
			}
		}

		function addHandleFromElement(element, handles) {
			if (!element) return;

			var rawHandle = (
				element.getAttribute('data-product-card-handle') ||
				element.getAttribute('data-product-handle') ||
				element.getAttribute('data-handle')
			);
			var handle = getProductHandleFromUrl(rawHandle) || normalizeProductHandle(rawHandle);

			if (!handle) {
				handle = getProductHandleFromUrl(
					element.getAttribute('href') ||
					element.getAttribute('data-product-url') ||
					element.getAttribute('data-url')
				);
			}

			if (handle) {
				handles[handle] = true;
			}
		}

		function addTitle(title, titles) {
			var normalizedTitle = normalizeProductTitle(title);

			if (isProductTitleCandidate(normalizedTitle)) {
				titles[normalizedTitle] = true;
			}
		}

		function addTitleFromElement(element, titles) {
			if (!element || element.nodeType !== 1) return;

			addTitle(
				element.getAttribute('data-product-title') ||
				element.getAttribute('data-title') ||
				element.getAttribute('aria-label'),
				titles
			);

			Array.prototype.forEach.call(element.childNodes || [], function(node) {
				if (node.nodeType === 3) {
					addTitle(node.textContent, titles);
				}
			});
		}

		function collectTextTitles(root, titles) {
			if (!root) return;

			addTitleFromElement(root, titles);

			root.querySelectorAll('[data-product-title], [data-title], [aria-label], [class*="title" i], [class*="name" i], a[href*="/products/"]').forEach(function(element) {
				if (element.closest('script, style, select, option, button')) return;
				addTitleFromElement(element, titles);
			});

			root.querySelectorAll('*').forEach(function(element) {
				if (element.children.length || element.closest('script, style, select, option, button')) return;
				addTitleFromElement(element, titles);
			});
		}

		function collectBundleProductMatches() {
			var section = document.getElementById('{{ section.id }}');
			var productMatches = {
				handles: {},
				titles: {}
			};
			var widgets = [];

			document.querySelectorAll('.product-upsell-block[data-product-handle]').forEach(function(block) {
				addHandleFromElement(block, productMatches.handles);
				collectTextTitles(block, productMatches.titles);
			});

			try {
				widgets = Array.prototype.slice.call(document.querySelectorAll(bundleSelector));
			} catch (error) {
				widgets = [];
			}

			widgets.forEach(function(widget) {
				if (section && section.contains(widget)) return;

				var roots = [widget];
				if (widget.shadowRoot) {
					roots.push(widget.shadowRoot);
				}

				addHandleFromElement(widget, productMatches.handles);

				roots.forEach(function(root) {
					collectTextTitles(root, productMatches.titles);

					root.querySelectorAll('[data-product-card-handle], [data-product-handle], [data-handle], [data-product-url], [data-url*="/products/"], a[href*="/products/"]').forEach(function(element) {
						addHandleFromElement(element, productMatches.handles);
						addTitleFromElement(element, productMatches.titles);
					});
				});
			});

			return productMatches;
		}

		function getRecommendationProductHandle(slide) {
			var handle = normalizeProductHandle(slide.getAttribute('data-product-handle'));

			if (handle) return handle;

			var handleElement = slide.querySelector('[data-product-card-handle]');
			handle = handleElement ? normalizeProductHandle(handleElement.getAttribute('data-product-card-handle')) : '';

			if (handle) return handle;

			var link = slide.querySelector('a[href*="/products/"]');
			return link ? getProductHandleFromUrl(link.getAttribute('href')) : '';
		}

		function getRecommendationProductTitle(slide) {
			var title = slide.getAttribute('data-product-title');
			var titleElement = slide.querySelector('.product-card__title, [data-product-title], [aria-label]');

			if (!title && titleElement) {
				title = titleElement.getAttribute('data-product-title') ||
					titleElement.getAttribute('aria-label') ||
					titleElement.textContent;
			}

			return normalizeProductTitle(title);
		}

		function rebalanceRecommendationGroups() {
			var section = document.getElementById('{{ section.id }}');
			var wrapper = section ? section.querySelector('.featured-products__row') : null;

			if (!section || !wrapper) return;

			var recommendedLimit = parseInt(section.getAttribute('data-recommended-limit'), 10) || 0;
			var bestSellerLimit = parseInt(section.getAttribute('data-best-seller-limit'), 10) || 0;
			var slides = Array.prototype.slice.call(wrapper.querySelectorAll('.js-featured-products-slide'));
			var recommendedSlides = slides.filter(function(slide) {
				return slide.getAttribute('data-recommendation-source') === 'related';
			});
			var bestSellerSlides = slides.filter(function(slide) {
				return slide.getAttribute('data-recommendation-source') === 'best-seller';
			});

			if (!recommendedSlides.length && !bestSellerSlides.length) return;

			var activeSlides = recommendedSlides.slice(0, recommendedLimit).concat(
				bestSellerSlides.slice(0, bestSellerLimit)
			);
			var fallbackSlides = recommendedSlides.slice(recommendedLimit).concat(
				bestSellerSlides.slice(bestSellerLimit)
			);
			var remainingSlides = slides.filter(function(slide) {
				return recommendedSlides.indexOf(slide) === -1 && bestSellerSlides.indexOf(slide) === -1;
			});
			var orderedSlides = activeSlides.concat(fallbackSlides, remainingSlides);
			var needsReorder = orderedSlides.some(function(slide, index) {
				return wrapper.children[index] !== slide;
			});

			if (needsReorder) {
				orderedSlides.forEach(function(slide) {
					wrapper.appendChild(slide);
				});
			}

			slides.forEach(function(slide) {
				slide.classList.toggle(
					'product-recommendations__candidate-fallback',
					activeSlides.indexOf(slide) === -1
				);
			});
		}
		function getCarouselGroupSize(section) {
			var availableWidth = section && section.clientWidth
				? section.clientWidth
				: window.innerWidth;

			if (availableWidth >= 1200) return 4;
			if (availableWidth >= 768) return 3;
			return 2;
		}

		function syncNavigationToProductImages(section) {
			section = section || document.getElementById('{{ section.id }}');
			if (!section) return;

			var shell = section.querySelector('.product-recommendations__carousel-shell');
			var imageArea = shell && shell.querySelector(
				'.js-featured-products-slide:not([aria-hidden="true"]) .product-card__image-wrapper-link'
			);

			if (!shell || !imageArea) return;

			if (
				window.ResizeObserver &&
				imageArea.productRecommendationsArrowRuntime !== runtimeKey
			) {
				if (imageArea.productRecommendationsArrowObserver) {
					imageArea.productRecommendationsArrowObserver.disconnect();
				}

				imageArea.productRecommendationsArrowObserver = trackRuntimeObserver(new ResizeObserver(function() {
					syncNavigationToProductImages(section);
				}));
