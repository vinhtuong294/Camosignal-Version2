{%- comment -%}
  Restyle Shopify Inbox's own launcher so its native open/close behavior is
  preserved while matching the Camo Signal floating-button treatment.
{%- endcomment -%}

<style>
	/* The activator part is exposed by Shopify Inbox's open shadow root. */
	shopify-chat::part(activator) {
		width: 60px !important;
		height: 60px !important;
		min-width: 60px !important;
		min-height: 60px !important;
		padding: 0 !important;
		border: 0 !important;
		border-radius: 50% !important;
		display: flex !important;
		align-items: center !important;
		justify-content: center !important;
		gap: 0 !important;
		background: radial-gradient(circle at center, #2c3d33 0 18px, #f8f8f5 19px) !important;
		color: #ffffff !important;
		font-size: 0 !important;
		overflow: hidden !important;
		box-shadow: 0 5px 14px rgba(26, 37, 29, .22) !important;
	}

	shopify-chat::part(activator):hover {
		background: radial-gradient(circle at center, #24342b 0 18px, #ffffff 19px) !important;
	}

	body.template-cart shopify-chat,
	body:has(#CartDrawer.is-active) shopify-chat,
	html.is-mobile-nav-open shopify-chat {
		display: none !important;
	}

	@media (max-width: 767px) {
		shopify-chat::part(activator) {
			width: 56px !important;
			height: 56px !important;
			min-width: 56px !important;
			min-height: 56px !important;
		}
	}
</style>

<script>
	(function() {
		var observedRoots = [];

		function setIconColor(icon) {
			icon.style.setProperty('color', '#ffffff', 'important');
			icon.querySelectorAll('svg, path').forEach(function(element) {
				element.style.setProperty('color', '#ffffff', 'important');
				element.style.setProperty('stroke', '#ffffff', 'important');
			});
		}

		function observeRoot(root) {
			if (!root || observedRoots.indexOf(root) !== -1) return;
			observedRoots.push(root);
			new MutationObserver(function() {
				styleLauncher(root);
			}).observe(root, { childList: true, subtree: true });
		}

		function styleLauncher(root) {
			if (!root) return;
			root.querySelectorAll('.activator__icon').forEach(setIconColor);
			root.querySelectorAll('*').forEach(function(element) {
				if (element.shadowRoot) {
					observeRoot(element.shadowRoot);
					styleLauncher(element.shadowRoot);
				}
			});
		}

		var attempts = 0;
		var waitForChat = window.setInterval(function() {
			attempts += 1;
			var host = document.querySelector('shopify-chat');
			if (host && host.shadowRoot) {
				observeRoot(host.shadowRoot);
				styleLauncher(host.shadowRoot);
				window.clearInterval(waitForChat);
			} else if (attempts >= 120) {
				window.clearInterval(waitForChat);
			}
		}, 250);
	})();
</script>
