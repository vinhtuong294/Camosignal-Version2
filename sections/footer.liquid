{%- render 'camo-footer', section: section -%}

{% schema %}
{
	"name": "Footer",
	"settings": [
		{
			"type": "header",
			"content": "Logo"
		},
		{
			"id": "logo_image",
			"type": "image_picker",
			"label": "Logo image"
		},
		{
			"id": "logo_image_width",
			"type": "range",
			"min": 50,
			"max": 450,
			"step": 10,
			"unit": "px",
			"label": "Logo width",
			"default": 320
		},
		{
			"type": "header",
			"content": "Column 1: Brand Info"
		},
		{
			"type": "text",
			"id": "brand_heading",
			"label": "Brand Heading",
			"default": "CAMO SIGNAL"
		},
		{
			"type": "inline_richtext",
			"id": "manifesto_subheading",
			"label": "Brand Subheading",
			"default": "Raised here. Stood Here."
		},
		{
			"type": "richtext",
			"id": "manifesto_text",
			"label": "Brand Manifesto",
			"default": "<p>Built for those who hunt, protect, and live by their values — quietly, proudly.</p>"
		},
		{
			"type": "header",
			"content": "Column 2: Contact Info"
		},
		{
			"type": "text",
			"id": "info_heading",
			"label": "Heading",
			"default": "CAMO SIGNAL INFO"
		},
		{
			"type": "inline_richtext",
			"id": "info_phone",
			"label": "Phone Number",
			"default": "+1 (307) 227-3117"
		},
		{
			"type": "inline_richtext",
			"id": "info_email",
			"label": "Email Address",
			"default": "support.camosignal@gmail.com"
		},
		{
			"type": "inline_richtext",
			"id": "info_address",
			"label": "Physical Address",
			"default": "30 N Gould St Ste N, Sheridan, WY, 82801, US"
		},
		{
			"type": "header",
			"content": "Column 3: Newsletter"
		},
		{
			"type": "text",
			"id": "newsletter_heading",
			"label": "Heading",
			"default": "SUBSCRIBE TO OUR EMAIL"
		},
		{
			"type": "richtext",
			"id": "newsletter_text",
			"label": "Newsletter Text",
			"default": "<p>Subscribe to get special offers, giveaways, and exclusive deals</p>"
		},
		{
			"type": "header",
			"content": "Bottom Footer"
		},
		{
			"type": "link_list",
			"id": "sub_footer_menu",
			"label": "Sub-footer Menu"
		},
		{
			"type": "textarea",
			"id": "copyright_text",
			"label": "Copyright text",
			"default": "Copyright © %date%.",
			"info": "%date% - will be replaced with the current year"
		},
		{
			"id": "is_show_payment_methods",
			"type": "checkbox",
			"label": "Show payment icons",
			"default": true
		},
		{
			"type": "checkbox",
			"id": "show_back_to_top_button",
			"label": "Show back to top button",
			"default": true
		},
		{
			"type": "checkbox",
			"id": "show_store_policies_in_footer",
			"label": "Show Store Policies in Footer",
			"default": false
		},
		{
			"type": "header",
			"content": "COUNTRY/REGION SELECTOR"
		},
		{
			"id": "is_show_country_selector",
			"type": "checkbox",
			"label": "Show country/region selector",
			"default": true
		},
		{
			"type": "header",
			"content": "LANGUAGE SELECTOR"
		},
		{
			"id": "is_show_language_selector",
			"type": "checkbox",
			"label": "Show language selector",
			"default": true
		},
		{
			"type": "header",
			"content": "FOLLOW ON SHOP"
		},
		{
			"type": "checkbox",
			"id": "enable_follow_on_shop",
			"label": "Enable Follow on Shop",
			"default": true
		},
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "checkbox",
			"id": "enable_color_scheme_inheritance",
			"label": "Enable color scheme inheritance",
			"default": true,
			"info": "When this setting is enabled, the color scheme is inherited from the theme settings."
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "Color scheme",
			"default": "scheme-1"
		}
	],
	"blocks": [
		{
			"type": "menu",
			"name": "Footer menu",
			"limit": 3,
			"settings": [
				{
					"id": "menu_heading",
					"type": "text",
					"label": "Heading"
				},
				{
					"id": "menu",
					"type": "link_list",
					"label": "Menu",
					"info": "Displays only top-level menu items.",
					"default": "footer"
				}
			]
		},
		{
			"type": "contact",
			"name": "Footer contact",
			"limit": 1,
			"settings": [
				{
					"type": "checkbox",
					"id": "show_socials",
					"label": "Show socials",
					"default": true
				},
				{
					"type": "text",
					"id": "heading",
					"label": "Heading"
				},
				{
					"type": "header",
					"content": "Email"
				},
				{
					"type": "image_picker",
					"id": "email_icon",
					"label": "Icon"
				},
				{
					"type": "inline_richtext",
					"id": "email_text",
					"label": "Text"
				},
				{
					"type": "header",
					"content": "Phone"
				},
				{
					"type": "image_picker",
					"id": "phone_icon",
					"label": "Icon"
				},
				{
					"type": "inline_richtext",
					"id": "phone_text",
					"label": "Text"
				},
				{
					"type": "header",
					"content": "Additional information"
				},
				{
					"type": "image_picker",
					"id": "additional_icon",
					"label": "Icon"
				},
				{
					"type": "inline_richtext",
					"id": "additional_text",
					"label": "Text"
				}
			]
		},
		{
			"type": "newsletter",
			"name": "Footer newsletter",
			"limit": 1,
			"settings": [
				{
					"type": "text",
					"id": "heading",
					"label": "Heading",
					"default": "Newsletter"
				},
				{
					"type": "textarea",
					"id": "text",
					"label": "Text"
				},
				{
					"type": "text",
					"id": "input_placeholder",
					"label": "Input placeholder",
					"default": "Enter email address..."
				},
				{
					"type": "text",
					"id": "button_label",
					"label": "Button label",
					"default": "Subscribe"
				},
				{
					"type": "text",
					"id": "success_message",
					"label": "Success message",
					"default": "Thanks for subscribing"
				}
			]
		}
	]
}
{% endschema %}
