				if (event) {
					event.preventDefault();
					event.stopImmediatePropagation();
				}
				if (isAnimating) return;

				nextIndex = Math.max(0, Math.min(mobilePages.length - 1, nextIndex));
				if (nextIndex === activeIndex) return;

				var currentSlides = mobilePages[activeIndex];
				var incomingSlides = mobilePages[nextIndex];
				var step = nextIndex > activeIndex ? 1 : -1;
				var enteringClass = step > 0 ? 'is-mobile-entering-from-right' : 'is-mobile-entering-from-left';
				var exitingClass = step > 0 ? 'is-mobile-exiting-to-left' : 'is-mobile-exiting-to-right';
				var animationDuration = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 320;

				isAnimating = true;
				incomingSlides.forEach(function (slide) {
					slide.classList.remove.apply(slide.classList, motionClasses);
					slide.classList.add(enteringClass);
					slide.setAttribute('aria-hidden', 'false');
				});
